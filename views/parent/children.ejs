<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        .sidebar-active { 
            background-color: #f0fdf4; 
            color: #16a34a; 
            font-weight: 600; 
            border-right: 4px solid #16a34a; 
        }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { 
            background-color: #f1f5f9; 
            color: #334155; 
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/parent/dashboard" class="flex items-center gap-2 text-emerald-600 hover:text-emerald-700 transition-colors">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
                <span class="font-mono text-xl font-bold tracking-tight text-slate-900">EduSmart <span class="font-sans text-xs text-emerald-600 ml-1 font-semibold uppercase tracking-normal">Family</span></span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/parent/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-house-chimney w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/parent/children" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-children w-5 text-center"></i>
                <span>My Children</span>
            </a>
            <a href="/parent/progress" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span>Progress</span>
            </a>
            <a href="/parent/assignments" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-file-signature w-5 text-center"></i>
                <span>Assignments</span>
            </a>
            <a href="/parent/achievements" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span>Achievements</span>
            </a>
            </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/parent/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full relative">
        
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block mr-6">My Children</h1>
                </div>
                
                <div class="flex items-center gap-5">

                    <!-- Notification Icon & Dropdown -->
                    <div class="relative" id="notificationDropdownContainer">
                        <button id="notificationBtn" class="relative text-slate-500 hover:text-emerald-600 transition-colors focus:outline-none">
                            <i class="fa-regular fa-bell text-xl"></i>
                            <span id="unreadBadge" class="hidden absolute -top-2 -right-2 text-[9px] font-bold text-white bg-red-500 rounded-full px-1.5 py-0.5 border-2 border-white">0</span>
                        </button>
                        
                        <!-- Dropdown Panel -->
                        <div id="notificationPanel" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white rounded-xl shadow-lg border border-slate-200 z-50 overflow-hidden transform origin-top-right transition-all">
                            <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                                <h3 class="font-bold text-slate-800">Notifications</h3>
                                <button id="markAllReadBtn" class="text-xs font-semibold text-emerald-600 hover:text-emerald-700 hidden">Mark all as read</button>
                            </div>
                            <div id="notificationList" class="max-h-96 overflow-y-auto divide-y divide-slate-100">
                                <!-- Notifications will be injected here -->
                                <div class="p-4 text-center text-sm text-slate-500">Loading notifications...</div>
                            </div>
                        </div>
                    </div>
                    <!-- Parent Profile -->
                    <div class="relative" id="profileDropdownContainer">
                        <button id="profileDropdownBtn" class="flex items-center gap-3 cursor-pointer group focus:outline-none" aria-label="Open profile menu" aria-expanded="false" aria-haspopup="true">
                            <% 
                                let profileInitials = '';
                                if (!user.profilePicture || user.profilePicture === '/images/default-avatar.png') {
                                    let names = user.name.split(' ');
                                    profileInitials = names[0].charAt(0).toUpperCase() + (names.length > 1 ? names[names.length - 1].charAt(0).toUpperCase() : '');
                                }
                            %>
                            <% if (profileInitials) { %>
                                <div class="w-9 h-9 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold border-2 border-emerald-100 group-hover:border-emerald-300 transition-colors">
                                    <%= profileInitials %>
                                </div>
                            <% } else { %>
                                <img src="<%= user.profilePicture %>" alt="Profile"
                                    class="w-9 h-9 rounded-full object-cover border-2 border-emerald-100 group-hover:border-emerald-300 transition-colors">
                            <% } %>
                            <div class="hidden md:block text-left">
                                <p class="text-sm font-semibold text-slate-800 leading-tight">
                                    <%= user.name %>
                                </p>
                                <p class="text-xs text-slate-500 capitalize leading-tight mt-0.5">
                                    <%= user.role %>
                                </p>
                            </div>
                            <i class="fa-solid fa-chevron-down text-slate-400 text-xs ml-1 group-hover:text-slate-600 transition-colors hidden md:block"></i>
                        </button>

                        <!-- Profile Dropdown Panel -->
                        <div id="profileDropdownPanel" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-slate-200 z-50 overflow-hidden transform origin-top-right transition-all">
                            <div class="p-4 border-b border-slate-100 bg-slate-50 flex items-center gap-3">
                                <% if (profileInitials) { %>
                                    <div class="w-12 h-12 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-lg border-2 border-emerald-100 shadow-sm shrink-0">
                                        <%= profileInitials %>
                                    </div>
                                <% } else { %>
                                    <img src="<%= user.profilePicture %>" alt="Profile"
                                        class="w-12 h-12 rounded-full object-cover border-2 border-emerald-100 shadow-sm shrink-0">
                                <% } %>
                                <div class="overflow-hidden">
                                    <p class="font-bold text-slate-800 truncate"><%= user.name %></p>
                                    <p class="text-xs text-slate-500 truncate"><%= user.email %></p>
                                    <p class="text-xs font-semibold text-emerald-600 capitalize mt-0.5"><%= user.role %></p>
                                </div>
                            </div>
                            <div class="p-2 py-2">
                                <a href="/parent/profile" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-emerald-600 transition-colors">
                                    <i class="fa-regular fa-user w-5 text-center text-slate-400"></i> Profile
                                </a>
                                <a href="/parent/settings" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-emerald-600 transition-colors">
                                    <i class="fa-solid fa-gear w-5 text-center text-slate-400"></i> Settings
                                </a>
                            </div>
                            <div class="p-2 border-t border-slate-100">
                                <form action="/logout" method="POST" class="w-full m-0">
                                    <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 transition-colors text-left">
                                        <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i> Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800 mb-1">Connected Students</h2>
                    <p class="text-slate-500">Manage your children's accounts and monitor their learning.</p>
                </div>
                <button onclick="document.getElementById('linkStudentModal').classList.remove('hidden')" class="bg-emerald-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-emerald-700 transition-colors shadow-sm flex items-center justify-center gap-2">
                    <i class="fa-solid fa-plus"></i> Connect Child
                </button>
            </div>

            <% if (childrenData && childrenData.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    <% childrenData.forEach(child => { %>
                        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col">
                            <div class="p-6 border-b border-slate-100 flex items-start justify-between">
                                <div class="flex items-center gap-4">
                                    <img src="<%= child.profilePicture || '/images/default-avatar.png' %>" class="w-16 h-16 rounded-full border-2 border-emerald-100 object-cover">
                                    <div>
                                        <h3 class="font-bold text-lg text-slate-800 leading-tight"><%= child.name %></h3>
                                        <p class="text-sm text-slate-500 mb-1"><%= child.email %></p>
                                        <span class="inline-block bg-slate-100 text-slate-500 text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded">Student</span>
                                    </div>
                                </div>
                                
                                <div class="relative">
                                    <button class="text-slate-400 hover:text-slate-600 transition-colors dropdown-btn p-1" data-child-id="<%= child.id %>">
                                        <i class="fa-solid fa-ellipsis-vertical text-lg"></i>
                                    </button>
                                    <div id="dropdown-<%= child.id %>" class="absolute right-0 mt-2 w-48 bg-white border border-slate-200 rounded-lg shadow-lg hidden z-10 py-1">
                                        <a href="/parent/children/<%= child.id %>" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-emerald-600">
                                            <i class="fa-regular fa-id-card w-5 text-center text-slate-400"></i> View Details
                                        </a>
                                        <a href="/parent/progress?childId=<%= child.id %>" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-emerald-600">
                                            <i class="fa-solid fa-chart-line w-5 text-center text-slate-400"></i> View Progress
                                        </a>
                                        <a href="/parent/assignments?childId=<%= child.id %>" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-emerald-600">
                                            <i class="fa-solid fa-file-signature w-5 text-center text-slate-400"></i> View Assignments
                                        </a>
                                        <a href="/parent/achievements?childId=<%= child.id %>" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-emerald-600">
                                            <i class="fa-solid fa-medal w-5 text-center text-slate-400"></i> View Achievements
                                        </a>
                                        <div class="border-t border-slate-100 my-1"></div>
                                        <button onclick="confirmRemoveChild('<%= child.id %>', '<%= child.name %>')" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors flex items-center gap-2">
                                            <i class="fa-solid fa-trash-can w-4 text-center"></i> Remove Connection
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="p-6 flex-1">
                                <div class="grid grid-cols-2 gap-4 mb-6">
                                    <div>
                                        <p class="text-xs text-slate-500 font-medium mb-1 uppercase tracking-wide">Courses</p>
                                        <p class="font-bold text-slate-800 text-xl"><%= child.coursesCount %></p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500 font-medium mb-1 uppercase tracking-wide">Progress</p>
                                        <p class="font-bold text-emerald-600 text-xl"><%= child.overallProgress %>%</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500 font-medium mb-1 uppercase tracking-wide">Avg Score</p>
                                        <p class="font-bold text-blue-600 text-xl"><%= child.averageQuizScore %>%</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-500 font-medium mb-1 uppercase tracking-wide">Assignments</p>
                                        <p class="font-bold text-orange-500 text-xl"><%= child.assignmentsCompleted %></p>
                                    </div>
                                </div>
                                
                                <div class="text-xs text-slate-400">
                                    <i class="fa-regular fa-calendar mr-1"></i> Joined <%= new Date(child.joinedDate).toLocaleDateString() %>
                                </div>
                            </div>
                            
                            <div class="p-4 bg-slate-50 border-t border-slate-100 flex gap-3">
                                <a href="/parent/children/<%= child.id %>" class="flex-1 bg-white border border-slate-200 text-slate-700 font-medium py-2 rounded-lg text-center hover:bg-slate-100 hover:text-emerald-600 transition-colors text-sm">
                                    View Details
                                </a>
                                <a href="/parent/progress?childId=<%= child.id %>" class="flex-1 bg-emerald-600 text-white font-medium py-2 rounded-lg text-center hover:bg-emerald-700 transition-colors text-sm shadow-sm">
                                    View Progress
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <!-- Empty State -->
                <div class="flex flex-col items-center justify-center h-[60vh] max-w-lg mx-auto text-center border-2 border-dashed border-slate-200 rounded-2xl bg-white p-10">
                    <div class="w-20 h-20 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center text-3xl mb-6 shadow-sm">
                        <i class="fa-solid fa-child-reaching"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-800 mb-2">No children connected yet.</h2>
                    <p class="text-slate-500 mb-8">Connect your child's account to start viewing their learning progress, quiz scores, and assignments.</p>
                    <button onclick="document.getElementById('linkStudentModal').classList.remove('hidden')" class="bg-emerald-600 text-white font-semibold px-6 py-3 rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">Connect a Child</button>
                </div>
            <% } %>
            
        </div>
        
        <!-- Link Student Account Modal -->
        <div id="linkStudentModal" class="fixed inset-0 bg-slate-900/50 z-50 hidden flex items-center justify-center transition-opacity">
            <div class="bg-white rounded-xl shadow-lg w-full max-w-md p-6 transform transition-transform mx-4">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-xl font-bold text-slate-800">Connect Child Account</h3>
                    <button onclick="document.getElementById('linkStudentModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>
                <p class="text-slate-500 text-sm mb-6">Enter your child's registered email address to securely connect their account to your dashboard.</p>
                
                <form id="linkStudentForm">
                    <div class="mb-4">
                        <label for="childEmail" class="block text-sm font-medium text-slate-700 mb-1">Child's Email Address</label>
                        <input type="email" id="childEmail" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500" placeholder="student@example.com">
                    </div>
                    
                    <div id="linkStudentError" class="hidden mb-4 p-3 bg-red-50 text-red-600 text-sm rounded-lg border border-red-100"></div>
                    <div id="linkStudentSuccess" class="hidden mb-4 p-3 bg-emerald-50 text-emerald-600 text-sm rounded-lg border border-emerald-100">Child added successfully. Refreshing...</div>
                    
                    <div class="flex justify-end gap-3 mt-6">
                        <button type="button" onclick="document.getElementById('linkStudentModal').classList.add('hidden')" class="px-4 py-2 text-slate-600 font-medium hover:bg-slate-100 rounded-lg transition-colors">Cancel</button>
                        <button type="submit" id="submitLinkBtn" class="px-4 py-2 bg-emerald-600 text-white font-medium rounded-lg hover:bg-emerald-700 transition-colors flex items-center gap-2">
                            <span id="submitLinkBtnText">Connect</span>
                            <i id="submitLinkSpinner" class="fa-solid fa-spinner fa-spin hidden"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Remove Child Modal -->
        <div id="removeChildModal" class="fixed inset-0 bg-slate-900/50 z-50 hidden flex items-center justify-center transition-opacity">
            <div class="bg-white rounded-xl shadow-lg w-full max-w-md p-6 transform transition-transform mx-4 text-center">
                <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center text-2xl mx-auto mb-4">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-2">Disconnect Child?</h3>
                <p class="text-slate-500 text-sm mb-6">Are you sure you want to remove <strong id="removeNameText" class="text-slate-700"></strong> from your account? You will lose access to their progress data. Their account and learning history will <span class="font-bold underline text-slate-600">not</span> be deleted.</p>
                
                <div id="removeChildError" class="hidden mb-4 p-3 bg-red-50 text-red-600 text-sm rounded-lg border border-red-100 text-left"></div>
                
                <div class="flex justify-center gap-3">
                    <button type="button" onclick="document.getElementById('removeChildModal').classList.add('hidden')" class="px-6 py-2 border border-slate-300 text-slate-600 font-medium hover:bg-slate-50 rounded-lg transition-colors">Cancel</button>
                    <button type="button" id="confirmRemoveBtn" class="px-6 py-2 bg-red-600 text-white font-medium rounded-lg hover:bg-red-700 transition-colors flex items-center gap-2">
                        <span id="confirmRemoveBtnText">Disconnect</span>
                        <i id="confirmRemoveSpinner" class="fa-solid fa-spinner fa-spin hidden"></i>
                    </button>
                </div>
            </div>
        </div>

    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Logic
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            // Dropdown Logic
            document.querySelectorAll('.dropdown-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const childId = btn.getAttribute('data-child-id');
                    const dropdown = document.getElementById(`dropdown-${childId}`);
                    
                    // Close others
                    document.querySelectorAll('[id^="dropdown-"]').forEach(d => {
                        if(d.id !== `dropdown-${childId}`) d.classList.add('hidden');
                    });
                    
                    dropdown.classList.toggle('hidden');
                });
            });

            // Close dropdowns on outside click
            document.addEventListener('click', () => {
                document.querySelectorAll('[id^="dropdown-"]').forEach(d => d.classList.add('hidden'));
            });

            // Add Child Logic
            const linkForm = document.getElementById('linkStudentForm');
            if (linkForm) {
                linkForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    
                    const email = document.getElementById('childEmail').value.trim();
                    const submitBtn = document.getElementById('submitLinkBtn');
                    const submitBtnText = document.getElementById('submitLinkBtnText');
                    const submitSpinner = document.getElementById('submitLinkSpinner');
                    const errorDiv = document.getElementById('linkStudentError');
                    const successDiv = document.getElementById('linkStudentSuccess');

                    errorDiv.classList.add('hidden');
                    successDiv.classList.add('hidden');
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
                    submitBtnText.textContent = "Connecting...";
                    submitSpinner.classList.remove('hidden');

                    try {
                        const response = await fetch('/parent/api/children/link', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ email })
                        });

                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Failed to link account.');
                        }

                        successDiv.classList.remove('hidden');
                        setTimeout(() => window.location.reload(), 1000);

                    } catch (err) {
                        errorDiv.textContent = err.message;
                        errorDiv.classList.remove('hidden');
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                        submitBtnText.textContent = "Connect";
                        submitSpinner.classList.add('hidden');
                    }
                });
            }

            // Remove Child Logic
            let childIdToRemove = null;
            const removeModal = document.getElementById('removeChildModal');
            const confirmRemoveBtn = document.getElementById('confirmRemoveBtn');
            const removeNameText = document.getElementById('removeNameText');
            const removeError = document.getElementById('removeChildError');

            window.confirmRemoveChild = (id, name) => {
                childIdToRemove = id;
                removeNameText.textContent = name;
                removeError.classList.add('hidden');
                removeModal.classList.remove('hidden');
            };

            confirmRemoveBtn.addEventListener('click', async () => {
                if (!childIdToRemove) return;
                
                const btnText = document.getElementById('confirmRemoveBtnText');
                const spinner = document.getElementById('confirmRemoveSpinner');
                
                confirmRemoveBtn.disabled = true;
                btnText.textContent = "Disconnecting...";
                spinner.classList.remove('hidden');
                removeError.classList.add('hidden');

                try {
                    const response = await fetch('/parent/api/children/unlink', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ childId: childIdToRemove })
                    });

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(data.message || 'Failed to remove connection.');
                    }

                    window.location.reload();
                } catch (err) {
                    removeError.textContent = err.message;
                    removeError.classList.remove('hidden');
                    confirmRemoveBtn.disabled = false;
                    btnText.textContent = "Disconnect";
                    spinner.classList.add('hidden');
                }
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // --- Notifications Logic ---
            const notificationBtn = document.getElementById('notificationBtn');
            const notificationPanel = document.getElementById('notificationPanel');
            const notificationList = document.getElementById('notificationList');
            const unreadBadge = document.getElementById('unreadBadge');
            const markAllReadBtn = document.getElementById('markAllReadBtn');
            
            let notificationsOpen = false;

            if (notificationBtn) {
                notificationBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    notificationsOpen = !notificationsOpen;
                    notificationPanel.classList.toggle('hidden', !notificationsOpen);
                    if (notificationsOpen) fetchNotifications();
                });
            }

            document.addEventListener('click', (e) => {
                if (notificationsOpen && !document.getElementById('notificationDropdownContainer').contains(e.target)) {
                    notificationsOpen = false;
                    notificationPanel.classList.add('hidden');
                }
            });

            if (notificationPanel) {
                notificationPanel.addEventListener('click', (e) => {
                    e.stopPropagation();
                });
            }

            async function fetchNotifications() {
                try {
                    const res = await fetch('/parent/api/notifications?limit=10');
                    const data = await res.json();
                    
                    if (data.success) {
                        updateUnreadBadge(data.unreadCount);
                        renderNotifications(data.notifications);
                    }
                } catch (error) {
                    console.error('Failed to load notifications', error);
                    notificationList.innerHTML = '<div class="p-4 text-center text-sm text-red-500">Failed to load notifications. Please try again.</div>';
                }
            }

            function updateUnreadBadge(count) {
                if (count > 0) {
                    unreadBadge.textContent = count > 99 ? '99+' : count;
                    unreadBadge.classList.remove('hidden');
                    markAllReadBtn.classList.remove('hidden');
                } else {
                    unreadBadge.classList.add('hidden');
                    markAllReadBtn.classList.add('hidden');
                }
            }

            function renderNotifications(notifications) {
                if (!notifications || notifications.length === 0) {
                    notificationList.innerHTML = `<div class="p-8 text-center flex flex-col items-center">
                        <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-3 text-xl">
                            <i class="fa-regular fa-bell-slash"></i>
                        </div>
                        <p class="text-sm text-slate-500">You're all caught up!</p>
                    </div>`;
                    return;
                }

                notificationList.innerHTML = notifications.map(notif => {
                    const isUnread = !notif.isRead;
                    const bgColor = isUnread ? 'bg-emerald-50/50' : 'bg-white';
                    const iconColor = isUnread ? 'text-emerald-500' : 'text-slate-400';
                    const titleColor = isUnread ? 'text-slate-900 font-bold' : 'text-slate-700 font-semibold';
                    
                    const date = new Date(notif.createdAt);
                    const now = new Date();
                    const diffMs = now - date;
                    const diffMins = Math.floor(diffMs / 60000);
                    const diffHrs = Math.floor(diffMins / 60);
                    const diffDays = Math.floor(diffHrs / 24);
                    let timeStr = 'Just now';
                    if (diffDays > 0) timeStr = diffDays === 1 ? 'Yesterday' : `${diffDays}d ago`;
                    else if (diffHrs > 0) timeStr = `${diffHrs}h ago`;
                    else if (diffMins > 0) timeStr = `${diffMins}m ago`;

                    let icon = 'fa-solid fa-bell';
                    if (notif.type === 'assignment_submitted') icon = 'fa-solid fa-file-arrow-up';
                    if (notif.type === 'assignment_reviewed') icon = 'fa-solid fa-check-double';
                    if (notif.type === 'quiz_completed') icon = 'fa-solid fa-spell-check';
                    if (notif.type === 'achievement_earned') icon = 'fa-solid fa-trophy text-yellow-500';

                    return `
                        <div class="p-4 flex gap-3 hover:bg-slate-50 transition-colors cursor-pointer ${bgColor}" onclick="handleNotificationClick('${notif._id}', '${notif.link || ''}')">
                            <div class="shrink-0 w-8 h-8 rounded-full bg-white border border-slate-100 shadow-sm flex items-center justify-center ${iconColor} mt-1">
                                <i class="${icon} text-xs"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm ${titleColor} truncate">${notif.title}</p>
                                <p class="text-xs text-slate-500 mt-0.5 line-clamp-2">${notif.message}</p>
                                <p class="text-[10px] font-medium text-slate-400 mt-1">${timeStr}</p>
                            </div>
                            ${isUnread ? '<div class="shrink-0 w-2 h-2 rounded-full bg-emerald-500 mt-2"></div>' : ''}
                        </div>
                    `;
                }).join('');
            }

            fetchNotifications();

            window.handleNotificationClick = async (id, link) => {
                try {
                    await fetch(`/parent/api/notifications/${id}/read`, { method: 'PATCH' });
                    if (link && link !== 'null') {
                        window.location.href = link;
                    } else {
                        fetchNotifications();
                    }
                } catch (error) {
                    console.error('Failed to mark as read', error);
                }
            };

            if (markAllReadBtn) {
                markAllReadBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    try {
                        const res = await fetch('/parent/api/notifications/read-all', { method: 'PATCH' });
                        if (res.ok) fetchNotifications();
                    } catch (error) {
                        console.error('Failed to mark all as read', error);
                    }
                });
            }
        });
    </script>

<script>
    // Profile Dropdown Toggle
    document.addEventListener('DOMContentLoaded', () => {
        const profileBtn = document.getElementById('profileDropdownBtn');
        const profilePanel = document.getElementById('profileDropdownPanel');
        
        if (profileBtn && profilePanel) {
            profileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isExpanded = profileBtn.getAttribute('aria-expanded') === 'true';
                profileBtn.setAttribute('aria-expanded', !isExpanded);
                profilePanel.classList.toggle('hidden');
                
                // Close notification panel if open
                const notifPanel = document.getElementById('notificationPanel');
                if (notifPanel && !notifPanel.classList.contains('hidden')) {
                    notifPanel.classList.add('hidden');
                }
            });

            // Close when clicking outside
            document.addEventListener('click', (e) => {
                if (!profileBtn.contains(e.target) && !profilePanel.contains(e.target)) {
                    profilePanel.classList.add('hidden');
                    profileBtn.setAttribute('aria-expanded', 'false');
                }
            });
            
            // Close on escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !profilePanel.classList.contains('hidden')) {
                    profilePanel.classList.add('hidden');
                    profileBtn.setAttribute('aria-expanded', 'false');
                    profileBtn.focus();
                }
            });
        }
    });
</script>

    <%- include('../partials/language-modal') %>
</body>
</html>
