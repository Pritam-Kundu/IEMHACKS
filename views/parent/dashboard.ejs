<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        .sidebar-active { 
            background-color: #f0fdf4; 
            color: #16a34a; 
            font-weight: 600; 
            border-right: 4px solid #16a34a; 
        }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { 
            background-color: #f1f5f9; 
            color: #334155; 
        }
        
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-xl">E</div>
                <span class="text-xl font-bold text-slate-900">EduSmart <span class="text-xs text-emerald-600 ml-1 font-semibold uppercase">Family</span></span>
            </div>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/parent/dashboard" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-house-chimney w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/parent/children" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-children w-5 text-center"></i>
                <span>My Children</span>
            </a>
            <a href="/parent/progress" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span>Progress</span>
            </a>
            <a href="/parent/assignments" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-file-signature w-5 text-center"></i>
                <span>Assignments</span>
            </a>
            <a href="/parent/achievements" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span>Achievements</span>
            </a>
            <a href="/parent/notifications" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-bell w-5 text-center"></i>
                <span>Notifications</span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/parent/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
            <form action="/auth/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block">Parent Dashboard</h1>
                </div>
                
                <div class="flex items-center gap-5">
                    <!-- Notification Icon -->
                    <button class="relative text-slate-500 hover:text-emerald-600 transition-colors focus:outline-none">
                        <i class="fa-regular fa-bell text-xl"></i>
                        <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    
                    <!-- Parent Profile -->
                    <a href="/parent/profile" class="flex items-center gap-3 cursor-pointer group">
                        <img src="<%= user.profilePicture || '/images/default-avatar.png' %>" alt="Profile" class="w-9 h-9 rounded-full object-cover border-2 border-emerald-100 group-hover:border-emerald-300 transition-colors">
                        <div class="hidden md:block">
                            <p class="text-sm font-semibold text-slate-800"><%= user.name %></p>
                            <p class="text-xs text-slate-500 capitalize"><%= user.role %></p>
                        </div>
                    </a>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            
            <% if (children && children.length > 0) { %>
                <!-- Child Selector & Welcome Section -->
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800 mb-1">Good Morning, <%= user.name %>! 👋</h2>
                        <p class="text-slate-500">Track your child's learning journey and academic progress.</p>
                    </div>
                    
                    <div class="flex items-center gap-4 shrink-0">
                        <button onclick="document.getElementById('linkStudentModal').classList.remove('hidden')" class="text-sm font-semibold text-emerald-600 bg-emerald-50 hover:bg-emerald-100 px-3 py-2 rounded-lg transition-colors flex items-center gap-2">
                            <i class="fa-solid fa-plus"></i> Add Child
                        </button>
                    
                    <% if (children.length > 1) { %>
                        <div class="bg-white border border-slate-200 rounded-xl p-2 shadow-sm shrink-0 flex items-center">
                            <span class="text-sm text-slate-500 px-3 font-medium">Viewing progress for:</span>
                            <div class="relative">
                                <select id="childSelector" class="appearance-none bg-slate-50 border border-slate-200 text-slate-800 text-sm font-bold rounded-lg focus:ring-emerald-500 focus:border-emerald-500 block w-full pr-8 pl-3 py-2 cursor-pointer" onchange="window.location.href='/parent/dashboard?childId=' + this.value">
                                    <% children.forEach(child => { %>
                                        <option value="<%= child.id %>" <%= selectedChild.id === child.id ? 'selected' : '' %>><%= child.name %></option>
                                    <% }) %>
                                </select>
                                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Single child display -->
                        <div class="bg-emerald-50 border border-emerald-100 rounded-xl px-4 py-2 flex items-center gap-3 shrink-0">
                            <img src="<%= selectedChild.profilePicture || '/images/default-avatar.png' %>" class="w-8 h-8 rounded-full border border-emerald-200">
                            <div>
                                <p class="text-xs text-emerald-600 font-semibold uppercase tracking-wider">Student Profile</p>
                                <p class="text-sm font-bold text-slate-800"><%= selectedChild.name %></p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

                <!-- Overview Statistics Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
                    <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between group">
                        <div>
                            <p class="text-sm text-slate-500 font-medium mb-1">Overall Progress</p>
                            <div class="flex items-baseline gap-2">
                                <p class="text-2xl font-bold text-slate-800"><%= overallProgress %>%</p>
                            </div>
                        </div>
                        <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-bars-progress"></i>
                        </div>
                    </div>
                    
                    <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between group">
                        <div>
                            <p class="text-sm text-slate-500 font-medium mb-1">Avg Quiz Score</p>
                            <p class="text-2xl font-bold text-slate-800"><%= averageQuizScore %>%</p>
                        </div>
                        <div class="w-12 h-12 rounded-full bg-purple-50 text-purple-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-bullseye"></i>
                        </div>
                    </div>
                    
                    <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between group">
                        <div>
                            <p class="text-sm text-slate-500 font-medium mb-1">Learning Streak</p>
                            <p class="text-2xl font-bold text-slate-800"><%= learningStreak %> <span class="text-sm font-normal text-slate-500">days</span></p>
                        </div>
                        <div class="w-12 h-12 rounded-full bg-orange-50 text-orange-500 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-fire"></i>
                        </div>
                    </div>
                    
                    <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between group">
                        <div>
                            <p class="text-sm text-slate-500 font-medium mb-1">Lessons Completed</p>
                            <p class="text-2xl font-bold text-slate-800"><%= completedLessonsCount %></p>
                        </div>
                        <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-check-double"></i>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 sm:gap-8 mb-8">
                    <!-- Left Column -->
                    <div class="xl:col-span-2 space-y-8">
                        
                        <!-- Courses Overview -->
                        <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                            <div class="p-5 border-b border-slate-200 flex items-center justify-between">
                                <h3 class="text-lg font-bold text-slate-800">Current Courses</h3>
                            </div>
                            
                            <% if (courses && courses.length > 0) { %>
                                <div class="divide-y divide-slate-100">
                                    <% courses.forEach(course => { %>
                                        <div class="p-5 flex flex-col sm:flex-row gap-5 hover:bg-slate-50 transition-colors">
                                            <div class="w-16 h-16 rounded-xl bg-slate-100 shrink-0 hidden sm:block">
                                                <img src="<%= course.thumbnail || '/images/default-course.png' %>" class="w-full h-full object-cover rounded-xl" alt="Course Thumbnail">
                                            </div>
                                            <div class="flex-1">
                                                <div class="flex justify-between items-start mb-1">
                                                    <h4 class="font-bold text-slate-800"><%= course.title %></h4>
                                                    <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded"><%= course.progressPercent %>%</span>
                                                </div>
                                                <p class="text-xs text-slate-500 mb-3"><i class="fa-solid fa-chalkboard-user mr-1"></i> <%= course.teacher ? course.teacher.name : 'Instructor' %></p>
                                                
                                                <!-- Progress Bar -->
                                                <div class="w-full bg-slate-100 rounded-full h-2 mb-1">
                                                    <div class="bg-emerald-500 h-2 rounded-full" style="width: <%= course.progressPercent %>%"></div>
                                                </div>
                                                <p class="text-[10px] text-slate-400 font-medium"><%= course.completedLessons %> lessons completed</p>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="p-8 text-center flex flex-col items-center">
                                    <div class="w-14 h-14 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-3 text-xl border border-slate-100">
                                        <i class="fa-solid fa-book"></i>
                                    </div>
                                    <p class="text-slate-500 text-sm">No courses enrolled yet.</p>
                                </div>
                            <% } %>
                        </section>

                        <!-- Assignments Overview -->
                        <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                            <div class="p-5 border-b border-slate-200 flex items-center justify-between">
                                <h3 class="text-lg font-bold text-slate-800">Assignments</h3>
                            </div>
                            
                            <% if (submissions && submissions.length > 0) { %>
                                <div class="divide-y divide-slate-100">
                                    <% submissions.forEach(sub => { %>
                                        <div class="p-4 flex items-center justify-between">
                                            <div>
                                                <h4 class="font-semibold text-sm text-slate-800"><%= sub.assignment ? sub.assignment.title : 'Assignment' %></h4>
                                                <p class="text-xs text-slate-500"><%= sub.assignment?.course?.title || 'Course' %></p>
                                            </div>
                                            <div class="text-right">
                                                <% if (sub.status === 'graded') { %>
                                                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-bold bg-emerald-100 text-emerald-700">Graded: <%= sub.score %>%</span>
                                                <% } else if (sub.status === 'submitted') { %>
                                                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-50 text-blue-600">Pending Review</span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-red-50 text-red-600">Late</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="p-6 text-center">
                                    <p class="text-slate-500 text-sm">No assignments at the moment.</p>
                                </div>
                            <% } %>
                        </section>
                    </div>

                    <!-- Right Column -->
                    <div class="space-y-8">
                        
                        <!-- Learning Insights -->
                        <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl p-5 text-white shadow-sm relative overflow-hidden">
                            <div class="absolute right-0 top-0 w-32 h-32 bg-white opacity-10 rounded-full -translate-y-1/2 translate-x-1/3"></div>
                            
                            <h3 class="font-bold text-lg mb-3 flex items-center gap-2 relative z-10">
                                <i class="fa-solid fa-lightbulb text-yellow-300"></i> Learning Insights
                            </h3>
                            
                            <div class="space-y-3 relative z-10">
                                <% if (overallProgress > 0) { %>
                                    <p class="text-sm text-emerald-50 bg-white/10 px-3 py-2 rounded-lg backdrop-blur-sm border border-white/20"><%= selectedChild.name %> has a strong learning streak! Keeping a routine improves retention.</p>
                                <% } %>
                                
                                <% if (averageQuizScore > 80) { %>
                                    <p class="text-sm text-emerald-50 bg-white/10 px-3 py-2 rounded-lg backdrop-blur-sm border border-white/20">Quiz performance is excellent (<%= averageQuizScore %>% avg).</p>
                                <% } else if (averageQuizScore > 0) { %>
                                    <p class="text-sm text-emerald-50 bg-white/10 px-3 py-2 rounded-lg backdrop-blur-sm border border-white/20">Reviewing recent quiz mistakes with <%= selectedChild.name %> can help reinforce concepts.</p>
                                <% } else { %>
                                    <p class="text-sm text-emerald-50 bg-white/10 px-3 py-2 rounded-lg backdrop-blur-sm border border-white/20">More learning activity is needed to generate insights.</p>
                                <% } %>
                            </div>
                        </div>

                        <!-- Recent Activity -->
                        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                            <div class="p-5 border-b border-slate-200">
                                <h3 class="font-bold text-slate-800">Recent Activity</h3>
                            </div>
                            <div class="p-5">
                                <% if (activities && activities.length > 0) { %>
                                    <div class="space-y-4">
                                        <% activities.forEach((activity, index) => { %>
                                            <div class="flex items-start gap-3 <%= index !== activities.length - 1 ? 'pb-4 border-b border-slate-50' : '' %>">
                                                <div class="shrink-0 w-8 h-8 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-500 text-xs mt-0.5">
                                                    <% if (activity.type === 'quiz') { %>
                                                        <i class="fa-solid fa-spell-check text-purple-500"></i>
                                                    <% } else if (activity.type === 'assignment') { %>
                                                        <i class="fa-solid fa-file-arrow-up text-orange-500"></i>
                                                    <% } else { %>
                                                        <i class="fa-solid fa-check text-emerald-500"></i>
                                                    <% } %>
                                                </div>
                                                <div>
                                                    <p class="text-sm font-semibold text-slate-700 leading-tight"><%= activity.title %></p>
                                                    <p class="text-xs text-slate-500 mt-0.5"><%= activity.description %></p>
                                                    <time class="text-[10px] text-slate-400 font-medium"><%= new Date(activity.date).toLocaleDateString() %></time>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="text-center py-4">
                                        <p class="text-sm text-slate-500">No recent learning activity.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Achievements Summary -->
                        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                            <div class="p-5 border-b border-slate-200 flex items-center justify-between">
                                <h3 class="font-bold text-slate-800">Achievements</h3>
                            </div>
                            <div class="p-5">
                                <% if (selectedChild.badges && selectedChild.badges.length > 0) { %>
                                    <div class="flex flex-wrap gap-2">
                                        <% selectedChild.badges.slice(0,4).forEach(b => { %>
                                            <div class="flex flex-col items-center bg-slate-50 rounded-lg p-2 border border-slate-100 w-16 text-center">
                                                <img src="<%= b.badge?.iconUrl || '/images/badge-default.png' %>" class="w-8 h-8 mb-1" alt="Badge">
                                                <p class="text-[9px] font-bold text-slate-600 leading-tight"><%= b.badge?.name || 'Badge' %></p>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="text-center py-4">
                                        <p class="text-sm text-slate-500">No achievements yet.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </div>
                </div>

            <% } else { %>
                <!-- Empty State: No Children Linked -->
                <div class="flex flex-col items-center justify-center h-full max-w-lg mx-auto text-center py-20">
                    <div class="w-24 h-24 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center text-4xl mb-6 shadow-sm">
                        <i class="fa-solid fa-children"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-800 mb-2">Welcome to EduSmart Family!</h2>
                    <p class="text-slate-500 mb-8">No student profile is linked to your account yet. Connect your child's account to start monitoring their academic progress, assignments, and achievements.</p>
                    <button onclick="document.getElementById('linkStudentModal').classList.remove('hidden')" class="bg-emerald-600 text-white font-semibold px-6 py-3 rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">Link Student Account</button>
                </div>
            <% } %>
            
        </div>
        
        <!-- Link Student Account Modal -->
        <div id="linkStudentModal" class="fixed inset-0 bg-slate-900/50 z-50 hidden flex items-center justify-center transition-opacity">
            <div class="bg-white rounded-xl shadow-lg w-full max-w-md p-6 transform transition-transform mx-4">
                <h3 class="text-xl font-bold text-slate-800 mb-2">Add Your Child</h3>
                <p class="text-slate-500 text-sm mb-6">Enter your child's registered email address to connect their account.</p>
                
                <form id="linkStudentForm">
                    <div class="mb-4">
                        <label for="childEmail" class="block text-sm font-medium text-slate-700 mb-1">Child's Email Address</label>
                        <input type="email" id="childEmail" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-emerald-500 focus:border-emerald-500" placeholder="student@example.com">
                    </div>
                    
                    <div id="linkStudentError" class="hidden mb-4 p-3 bg-red-50 text-red-600 text-sm rounded-lg border border-red-100"></div>
                    <div id="linkStudentSuccess" class="hidden mb-4 p-3 bg-emerald-50 text-emerald-600 text-sm rounded-lg border border-emerald-100">Child added successfully. Refreshing...</div>
                    
                    <div class="flex justify-end gap-3 mt-6">
                        <button type="button" onclick="document.getElementById('linkStudentModal').classList.add('hidden')" class="px-4 py-2 text-slate-600 font-medium hover:bg-slate-100 rounded-lg transition-colors">Cancel</button>
                        <button type="submit" id="submitLinkBtn" class="px-4 py-2 bg-emerald-600 text-white font-medium rounded-lg hover:bg-emerald-700 transition-colors flex items-center gap-2">
                            <span id="submitLinkBtnText">Add Child</span>
                            <i id="submitLinkSpinner" class="fa-solid fa-spinner fa-spin hidden"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="/js/firebase-config.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Mobile Sidebar Toggle
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            // Link Student Account Logic
            if (!firebase.apps.length) {
                firebase.initializeApp(window.FIREBASE_CONFIG);
            }

            const linkForm = document.getElementById('linkStudentForm');
            const submitBtn = document.getElementById('submitLinkBtn');
            const submitBtnText = document.getElementById('submitLinkBtnText');
            const submitSpinner = document.getElementById('submitLinkSpinner');
            const errorDiv = document.getElementById('linkStudentError');
            const successDiv = document.getElementById('linkStudentSuccess');

            if (linkForm) {
                linkForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    
                    const email = document.getElementById('childEmail').value.trim();
                    if (!email) {
                        showError("Please enter your child's email address.");
                        return;
                    }

                    // Reset state
                    errorDiv.classList.add('hidden');
                    successDiv.classList.add('hidden');
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
                    submitBtnText.textContent = "Adding child...";
                    submitSpinner.classList.remove('hidden');

                    try {
                        const response = await fetch('/parent/api/children/link', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ email })
                        });

                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Failed to link account.');
                        }

                        // Success
                        successDiv.classList.remove('hidden');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);

                    } catch (err) {
                        showError(err.message || "An unexpected error occurred.");
                        resetBtn();
                    }
                });
            }

            function showError(msg) {
                errorDiv.textContent = msg;
                errorDiv.classList.remove('hidden');
            }

            function resetBtn() {
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                submitBtnText.textContent = "Add Child";
                submitSpinner.classList.add('hidden');
            }
        });
    </script>
</body>
</html>
