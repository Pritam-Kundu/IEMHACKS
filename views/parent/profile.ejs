<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        .sidebar-active { 
            background-color: #f0fdf4; 
            color: #16a34a; 
            font-weight: 600; 
            border-right: 4px solid #16a34a; 
        }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { 
            background-color: #f1f5f9; 
            color: #334155; 
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/parent/dashboard" class="flex items-center gap-2 text-emerald-600 hover:text-emerald-700 transition-colors">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
                <span class="font-mono text-xl font-bold tracking-tight text-slate-900">EduSmart <span class="font-sans text-xs text-emerald-600 ml-1 font-semibold uppercase tracking-normal">Family</span></span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/parent/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-house-chimney w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/parent/children" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-children w-5 text-center"></i>
                <span>My Children</span>
            </a>
            <a href="/parent/progress" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span>Progress</span>
            </a>
            <a href="/parent/assignments" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-file-signature w-5 text-center"></i>
                <span>Assignments</span>
            </a>
            <a href="/parent/achievements" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span>Achievements</span>
            </a>
            </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/parent/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full relative">
        
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block mr-6">Profile</h1>
                </div>
                
                <div class="flex items-center gap-5">

                    <!-- Notification Icon & Dropdown -->
                    <div class="relative" id="notificationDropdownContainer">
                        <button id="notificationBtn" class="relative text-slate-500 hover:text-emerald-600 transition-colors focus:outline-none">
                            <i class="fa-regular fa-bell text-xl"></i>
                            <span id="unreadBadge" class="hidden absolute -top-2 -right-2 text-[9px] font-bold text-white bg-red-500 rounded-full px-1.5 py-0.5 border-2 border-white">0</span>
                        </button>
                        
                        <!-- Dropdown Panel -->
                        <div id="notificationPanel" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white rounded-xl shadow-lg border border-slate-200 z-50 overflow-hidden transform origin-top-right transition-all">
                            <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                                <h3 class="font-bold text-slate-800">Notifications</h3>
                                <button id="markAllReadBtn" class="text-xs font-semibold text-emerald-600 hover:text-emerald-700 hidden">Mark all as read</button>
                            </div>
                            <div id="notificationList" class="max-h-96 overflow-y-auto divide-y divide-slate-100">
                                <!-- Notifications will be injected here -->
                                <div class="p-4 text-center text-sm text-slate-500">Loading notifications...</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Parent Profile -->
                    <div class="relative" id="profileDropdownContainer">
                        <button id="profileDropdownBtn" class="flex items-center gap-3 cursor-pointer group focus:outline-none" aria-label="Open profile menu" aria-expanded="false" aria-haspopup="true">
                            <% 
                                let profileInitials = '';
                                if (!user.profilePicture || user.profilePicture === '/images/default-avatar.png') {
                                    let names = user.name.split(' ');
                                    profileInitials = names[0].charAt(0).toUpperCase() + (names.length > 1 ? names[names.length - 1].charAt(0).toUpperCase() : '');
                                }
                            %>
                            <% if (profileInitials) { %>
                                <div class="w-9 h-9 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold border-2 border-emerald-100 group-hover:border-emerald-300 transition-colors">
                                    <%= profileInitials %>
                                </div>
                            <% } else { %>
                                <img src="<%= user.profilePicture %>" alt="Profile"
                                    class="w-9 h-9 rounded-full object-cover border-2 border-emerald-100 group-hover:border-emerald-300 transition-colors">
                            <% } %>
                            <div class="hidden md:block text-left">
                                <p class="text-sm font-semibold text-slate-800 leading-tight">
                                    <%= user.name %>
                                </p>
                                <p class="text-xs text-slate-500 capitalize leading-tight mt-0.5">
                                    <%= user.role %>
                                </p>
                            </div>
                            <i class="fa-solid fa-chevron-down text-slate-400 text-xs ml-1 group-hover:text-slate-600 transition-colors hidden md:block"></i>
                        </button>

                        <!-- Profile Dropdown Panel -->
                        <div id="profileDropdownPanel" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-slate-200 z-50 overflow-hidden transform origin-top-right transition-all">
                            <div class="p-4 border-b border-slate-100 bg-slate-50 flex items-center gap-3">
                                <% if (profileInitials) { %>
                                    <div class="w-12 h-12 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-lg border-2 border-emerald-100 shadow-sm shrink-0">
                                        <%= profileInitials %>
                                    </div>
                                <% } else { %>
                                    <img src="<%= user.profilePicture %>" alt="Profile"
                                        class="w-12 h-12 rounded-full object-cover border-2 border-emerald-100 shadow-sm shrink-0">
                                <% } %>
                                <div class="overflow-hidden">
                                    <p class="font-bold text-slate-800 truncate"><%= user.name %></p>
                                    <p class="text-xs text-slate-500 truncate"><%= user.email %></p>
                                    <p class="text-xs font-semibold text-emerald-600 capitalize mt-0.5"><%= user.role %></p>
                                </div>
                            </div>
                            <div class="p-2 py-2">
                                <a href="/parent/profile" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-emerald-600 transition-colors">
                                    <i class="fa-regular fa-user w-5 text-center text-slate-400"></i> Profile
                                </a>
                                <a href="/parent/settings" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-emerald-600 transition-colors">
                                    <i class="fa-solid fa-gear w-5 text-center text-slate-400"></i> Settings
                                </a>
                            </div>
                            <div class="p-2 border-t border-slate-100">
                                <form action="/logout" method="POST" class="w-full m-0">
                                    <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 transition-colors text-left">
                                        <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i> Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800 mb-1">My Profile</h2>
                    <p class="text-slate-500">View your personal account information.</p>
                </div>
                <a href="/parent/settings" class="bg-emerald-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-emerald-700 transition-colors shadow-sm flex items-center justify-center gap-2">
                    <i class="fa-solid fa-pen-to-square"></i> Edit Profile
                </a>
            </div>

            <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 max-w-3xl">
                <h3 class="text-lg font-bold text-slate-800 mb-6 border-b border-slate-100 pb-3">Profile Information</h3>
                
                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8">
                    <div class="shrink-0 flex flex-col items-center">
                        <% 
                            let profileInitials = '';
                            if (!user.profilePicture || user.profilePicture === '/images/default-avatar.png') {
                                let names = user.name.split(' ');
                                profileInitials = names[0].charAt(0).toUpperCase() + (names.length > 1 ? names[names.length - 1].charAt(0).toUpperCase() : '');
                            }
                        %>
                        <% if (profileInitials) { %>
                            <div class="w-32 h-32 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-4xl border-4 border-emerald-50 shadow-md">
                                <%= profileInitials %>
                            </div>
                        <% } else { %>
                            <img src="<%= user.profilePicture %>" alt="Profile" class="w-32 h-32 rounded-full object-cover border-4 border-emerald-50 shadow-md">
                        <% } %>
                        
                        <span class="mt-4 bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">
                            <%= user.role %>
                        </span>
                    </div>
                    
                    <div class="flex-1 w-full grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <p class="text-sm text-slate-500 font-medium mb-1">Full Name</p>
                            <p class="font-semibold text-slate-800 text-lg"><%= user.name %></p>
                        </div>
                        
                        <div>
                            <p class="text-sm text-slate-500 font-medium mb-1">Email Address</p>
                            <p class="font-semibold text-slate-800 text-lg"><%= user.email %></p>
                        </div>
                        
                        <div>
                            <p class="text-sm text-slate-500 font-medium mb-1">Role</p>
                            <p class="font-semibold text-slate-800 text-lg capitalize"><%= user.role %></p>
                        </div>
                        
                        <div>
                            <p class="text-sm text-slate-500 font-medium mb-1">Member Since</p>
                            <p class="font-semibold text-slate-800 text-lg">
                                <%= new Date(user.createdAt || Date.now()).toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Connected Children -->
            <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 max-w-3xl mt-6">
                <div class="flex items-center justify-between mb-6 border-b border-slate-100 pb-3">
                    <h3 class="text-lg font-bold text-slate-800">Connected Children</h3>
                    <a href="/parent/children" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700">Manage Children</a>
                </div>
                
                <% if (typeof connectedChildren !== 'undefined' && connectedChildren && connectedChildren.length > 0) { %>
                    <div class="space-y-4">
                        <% connectedChildren.forEach(child => { %>
                            <div class="flex items-center justify-between p-4 border border-slate-100 rounded-lg hover:bg-slate-50 transition-colors">
                                <div class="flex items-center gap-4">
                                    <% 
                                        let childInitials = '';
                                        if (!child.profilePicture || child.profilePicture === '/images/default-avatar.png') {
                                            let childNames = child.name.split(' ');
                                            childInitials = childNames[0].charAt(0).toUpperCase() + (childNames.length > 1 ? childNames[childNames.length - 1].charAt(0).toUpperCase() : '');
                                        }
                                    %>
                                    <% if (childInitials) { %>
                                        <div class="w-12 h-12 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-lg border-2 border-blue-50 shadow-sm shrink-0">
                                            <%= childInitials %>
                                        </div>
                                    <% } else { %>
                                        <img src="<%= child.profilePicture %>" alt="<%= child.name %>" class="w-12 h-12 rounded-full object-cover border-2 border-emerald-50 shadow-sm shrink-0">
                                    <% } %>
                                    
                                    <div>
                                        <h4 class="font-bold text-slate-800"><%= child.name %></h4>
                                        <div class="flex items-center gap-2 mt-0.5">
                                            <span class="bg-blue-50 text-blue-700 text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded">Student</span>
                                            <% if (child.email) { %>
                                                <span class="text-xs text-slate-500"><%= child.email %></span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                
                                <a href="/parent/children/<%= child.id %>" class="px-4 py-2 bg-white border border-slate-200 text-slate-600 text-sm font-medium rounded-lg hover:bg-slate-50 hover:text-emerald-600 transition-colors shadow-sm">
                                    View Details
                                </a>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-8 text-slate-500 bg-slate-50 rounded-lg border border-slate-200 border-dashed">
                        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mx-auto mb-3 shadow-sm border border-slate-100">
                            <i class="fa-solid fa-child text-slate-400 text-lg"></i>
                        </div>
                        <p class="font-medium text-slate-600 mb-1">No children connected yet</p>
                        <p class="text-sm">Link your child's account to monitor their progress.</p>
                        <a href="/parent/children" class="inline-block mt-4 text-sm font-semibold text-emerald-600 hover:text-emerald-700">Go to My Children</a>
                    </div>
                <% } %>
            </div>

        </div>
    </main>

    <script>
        // Sidebar Toggle Logic
        const sidebar = document.getElementById('sidebar');
        const openSidebarBtn = document.getElementById('openSidebarBtn');
        const closeSidebarBtn = document.getElementById('closeSidebarBtn');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        function toggleSidebar() {
            sidebar.classList.toggle('-translate-x-full');
            sidebarOverlay.classList.toggle('hidden');
        }

        if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
        if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
        if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);
    </script>

<script>
    // Profile Dropdown Toggle
    document.addEventListener('DOMContentLoaded', () => {
        const profileBtn = document.getElementById('profileDropdownBtn');
        const profilePanel = document.getElementById('profileDropdownPanel');
        
        if (profileBtn && profilePanel) {
            profileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isExpanded = profileBtn.getAttribute('aria-expanded') === 'true';
                profileBtn.setAttribute('aria-expanded', !isExpanded);
                profilePanel.classList.toggle('hidden');
                
                // Close notification panel if open
                const notifPanel = document.getElementById('notificationPanel');
                if (notifPanel && !notifPanel.classList.contains('hidden')) {
                    notifPanel.classList.add('hidden');
                }
            });

            // Close when clicking outside
            document.addEventListener('click', (e) => {
                if (!profileBtn.contains(e.target) && !profilePanel.contains(e.target)) {
                    profilePanel.classList.add('hidden');
                    profileBtn.setAttribute('aria-expanded', 'false');
                }
            });
            
            // Close on escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !profilePanel.classList.contains('hidden')) {
                    profilePanel.classList.add('hidden');
                    profileBtn.setAttribute('aria-expanded', 'false');
                    profileBtn.focus();
                }
            });
        }
    });
</script>

</body>
</html>
