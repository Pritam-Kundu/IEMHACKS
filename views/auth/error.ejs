<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied - EduSmart</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-lg p-8 text-center border border-slate-100">
        <div class="w-16 h-16 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-ban text-2xl"></i>
        </div>
        
        <h1 class="text-2xl font-bold text-slate-800 mb-2">Access Denied</h1>
        <p class="text-slate-600 mb-8"><%= message || 'You do not have permission to access this page.' %></p>
        
        <div class="flex flex-col gap-3">
            <button onclick="window.history.back()" class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors">
                Go Back
            </button>
            <a href="/" class="w-full py-2.5 px-4 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-medium rounded-lg transition-colors">
                Return to Home
            </a>
        </div>
    </div>
    <%- include('../partials/language-modal') %>
</body>
</html>
