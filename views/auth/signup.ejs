<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('auth.signupTitle') %></title>
    <meta name="description" content="Register for EduSmart to start your personalized learning journey.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Include Centralized Firebase Config -->
    <script src="/js/firebase-config.js"></script>
    
    <style>
        /* Minimal custom styling, primarily handled by Tailwind */
        .strength-weak { background-color: #ef4444 !important; }
        .strength-fair { background-color: #eab308 !important; }
        .strength-good { background-color: #22c55e !important; }
        input:focus + button { color: #4f46e5; }
        
        @keyframes fade-in-up {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up {
            animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes float {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-20px) scale(1.05); }
        }
        .animate-float {
            animation: float 8s ease-in-out infinite;
        }
        .animate-float-delayed {
            animation: float 10s ease-in-out infinite 2s;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-indigo-50 via-white to-purple-50 text-gray-800 font-sans antialiased flex flex-col min-h-screen relative overflow-x-hidden">
    <!-- Ambient Background Orbs -->
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-indigo-200/50 rounded-full blur-[100px] animate-float pointer-events-none z-0"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-purple-200/50 rounded-full blur-[100px] animate-float-delayed pointer-events-none z-0"></div>
    
    <div class="relative z-20">
    <%- include('../partials/navbar') %>

    </div>

    <div class="flex-1 flex items-center justify-center p-6 relative z-10 pt-24">
        
        <!-- Glass Container -->
        <div class="w-full max-w-5xl bg-white/70 backdrop-blur-2xl border border-white shadow-[0_8px_30px_rgb(0,0,0,0.04)] rounded-[2rem] overflow-hidden flex flex-col md:flex-row animate-fade-in-up">
        
        <!-- Left Side: Branding/Illustration -->
        <div class="hidden md:flex md:w-5/12 bg-gradient-to-br from-indigo-600 to-indigo-800 text-white flex-col justify-center items-center p-12 relative overflow-hidden">
            <!-- Inner glow for branding -->
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4IiBoZWlnaHQ9IjgiPgo8cmVjdCB3aWR0aD0iOCIgaGVpZ2h0PSI4IiBmaWxsPSIjZmZmIiBmaWxsLW9wYWNpdHk9IjAuMDUiLz4KPC9zdmc+')] opacity-20"></div>
            
            <div class="relative z-10 max-w-md text-center">
                <div class="w-20 h-20 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center mx-auto mb-8 shadow-xl border border-white/30 rotate-3 transition-transform hover:rotate-6">
                    <i class="fas fa-rocket text-4xl text-white"></i>
                </div>
                <h1 class="text-4xl font-extrabold mb-4 tracking-tight"><%= t('auth.joinEduSmart') %></h1>
                <p class="text-lg text-indigo-100 font-medium leading-relaxed mb-8">
                    <%= t('auth.unlockPotential') %>
                </p>
                
                <div class="space-y-4 text-left bg-white/10 p-6 rounded-2xl backdrop-blur-md border border-white/20 shadow-lg">
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-check-circle text-indigo-300 mt-1"></i>
                        <span><strong class="text-white"><%= t('auth.adaptiveLearning') %></strong><br><span class="text-sm text-indigo-200"><%= t('auth.coursesTailored') %></span></span>
                    </div>
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-check-circle text-indigo-300 mt-1"></i>
                        <span><strong class="text-white"><%= t('auth.aiTutorSupport') %></strong><br><span class="text-sm text-indigo-200"><%= t('auth.instantExplanations') %></span></span>
                    </div>
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-check-circle text-indigo-300 mt-1"></i>
                        <span><strong class="text-white"><%= t('auth.richAnalytics') %></strong><br><span class="text-sm text-indigo-200"><%= t('auth.visualizeGrowth') %></span></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Signup Form -->
        <div class="w-full md:w-7/12 flex flex-col justify-center p-8 sm:p-14 bg-white/40 overflow-y-auto">
            <div class="w-full max-w-md mx-auto">
                
                <!-- Mobile Branding -->
                <div class="md:hidden text-center mb-8">
                    <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-sm border border-indigo-200">
                        <i class="fas fa-rocket text-3xl"></i>
                    </div>
                    <h1 class="text-2xl font-bold tracking-tight text-gray-900">EduSmart</h1>
                </div>

                <div class="mb-8">
                    <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2 hidden md:block"><%= t('auth.createAccount') %></h2>
                    <h2 class="text-2xl font-bold text-gray-900 tracking-tight mb-2 md:hidden"><%= t('auth.createAccount') %></h2>
                    <p class="text-gray-500 font-medium"><%= t('auth.joinEduSmartToday') %></p>
                </div>

                <!-- Alert Box -->
                <div id="alertBox" class="hidden mb-6 p-4 rounded-xl text-sm font-medium border shadow-sm" role="alert"></div>

                <div id="step1">
                <form id="signupForm" class="space-y-4" novalidate>
                    <div>
                        <label for="name" class="block text-sm font-semibold text-gray-700 mb-1.5"><%= t('auth.fullName') %></label>
                        <input type="text" id="name" name="name" required
                            class="w-full px-4 py-3 bg-white/60 border border-gray-200 rounded-xl focus:outline-none focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white transition-all shadow-sm"
                            placeholder="John Doe">
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5"><%= t('auth.emailAddress') %></label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none transition-colors group-focus-within:text-indigo-600">
                                <i class="fas fa-envelope text-gray-400 group-focus-within:text-indigo-600 transition-colors"></i>
                            </div>
                            <input type="email" id="email" name="email" required
                                class="w-full pl-11 pr-4 py-3 bg-white/60 border border-gray-200 rounded-xl focus:outline-none focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white transition-all shadow-sm"
                                placeholder="you@example.com">
                        </div>
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-semibold text-gray-700 mb-1.5"><%= t('auth.password') %></label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none transition-colors group-focus-within:text-indigo-600">
                                <i class="fas fa-lock text-gray-400 group-focus-within:text-indigo-600 transition-colors"></i>
                            </div>
                            <input type="password" id="password" name="password" required minlength="8"
                                class="w-full pl-11 pr-12 py-3 bg-white/60 border border-gray-200 rounded-xl focus:outline-none focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white transition-all shadow-sm"
                                placeholder="••••••••">
                            <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-indigo-600 focus:outline-none transition-colors" aria-label="Toggle password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        
                        <!-- Password Strength Indicator -->
                        <div class="mt-2.5 flex space-x-1 h-1.5 w-full bg-gray-200/50 rounded-full overflow-hidden">
                            <div class="h-full w-1/3 bg-gray-300 transition-all duration-300" id="strength-1"></div>
                            <div class="h-full w-1/3 bg-gray-300 transition-all duration-300" id="strength-2"></div>
                            <div class="h-full w-1/3 bg-gray-300 transition-all duration-300" id="strength-3"></div>
                        </div>
                        <p id="passwordFeedback" class="text-xs text-gray-500 mt-1.5 font-medium">Must be at least 8 characters long.</p>
                    </div>

                    <div>
                        <label for="confirmPassword" class="block text-sm font-semibold text-gray-700 mb-1.5"><%= t('auth.confirmPassword') %></label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none transition-colors group-focus-within:text-indigo-600">
                                <i class="fas fa-lock text-gray-400 group-focus-within:text-indigo-600 transition-colors"></i>
                            </div>
                            <input type="password" id="confirmPassword" name="confirmPassword" required
                                class="w-full pl-11 pr-12 py-3 bg-white/60 border border-gray-200 rounded-xl focus:outline-none focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white transition-all shadow-sm"
                                placeholder="••••••••">
                            <button type="button" id="toggleConfirmPassword" class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-indigo-600 focus:outline-none transition-colors" aria-label="Toggle confirm password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <p id="matchFeedback" class="text-xs text-red-500 mt-1.5 hidden font-medium"><%= t('auth.passwordsDoNotMatch') %></p>
                    </div>

                    <div>
                        <label for="role" class="block text-sm font-semibold text-gray-700 mb-1.5"><%= t('auth.iAmA') %></label>
                        <div class="relative">
                            <select id="role" name="role" required class="w-full px-4 py-3 bg-white/60 border border-gray-200 rounded-xl focus:outline-none focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 focus:bg-white transition-all shadow-sm appearance-none cursor-pointer font-medium text-gray-700">
                                <option value="" disabled selected><%= t('auth.selectRole') %></option>
                                <option value="student"><%= t('auth.student') %></option>
                                <option value="teacher"><%= t('auth.teacher') %></option>
                                <option value="parent"><%= t('auth.parent') %></option>
                            </select>
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <i class="fas fa-chevron-down text-gray-400"></i>
                            </div>
                        </div>
                        <p id="roleFeedback" class="text-xs text-indigo-600 mt-1.5 hidden font-medium"><%= t('auth.teacherNote') %></p>
                    </div>

                    <div class="flex items-start mt-4">
                        <div class="flex items-center h-5">
                            <input id="terms" name="terms" type="checkbox" required class="h-4.5 w-4.5 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded cursor-pointer mt-0.5">
                        </div>
                        <div class="ml-2.5 text-sm">
                            <label for="terms" class="text-gray-600 cursor-pointer"><%= t('auth.iAgreeTo') %> <a href="#" class="text-indigo-600 hover:text-indigo-700 font-bold transition-colors"><%= t('auth.termsOfService') %></a> <%= t('auth.and') %> <a href="#" class="text-indigo-600 hover:text-indigo-700 font-bold transition-colors"><%= t('auth.privacyPolicy') %></a>.</label>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full flex justify-center items-center py-3.5 px-4 mt-6 border border-transparent rounded-xl shadow-md hover:shadow-lg text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30 hover:-translate-y-0.5 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0">
                        <span id="btnText"><%= t('auth.createAccount') %></span>
                        <i id="btnSpinner" class="fas fa-circle-notch fa-spin hidden ml-2"></i>
                    </button>
                </form>

                <div class="mt-8">
                    <div class="relative">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-200"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="px-4 bg-[#f8fafe] text-gray-500 font-medium rounded-full text-xs uppercase tracking-wider"><%= t('auth.orSignUpWith') %></span>
                        </div>
                    </div>

                    <div class="mt-8">
                        <button type="button" id="googleSignupBtn" class="w-full inline-flex justify-center items-center py-3.5 px-4 border border-gray-200 rounded-xl shadow-sm bg-white text-sm font-bold text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-4 focus:ring-gray-100 transition-all hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed">
                            <svg class="w-5 h-5 mr-3" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            <%= t('auth.continueWithGoogle') %>
                        </button>
                    </div>
                </div>
                <p class="mt-10 text-center text-sm font-medium text-gray-600">
                    <%= t('auth.alreadyHaveAccount') %> 
                    <a href="/login" class="font-bold text-indigo-600 hover:text-indigo-700 transition-colors ml-1"><%= t('auth.logIn') %></a>
                </p>
                </div>

                <div id="step2" class="hidden space-y-4 animate-fade-in-up">
                    <div class="text-center">
                        <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm">
                            <i class="fas fa-envelope-open-text text-3xl"></i>
                        </div>
                        <h3 class="text-2xl font-extrabold text-gray-900"><%= t('auth.verifyEmail') %></h3>
                        <p class="text-sm text-gray-500 font-medium mt-2"><%= t('auth.weSentCode') %> <span id="displayEmail" class="font-bold text-indigo-600"></span>.</p>
                    </div>
                    <form id="otpForm" class="space-y-6 mt-6">
                        <div>
                            <label for="otp" class="block text-sm font-semibold text-gray-700 mb-2"><%= t('auth.verificationCode') %></label>
                            <input type="text" id="otp" name="otp" required maxlength="6" pattern="[0-9]{6}"
                                class="w-full px-4 py-4 text-center text-3xl tracking-[0.5em] font-bold bg-white/60 border border-gray-200 rounded-xl focus:outline-none focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all shadow-sm"
                                placeholder="------">
                        </div>
                        <button type="submit" id="otpSubmitBtn" class="w-full flex justify-center items-center py-3.5 px-4 border border-transparent rounded-xl shadow-md hover:shadow-lg text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500/30 hover:-translate-y-0.5 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                            <span id="otpBtnText"><%= t('auth.verifyCode') %></span>
                            <i id="otpBtnSpinner" class="fas fa-circle-notch fa-spin hidden ml-2"></i>
                        </button>
                        <button type="button" id="backToSignupBtn" class="w-full text-sm text-indigo-600 hover:text-indigo-800 font-bold text-center transition-colors">
                            <i class="fas fa-arrow-left mr-1"></i> <%= t('auth.backToSignup') %>
                        </button>
                    </form>
                </div>

                <div class="mt-6">
                    <div class="relative">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-200"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="px-2 bg-white text-gray-500"><%= t('auth.orSignUpWith') %></span>
                        </div>
                    </div>

                    <div class="mt-6">
                        <button type="button" id="googleSignupBtn" class="w-full inline-flex justify-center items-center py-2.5 px-4 border border-gray-300 rounded-md shadow-sm bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                            <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            <%= t('auth.continueWithGoogle') %>
                        </button>
                    </div>
                </div>

                <p class="mt-8 text-center text-sm text-gray-600">
                    <%= t('auth.alreadyHaveAccount') %> 
                    <a href="/login" class="font-bold text-indigo-600 hover:text-indigo-800 transition-colors"><%= t('auth.loginHere') %></a>
                </p>
            </div>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
        import { 
            getAuth, 
            createUserWithEmailAndPassword, 
            signInWithPopup, 
            GoogleAuthProvider,
            setPersistence,
            browserLocalPersistence
        } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

        // Initialize Firebase
        const app = initializeApp(window.FIREBASE_CONFIG);
        const auth = getAuth(app);
        const googleProvider = new GoogleAuthProvider();

        // DOM Elements
        const form = document.getElementById('signupForm');
        const nameEl = document.getElementById('name');
        const emailEl = document.getElementById('email');
        const passwordEl = document.getElementById('password');
        const confirmPasswordEl = document.getElementById('confirmPassword');
        const roleEl = document.getElementById('role');
        const termsEl = document.getElementById('terms');
        
        const togglePasswordBtn = document.getElementById('togglePassword');
        const toggleConfirmPasswordBtn = document.getElementById('toggleConfirmPassword');
        
        const strengthBlocks = [
            document.getElementById('strength-1'),
            document.getElementById('strength-2'),
            document.getElementById('strength-3')
        ];
        
        const matchFeedback = document.getElementById('matchFeedback');
        const roleFeedback = document.getElementById('roleFeedback');
        
        const submitBtn = document.getElementById('submitBtn');
        const googleBtn = document.getElementById('googleSignupBtn');
        const btnText = document.getElementById('btnText');
        const btnSpinner = document.getElementById('btnSpinner');
        const alertBox = document.getElementById('alertBox');
        
        const step1 = document.getElementById('step1');
        const step2 = document.getElementById('step2');
        const displayEmail = document.getElementById('displayEmail');
        const otpForm = document.getElementById('otpForm');
        const otpEl = document.getElementById('otp');
        const otpSubmitBtn = document.getElementById('otpSubmitBtn');
        const otpBtnText = document.getElementById('otpBtnText');
        const otpBtnSpinner = document.getElementById('otpBtnSpinner');
        const backToSignupBtn = document.getElementById('backToSignupBtn');
        
        let registeredEmail = '';

        // Alert Utility
        const showAlert = (message, type = 'error') => {
            alertBox.classList.remove('hidden', 'bg-red-50', 'text-red-800', 'border-red-200', 'bg-green-50', 'text-green-800', 'border-green-200');
            if (type === 'error') {
                alertBox.classList.add('bg-red-50', 'text-red-800', 'border-red-200');
            } else {
                alertBox.classList.add('bg-green-50', 'text-green-800', 'border-green-200');
            }
            alertBox.textContent = message;
        };

        // Loading State
        const setLoading = (isLoading) => {
            if (isLoading) {
                submitBtn.disabled = true;
                googleBtn.disabled = true;
                btnText.textContent = 'Please wait...';
                btnSpinner.classList.remove('hidden');
            } else {
                submitBtn.disabled = false;
                googleBtn.disabled = false;
                btnText.textContent = 'Create Account';
                btnSpinner.classList.add('hidden');
            }
        };

        const setOtpLoading = (isLoading) => {
            if (isLoading) {
                otpSubmitBtn.disabled = true;
                otpBtnText.textContent = 'Verifying...';
                otpBtnSpinner.classList.remove('hidden');
            } else {
                otpSubmitBtn.disabled = false;
                otpBtnText.textContent = 'Verify Code';
                otpBtnSpinner.classList.add('hidden');
            }
        };

        // Password Visibility Toggle
        const toggleVisibility = (inputEl, btnEl) => {
            const type = inputEl.getAttribute('type') === 'password' ? 'text' : 'password';
            inputEl.setAttribute('type', type);
            const icon = btnEl.querySelector('i');
            icon.classList.toggle('fa-eye');
            icon.classList.toggle('fa-eye-slash');
        };

        togglePasswordBtn.addEventListener('click', () => toggleVisibility(passwordEl, togglePasswordBtn));
        toggleConfirmPasswordBtn.addEventListener('click', () => toggleVisibility(confirmPasswordEl, toggleConfirmPasswordBtn));

        // Password Strength Indicator
        passwordEl.addEventListener('input', (e) => {
            const val = e.target.value;
            strengthBlocks.forEach(b => {
                b.classList.remove('strength-weak', 'strength-fair', 'strength-good');
            });
            
            if (val.length > 0 && val.length < 5) {
                strengthBlocks[0].classList.add('strength-weak');
            } else if (val.length >= 5 && val.length < 8) {
                strengthBlocks[0].classList.add('strength-fair');
                strengthBlocks[1].classList.add('strength-fair');
            } else if (val.length >= 8) {
                strengthBlocks[0].classList.add('strength-good');
                strengthBlocks[1].classList.add('strength-good');
                strengthBlocks[2].classList.add('strength-good');
            }
            checkPasswordMatch();
        });

        // Confirm Password Match Check
        const checkPasswordMatch = () => {
            if (confirmPasswordEl.value && passwordEl.value !== confirmPasswordEl.value) {
                matchFeedback.classList.remove('hidden');
                return false;
            } else {
                matchFeedback.classList.add('hidden');
                return true;
            }
        };
        confirmPasswordEl.addEventListener('input', checkPasswordMatch);

        // Role Info Message
        roleEl.addEventListener('change', (e) => {
            if (e.target.value === 'teacher') {
                roleFeedback.classList.remove('hidden');
            } else {
                roleFeedback.classList.add('hidden');
            }
        });

        // Form Submission (Email/Password)
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            alertBox.classList.add('hidden');
            
            // Client-side validations
            if (!checkPasswordMatch()) return;
            
            const name = nameEl.value.trim();
            const email = emailEl.value.trim();
            const password = passwordEl.value;
            const role = roleEl.value;

            if (!role) {
                showAlert('Please select a role to continue.');
                return;
            }

            if (!termsEl.checked) {
                showAlert('You must agree to the Terms of Service to create an account.');
                return;
            }

            setLoading(true);
            
            try {
                const response = await fetch('/api/auth/signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, password, role })
                });
                
                const data = await response.json();
                
                if (response.ok && data.success) {
                    if (data.requireOtp) {
                        registeredEmail = email;
                        displayEmail.textContent = email;
                        step1.classList.add('hidden');
                        step2.classList.remove('hidden');
                        showAlert(data.message, 'success');
                    } else {
                        window.location.href = data.redirect || '/';
                    }
                } else {
                    throw new Error(data.message || 'Failed to create account.');
                }
            } catch (error) {
                console.error(error);
                showAlert(error.message || 'An unexpected error occurred. Please try again.');
            } finally {
                setLoading(false);
            }
        });

        // Back to signup
        backToSignupBtn.addEventListener('click', () => {
            step2.classList.add('hidden');
            step1.classList.remove('hidden');
            alertBox.classList.add('hidden');
        });

        // OTP Verification Submission
        otpForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            alertBox.classList.add('hidden');
            
            const otp = otpEl.value.trim();
            if (!otp || otp.length !== 6) {
                showAlert('Please enter a valid 6-digit code.');
                return;
            }

            setOtpLoading(true);

            try {
                const response = await fetch('/api/auth/verify-signup-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: registeredEmail, otp })
                });
                
                const data = await response.json();
                
                if (response.ok && data.success) {
                    window.location.href = data.redirect || '/';
                } else {
                    throw new Error(data.message || 'Failed to verify OTP.');
                }
            } catch (error) {
                console.error(error);
                showAlert(error.message || 'Verification failed. Please try again.');
                setOtpLoading(false);
            }
        });

        // Google Signup
        googleBtn.addEventListener('click', async () => {
            alertBox.classList.add('hidden');
            
            const role = roleEl.value;
            if (!role) {
                showAlert('Please select your role from the dropdown above before continuing with Google.');
                roleEl.focus();
                return;
            }
            if (!termsEl.checked) {
                showAlert('Please agree to the Terms of Service before continuing with Google.');
                termsEl.focus();
                return;
            }

            setLoading(true);
            
            try {
                await setPersistence(auth, browserLocalPersistence);
                const userCredential = await signInWithPopup(auth, googleProvider);
                
                const idToken = await userCredential.user.getIdToken();
                const response = await fetch('/api/auth/googleLogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idToken, role })
                });
                
                const data = await response.json();
                
                if (response.ok && data.success) {
                    window.location.href = data.redirect || '/';
                } else {
                    throw new Error(data.message || 'Failed to register with Google.');
                }
            } catch (error) {
                console.error(error);
                setLoading(false);
                await auth.signOut();
                if (error.code !== 'auth/popup-closed-by-user') {
                    showAlert(error.message || 'An unexpected error occurred.');
                }
            }
        });
    </script>
    <%- include('../partials/language-modal') %>
</body>
</html>
