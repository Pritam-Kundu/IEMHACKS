<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - EduSmart</title>
    <meta name="description" content="Register for EduSmart to start your personalized learning journey.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Include Centralized Firebase Config -->
    <script src="/js/firebase-config.js"></script>
    
    <style>
        /* Minimal custom styling, primarily handled by Tailwind */
        .strength-weak { background-color: #ef4444 !important; }
        .strength-fair { background-color: #eab308 !important; }
        .strength-good { background-color: #22c55e !important; }
        input:focus + button { color: #4f46e5; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">
    
    <div class="min-h-screen flex flex-col md:flex-row">
        
        <!-- Left Side: Branding/Illustration (Hidden on mobile) -->
        <div class="hidden md:flex md:w-1/2 bg-indigo-600 text-white flex-col justify-center items-center p-12 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-500 to-indigo-800 opacity-90 z-0"></div>
            <div class="relative z-10 max-w-md text-center">
                <i class="fas fa-rocket text-6xl mb-6 shadow-sm"></i>
                <h1 class="text-4xl font-bold mb-4 tracking-tight">Join EduSmart</h1>
                <p class="text-lg text-indigo-100 mb-8 leading-relaxed">
                    Unlock your potential. Connect with expert teachers, track your progress, and achieve your educational goals in a personalized environment.
                </p>
                
                <div class="space-y-4 text-left bg-white/10 p-6 rounded-xl backdrop-blur-sm border border-white/20">
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-check-circle text-indigo-300 mt-1"></i>
                        <span><strong>Adaptive Learning</strong><br><span class="text-sm text-indigo-200">Courses tailored to your pace</span></span>
                    </div>
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-check-circle text-indigo-300 mt-1"></i>
                        <span><strong>AI Tutor Support</strong><br><span class="text-sm text-indigo-200">Instant explanations anytime</span></span>
                    </div>
                    <div class="flex items-start space-x-3">
                        <i class="fas fa-check-circle text-indigo-300 mt-1"></i>
                        <span><strong>Rich Analytics</strong><br><span class="text-sm text-indigo-200">Visualize your academic growth</span></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Signup Form -->
        <div class="w-full md:w-1/2 flex items-center justify-center p-6 sm:p-12 overflow-y-auto bg-gray-50">
            <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-100 p-8 sm:p-10 transform transition-all">
                
                <!-- Mobile Branding -->
                <div class="md:hidden text-center mb-6 text-indigo-600">
                    <i class="fas fa-rocket text-4xl"></i>
                    <h1 class="text-2xl font-bold mt-2 tracking-tight">EduSmart</h1>
                </div>

                <h2 class="text-3xl font-extrabold text-gray-900 mb-2">Create an Account</h2>
                <p class="text-gray-500 mb-6 text-sm">Join EduSmart and start learning today.</p>

                <!-- Alert Box -->
                <div id="alertBox" class="hidden mb-6 p-4 rounded-lg text-sm border font-medium" role="alert"></div>

                <form id="signupForm" class="space-y-4" novalidate>
                    <div class="flex space-x-4">
                        <div class="w-1/2">
                            <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                            <input type="text" id="firstName" name="firstName" required
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors"
                                placeholder="Jane">
                        </div>
                        <div class="w-1/2">
                            <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                            <input type="text" id="lastName" name="lastName" required
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors"
                                placeholder="Doe">
                        </div>
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-envelope text-gray-400"></i>
                            </div>
                            <input type="email" id="email" name="email" required
                                class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors"
                                placeholder="you@example.com">
                        </div>
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-lock text-gray-400"></i>
                            </div>
                            <input type="password" id="password" name="password" required minlength="8"
                                class="w-full pl-10 pr-10 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors"
                                placeholder="••••••••">
                            <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-indigo-600 focus:outline-none transition-colors" aria-label="Toggle password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        
                        <!-- Password Strength Indicator -->
                        <div class="mt-2 flex space-x-1 h-1.5 w-full bg-gray-100 rounded-full overflow-hidden">
                            <div class="h-full w-1/3 bg-gray-200 transition-all duration-300" id="strength-1"></div>
                            <div class="h-full w-1/3 bg-gray-200 transition-all duration-300" id="strength-2"></div>
                            <div class="h-full w-1/3 bg-gray-200 transition-all duration-300" id="strength-3"></div>
                        </div>
                        <p id="passwordFeedback" class="text-xs text-gray-500 mt-1">Must be at least 8 characters long.</p>
                    </div>

                    <div>
                        <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-lock text-gray-400"></i>
                            </div>
                            <input type="password" id="confirmPassword" name="confirmPassword" required
                                class="w-full pl-10 pr-10 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors"
                                placeholder="••••••••">
                            <button type="button" id="toggleConfirmPassword" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-indigo-600 focus:outline-none transition-colors" aria-label="Toggle confirm password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <p id="matchFeedback" class="text-xs text-red-500 mt-1 hidden font-medium">Passwords do not match.</p>
                    </div>

                    <div>
                        <label for="role" class="block text-sm font-medium text-gray-700 mb-1">I am a...</label>
                        <select id="role" name="role" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors bg-white appearance-none cursor-pointer">
                            <option value="" disabled selected>Select your role</option>
                            <option value="student">Student</option>
                            <option value="teacher">Teacher</option>
                            <option value="parent">Parent</option>
                        </select>
                        <p id="roleFeedback" class="text-xs text-indigo-600 mt-1 hidden font-medium">Note: Teacher accounts require admin approval.</p>
                    </div>

                    <div class="flex items-start mt-4">
                        <div class="flex items-center h-5">
                            <input id="terms" name="terms" type="checkbox" required class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded cursor-pointer">
                        </div>
                        <div class="ml-2 text-sm">
                            <label for="terms" class="text-gray-600 cursor-pointer">I agree to the <a href="#" class="text-indigo-600 hover:underline font-medium">Terms of Service</a> and <a href="#" class="text-indigo-600 hover:underline font-medium">Privacy Policy</a>.</label>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full flex justify-center py-3 px-4 mt-4 border border-transparent rounded-md shadow-md text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors disabled:opacity-70 disabled:cursor-not-allowed">
                        <span id="btnText">Create Account</span>
                        <i id="btnSpinner" class="fas fa-circle-notch fa-spin hidden ml-2 mt-0.5"></i>
                    </button>
                </form>

                <div class="mt-6">
                    <div class="relative">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-200"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="px-2 bg-white text-gray-500">Or sign up with</span>
                        </div>
                    </div>

                    <div class="mt-6">
                        <button type="button" id="googleSignupBtn" class="w-full inline-flex justify-center items-center py-2.5 px-4 border border-gray-300 rounded-md shadow-sm bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                            <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            Continue with Google
                        </button>
                    </div>
                </div>

                <p class="mt-8 text-center text-sm text-gray-600">
                    Already have an account? 
                    <a href="/login" class="font-bold text-indigo-600 hover:text-indigo-800 transition-colors">Login here</a>
                </p>
            </div>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
        import { 
            getAuth, 
            createUserWithEmailAndPassword, 
            signInWithPopup, 
            GoogleAuthProvider,
            setPersistence,
            browserLocalPersistence
        } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

        // Initialize Firebase
        const app = initializeApp(window.FIREBASE_CONFIG);
        const auth = getAuth(app);
        const googleProvider = new GoogleAuthProvider();

        // DOM Elements
        const form = document.getElementById('signupForm');
        const firstNameEl = document.getElementById('firstName');
        const lastNameEl = document.getElementById('lastName');
        const emailEl = document.getElementById('email');
        const passwordEl = document.getElementById('password');
        const confirmPasswordEl = document.getElementById('confirmPassword');
        const roleEl = document.getElementById('role');
        const termsEl = document.getElementById('terms');
        
        const togglePasswordBtn = document.getElementById('togglePassword');
        const toggleConfirmPasswordBtn = document.getElementById('toggleConfirmPassword');
        
        const strengthBlocks = [
            document.getElementById('strength-1'),
            document.getElementById('strength-2'),
            document.getElementById('strength-3')
        ];
        
        const matchFeedback = document.getElementById('matchFeedback');
        const roleFeedback = document.getElementById('roleFeedback');
        
        const submitBtn = document.getElementById('submitBtn');
        const googleBtn = document.getElementById('googleSignupBtn');
        const btnText = document.getElementById('btnText');
        const btnSpinner = document.getElementById('btnSpinner');
        const alertBox = document.getElementById('alertBox');

        // Alert Utility
        const showAlert = (message, type = 'error') => {
            alertBox.classList.remove('hidden', 'bg-red-50', 'text-red-800', 'border-red-200', 'bg-green-50', 'text-green-800', 'border-green-200');
            if (type === 'error') {
                alertBox.classList.add('bg-red-50', 'text-red-800', 'border-red-200');
            } else {
                alertBox.classList.add('bg-green-50', 'text-green-800', 'border-green-200');
            }
            alertBox.textContent = message;
        };

        // Loading State
        const setLoading = (isLoading) => {
            if (isLoading) {
                submitBtn.disabled = true;
                googleBtn.disabled = true;
                btnText.textContent = 'Creating Account...';
                btnSpinner.classList.remove('hidden');
            } else {
                submitBtn.disabled = false;
                googleBtn.disabled = false;
                btnText.textContent = 'Create Account';
                btnSpinner.classList.add('hidden');
            }
        };

        // Password Visibility Toggle
        const toggleVisibility = (inputEl, btnEl) => {
            const type = inputEl.getAttribute('type') === 'password' ? 'text' : 'password';
            inputEl.setAttribute('type', type);
            const icon = btnEl.querySelector('i');
            icon.classList.toggle('fa-eye');
            icon.classList.toggle('fa-eye-slash');
        };

        togglePasswordBtn.addEventListener('click', () => toggleVisibility(passwordEl, togglePasswordBtn));
        toggleConfirmPasswordBtn.addEventListener('click', () => toggleVisibility(confirmPasswordEl, toggleConfirmPasswordBtn));

        // Password Strength Indicator
        passwordEl.addEventListener('input', (e) => {
            const val = e.target.value;
            strengthBlocks.forEach(b => {
                b.classList.remove('strength-weak', 'strength-fair', 'strength-good');
            });
            
            if (val.length > 0 && val.length < 5) {
                strengthBlocks[0].classList.add('strength-weak');
            } else if (val.length >= 5 && val.length < 8) {
                strengthBlocks[0].classList.add('strength-fair');
                strengthBlocks[1].classList.add('strength-fair');
            } else if (val.length >= 8) {
                strengthBlocks[0].classList.add('strength-good');
                strengthBlocks[1].classList.add('strength-good');
                strengthBlocks[2].classList.add('strength-good');
            }
            checkPasswordMatch();
        });

        // Confirm Password Match Check
        const checkPasswordMatch = () => {
            if (confirmPasswordEl.value && passwordEl.value !== confirmPasswordEl.value) {
                matchFeedback.classList.remove('hidden');
                return false;
            } else {
                matchFeedback.classList.add('hidden');
                return true;
            }
        };
        confirmPasswordEl.addEventListener('input', checkPasswordMatch);

        // Role Info Message
        roleEl.addEventListener('change', (e) => {
            if (e.target.value === 'teacher') {
                roleFeedback.classList.remove('hidden');
            } else {
                roleFeedback.classList.add('hidden');
            }
        });

        // Backend Integration
        const establishBackendSession = async (user, firstName, lastName, role) => {
            try {
                const idToken = await user.getIdToken();
                const response = await fetch('/api/auth/sessionSignup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idToken, firstName, lastName, role })
                });
                
                const data = await response.json();
                
                if (response.ok && data.success) {
                    window.location.href = data.redirect;
                } else {
                    throw new Error(data.message || data.error || 'Failed to establish session.');
                }
            } catch (error) {
                // If backend fails, cleanup client session so they aren't stuck in a half-logged-in state
                await auth.signOut();
                throw error;
            }
        };

        const getAuthErrorMessage = (error) => {
            if (error.code) {
                const code = error.code;
                if (code === 'auth/email-already-in-use') return 'This email is already registered. Please log in instead.';
                if (code === 'auth/invalid-email') return 'Please enter a valid email address.';
                if (code === 'auth/weak-password') return 'Password must contain at least 8 characters.';
                if (code === 'auth/network-request-failed') return 'Network error. Please check your connection.';
            }
            return error.message || 'An unexpected error occurred. Please try again.';
        };

        // Form Submission (Email/Password)
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            alertBox.classList.add('hidden');
            
            // Client-side validations
            if (!checkPasswordMatch()) return;
            
            const firstName = firstNameEl.value.trim();
            const lastName = lastNameEl.value.trim();
            const email = emailEl.value.trim();
            const password = passwordEl.value;
            const role = roleEl.value;

            if (!role) {
                showAlert('Please select a role to continue.');
                return;
            }

            if (!termsEl.checked) {
                showAlert('You must agree to the Terms of Service to create an account.');
                return;
            }

            setLoading(true);
            
            try {
                await setPersistence(auth, browserLocalPersistence);
                const userCredential = await createUserWithEmailAndPassword(auth, email, password);
                
                await establishBackendSession(userCredential.user, firstName, lastName, role);
            } catch (error) {
                console.error(error);
                setLoading(false);
                showAlert(getAuthErrorMessage(error));
            }
        });

        // Google Signup
        googleBtn.addEventListener('click', async () => {
            alertBox.classList.add('hidden');
            
            const role = roleEl.value;
            if (!role) {
                showAlert('Please select your role from the dropdown above before continuing with Google.');
                roleEl.focus();
                return;
            }
            if (!termsEl.checked) {
                showAlert('Please agree to the Terms of Service before continuing with Google.');
                termsEl.focus();
                return;
            }

            setLoading(true);
            
            try {
                await setPersistence(auth, browserLocalPersistence);
                const userCredential = await signInWithPopup(auth, googleProvider);
                
                // For Google, we might not have first/last name explicitly split. Backend will handle extracting it from displayName.
                await establishBackendSession(userCredential.user, '', '', role);
            } catch (error) {
                console.error(error);
                setLoading(false);
                if (error.code !== 'auth/popup-closed-by-user') {
                    showAlert(getAuthErrorMessage(error));
                }
            }
        });
    </script>
</body>
</html>
