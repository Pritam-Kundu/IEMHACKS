<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <%- include('../partials/teacher-head', { title: typeof title !== 'undefined' ? title : 'EduSmart Teacher' }) %>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    

    <%- include('../partials/teacher-sidebar', { active: 'courses' }) %>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">
        
        <%- include('../partials/teacher-header', { active: 'courses' }) %>

        <!-- Page Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="flex items-center justify-between mb-6 animate-fade-in-up opacity-0">
                <h2 class="text-2xl font-bold text-slate-800">My Courses</h2>
                <a href="/teacher/courses/create" class="inline-flex items-center justify-center gap-2 bg-indigo-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fa-solid fa-plus"></i>
                    <span>Create Course</span>
                </a>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-md overflow-hidden animate-fade-in-up opacity-0 delay-100 card-hover">
                <% if (courses && courses.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                    <th class="p-4 font-semibold">Course</th>
                                    <th class="p-4 font-semibold">Students</th>
                                    <th class="p-4 font-semibold hidden md:table-cell">Lessons</th>
                                    <th class="p-4 font-semibold hidden sm:table-cell">Status</th>
                                    <th class="p-4 font-semibold text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-sm">
                                <% courses.forEach(course => { %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-lg bg-indigo-100 overflow-hidden shrink-0 hidden sm:block">
                                                    <img src="<%= course.thumbnail || '/images/default-course.png' %>" alt="" class="w-full h-full object-cover">
                                                </div>
                                                <div>
                                                    <p class="font-bold text-slate-800 truncate max-w-[200px]" title="<%= course.title %>"><%= course.title %></p>
                                                    <p class="text-xs text-slate-500"><%= course.category %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-4 text-slate-600">
                                            <div class="flex items-center gap-1.5">
                                                <i class="fa-regular fa-user text-slate-400"></i>
                                                <%= course.studentsCount || 0 %>
                                            </div>
                                        </td>
                                        <td class="p-4 text-slate-600 hidden md:table-cell">
                                            <%= course.lessonsCount || 0 %>
                                        </td>
                                        <td class="p-4 hidden sm:table-cell">
                                            <% if (course.isPublished) { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Published
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-600">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Draft
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="p-4 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <a href="/teacher/courses/<%= course._id %>" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="View Course">
                                                    <i class="fa-regular fa-eye"></i>
                                                </a>
                                                <a href="/teacher/courses/<%= course._id %>/edit" class="p-2 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="Edit Course">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>
                                                <button onclick="confirmDeleteCourse('<%= course._id %>')" class="p-2 text-slate-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Delete Course">
                                                    <i class="fa-regular fa-trash-can"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="p-8 text-center max-w-2xl mx-auto py-12">
                        <i class="fa-solid fa-book-open text-5xl text-slate-300 mb-4"></i>
                        <h3 class="text-lg font-bold text-slate-800 mb-2">No Courses Found</h3>
                        <p class="text-slate-500 mb-6">You haven't created any courses yet. Start building your first course now.</p>
                        <a href="/teacher/courses/create" class="inline-flex items-center justify-center gap-2 bg-indigo-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                            <i class="fa-solid fa-plus"></i>
                            <span>Create Your First Course</span>
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="fixed inset-0 bg-slate-900/50 z-50 hidden items-center justify-center opacity-0 transition-opacity">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 overflow-hidden transform scale-95 transition-transform duration-300">
            <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center text-red-600 shrink-0">
                        <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-800">Delete Course?</h3>
                        <p class="text-sm text-slate-500 mt-1">This action cannot be undone. All associated content will be permanently deleted.</p>
                    </div>
                </div>
                <!-- Error Alert inside modal -->
                <div id="deleteErrorAlert" class="hidden bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-lg text-sm font-medium flex items-start gap-3 mb-4">
                    <i class="fa-solid fa-circle-exclamation mt-0.5"></i>
                    <span id="deleteErrorMessage">Error deleting course.</span>
                </div>
                <div class="flex items-center justify-end gap-3 mt-6">
                    <button id="cancelDeleteBtn" class="px-4 py-2 text-slate-600 font-medium hover:bg-slate-100 rounded-lg transition-colors">Cancel</button>
                    <button id="confirmDeleteBtn" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition-colors flex items-center gap-2">
                        <span>Delete</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Page Specific Scripts -->
    <script>
        let courseToDelete = null;

        function confirmDeleteCourse(courseId) {
            courseToDelete = courseId;
            const modal = document.getElementById('deleteModal');
            document.getElementById('deleteErrorAlert').classList.add('hidden');
            
            modal.classList.remove('hidden');
            // small delay to allow display block to apply before animating opacity
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.querySelector('div').classList.remove('scale-95');
            }, 10);
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            // Delete Modal Logic
            const modal = document.getElementById('deleteModal');
            const cancelBtn = document.getElementById('cancelDeleteBtn');
            const confirmBtn = document.getElementById('confirmDeleteBtn');

            const closeModal = () => {
                modal.classList.add('opacity-0');
                modal.querySelector('div').classList.add('scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                    courseToDelete = null;
                }, 300);
            };

            cancelBtn.addEventListener('click', closeModal);
            
            // Close on click outside
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });

            confirmBtn.addEventListener('click', async () => {
                if (!courseToDelete) return;

                const originalText = confirmBtn.innerHTML;
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Deleting...';
                document.getElementById('deleteErrorAlert').classList.add('hidden');

                try {
                    const response = await fetch(`/teacher/courses/${courseToDelete}`, {
                        method: 'DELETE'
                    });
                    
                    const result = await response.json();

                    if (response.ok && result.success) {
                        window.location.reload();
                    } else {
                        document.getElementById('deleteErrorMessage').textContent = result.message || 'Failed to delete course.';
                        document.getElementById('deleteErrorAlert').classList.remove('hidden');
                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = originalText;
                    }
                } catch (error) {
                    document.getElementById('deleteErrorMessage').textContent = 'A network error occurred.';
                    document.getElementById('deleteErrorAlert').classList.remove('hidden');
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = originalText;
                }
            });
        });
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>
</html>
