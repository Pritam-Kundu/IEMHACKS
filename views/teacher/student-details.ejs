<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .sidebar-active { 
            background-color: #e0e7ff; 
            color: #4f46e5; 
            font-weight: 600; 
            border-right: 4px solid #4f46e5; 
        }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { 
            background-color: #f1f5f9; 
            color: #334155; 
        }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-xl">E</div>
                <span class="text-xl font-bold text-slate-900">EduSmart <span class="text-xs text-indigo-600 ml-1 font-semibold uppercase">Teacher</span></span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/teacher/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-layer-group w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/teacher/courses" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                <span>My Courses</span>
            </a>
            <a href="/teacher/students" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-users w-5 text-center"></i>
                <span>Students</span>
            </a>
            <a href="/teacher/lessons" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chalkboard-user w-5 text-center"></i>
                <span>Lessons</span>
            </a>
            <a href="/teacher/quizzes" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-clipboard-question w-5 text-center"></i>
                <span>Quizzes</span>
            </a>
            <a href="/teacher/assignments" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-file-pen w-5 text-center"></i>
                <span>Assignments</span>
            </a>
            <a href="/teacher/ai-tutor" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-robot w-5 text-center"></i>
                <span>AI Tutor</span>
            </a>
            <a href="/teacher/analytics" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-pie w-5 text-center"></i>
                <span>Analytics</span>
            </a>
            <a href="/teacher/reports" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-regular fa-file-lines w-5 text-center"></i>
                <span>Reports</span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/teacher/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        
        <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <div class="flex items-center text-sm font-medium text-slate-500">
                        <a href="/teacher/students" class="hover:text-indigo-600 transition-colors">Students</a>
                        <i class="fa-solid fa-chevron-right text-xs mx-2"></i>
                        <span class="text-slate-800 font-semibold"><%= student.name %></span>
                    </div>
                </div>
                
                <div class="flex items-center gap-5">
                    <div class="relative group mr-2">
                        <button class="inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors gap-1">
                            <i class="fa-solid fa-globe text-xl"></i>
                            <%= locals.language === 'bn' ? 'বাংলা' : 'English' %>
                        </button>
                        <div class="absolute right-0 mt-0 w-32 bg-white border border-slate-200 rounded-md shadow-lg hidden group-hover:block z-50 overflow-hidden">
                            <button onclick="changeLanguageImmediately('en')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'en' ? 'font-bold' : '' %>">English</button>
                            <button onclick="changeLanguageImmediately('bn')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'bn' ? 'font-bold' : '' %>">বাংলা</button>
                        </div>
                    </div>

                    <%- include('../partials/teacher-header-controls') %>
                </div>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="flex items-center justify-between mb-8">
                <div class="flex items-center gap-4">
                    <img src="<%= student.profilePicture || '/images/default-avatar.png' %>" alt="Profile Picture" class="w-20 h-20 rounded-full border-4 border-white shadow-sm object-cover bg-slate-100">
                    <div>
                        <h2 class="text-3xl font-bold text-slate-800"><%= student.name %></h2>
                        <p class="text-slate-500 mt-1"><i class="fa-regular fa-envelope mr-1"></i> <%= student.email %></p>
                    </div>
                </div>
                <div class="text-right hidden sm:block">
                    <p class="text-sm text-slate-500 mb-1">Average Progress</p>
                    <div class="flex items-center justify-end gap-3">
                        <div class="w-32 h-2.5 bg-slate-200 rounded-full overflow-hidden">
                            <div class="h-full bg-indigo-500" style="width: <%= avgProgress %>%"></div>
                        </div>
                        <span class="text-lg font-bold text-slate-800"><%= avgProgress %>%</span>
                    </div>
                </div>
            </div>

            <!-- Dashboard Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Main Content Area -->
                <div class="lg:col-span-2 space-y-6">
                    
                    <!-- Enrolled Courses -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                        <h3 class="text-lg font-bold text-slate-800 mb-4 border-b border-slate-100 pb-2">Enrolled Courses</h3>
                        <% if (enrollments.length > 0) { %>
                            <div class="space-y-4">
                                <% enrollments.forEach(e => { %>
                                    <div class="flex items-center p-4 border border-slate-100 rounded-lg hover:border-indigo-100 transition-colors">
                                        <img src="<%= e.course.thumbnail || '/images/default-course.png' %>" class="w-16 h-12 object-cover rounded mr-4 bg-slate-100" alt="Course Thumbnail">
                                        <div class="flex-1">
                                            <h4 class="font-semibold text-slate-800 text-sm"><%= e.course.title %></h4>
                                            <div class="flex items-center mt-2 gap-2">
                                                <div class="flex-1 h-1.5 bg-slate-200 rounded-full overflow-hidden">
                                                    <div class="h-full bg-emerald-500" style="width: <%= e.progress %>%"></div>
                                                </div>
                                                <span class="text-xs font-semibold text-slate-500"><%= e.progress %>%</span>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-slate-500 text-sm italic">Not enrolled in any courses.</p>
                        <% } %>
                    </div>

                    <!-- Recent Activity -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                        <h3 class="text-lg font-bold text-slate-800 mb-4 border-b border-slate-100 pb-2">Recent Activity</h3>
                        <% if (activities && activities.length > 0) { %>
                            <ul class="space-y-4">
                                <% activities.forEach(act => { %>
                                    <li class="flex gap-4">
                                        <% if (act.type === 'quiz') { %>
                                            <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 shrink-0">
                                                <i class="fa-solid fa-clipboard-question"></i>
                                            </div>
                                            <div class="flex-1 border-b border-slate-100 pb-4">
                                                <p class="text-sm text-slate-800"><span class="font-semibold"><%= student.name %></span> completed the quiz <span class="font-semibold"><%= act.title %></span>.</p>
                                                <div class="flex items-center justify-between mt-1">
                                                    <span class="text-xs text-slate-500"><%= act.courseTitle %></span>
                                                    <span class="text-xs font-bold <%= act.score >= 50 ? 'text-emerald-600' : 'text-red-600' %>">Score: <%= act.score %>%</span>
                                                </div>
                                            </div>
                                        <% } else if (act.type === 'assignment') { %>
                                            <div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center text-purple-600 shrink-0">
                                                <i class="fa-solid fa-file-arrow-up"></i>
                                            </div>
                                            <div class="flex-1 border-b border-slate-100 pb-4">
                                                <p class="text-sm text-slate-800"><span class="font-semibold"><%= student.name %></span> submitted the assignment <span class="font-semibold"><%= act.title %></span>.</p>
                                                <div class="flex items-center justify-between mt-1">
                                                    <span class="text-xs text-slate-500"><%= act.courseTitle %></span>
                                                    <span class="text-xs font-semibold px-2 py-0.5 rounded-full <%= act.status === 'graded' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %> capitalize"><%= act.status %></span>
                                                </div>
                                            </div>
                                        <% } %>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p class="text-slate-500 text-sm text-center py-4">No recent activity found.</p>
                        <% } %>
                    </div>
                </div>

                <!-- Right Sidebar -->
                <div class="space-y-6">
                    <!-- Statistics -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                        <h3 class="text-lg font-bold text-slate-800 mb-4 border-b border-slate-100 pb-2">Overview</h3>
                        
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-md bg-indigo-100 text-indigo-600 flex items-center justify-center">
                                        <i class="fa-solid fa-book"></i>
                                    </div>
                                    <span class="text-sm font-medium text-slate-700">Enrolled Courses</span>
                                </div>
                                <span class="text-lg font-bold text-slate-800"><%= enrollments.length %></span>
                            </div>
                            
                            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-md bg-emerald-100 text-emerald-600 flex items-center justify-center">
                                        <i class="fa-solid fa-check-double"></i>
                                    </div>
                                    <span class="text-sm font-medium text-slate-700">Quizzes Taken</span>
                                </div>
                                <span class="text-lg font-bold text-slate-800"><%= quizAttempts.length %></span>
                            </div>

                            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-md bg-amber-100 text-amber-600 flex items-center justify-center">
                                        <i class="fa-solid fa-file-lines"></i>
                                    </div>
                                    <span class="text-sm font-medium text-slate-700">Assignments</span>
                                </div>
                                <span class="text-lg font-bold text-slate-800"><%= submissions.length %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);
        });
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>
</html>
