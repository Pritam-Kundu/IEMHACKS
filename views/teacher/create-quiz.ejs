<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <%- include('../partials/teacher-head', { title: typeof title !== 'undefined' ? title : 'EduSmart Teacher' }) %>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    

    <%- include('../partials/teacher-sidebar', { active: 'create-quiz' }) %>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">
        
        <%- include('../partials/teacher-header', { active: 'create-quiz' }) %>

        <!-- Dashboard Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            
            <div class="max-w-4xl mx-auto">
                <div class="bg-white rounded-2xl shadow-md border border-slate-200 overflow-hidden animate-fade-in-up opacity-0 delay-100 card-hover">
                    <div class="p-6 sm:p-8 border-b border-slate-200 bg-slate-50">
                        <h2 class="text-2xl font-bold text-slate-800">Create New Quiz</h2>
                        <p class="text-slate-500 mt-1">Design an assessment to test your students' knowledge.</p>
                    </div>
                    
                    <div class="p-6 sm:p-8">
                        <form id="createQuizForm" class="space-y-6">
                            <!-- Error Alert -->
                            <div id="errorAlert" class="hidden bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-lg text-sm font-medium flex items-start gap-3">
                                <i class="fa-solid fa-circle-exclamation mt-0.5"></i>
                                <span id="errorMessage">Please check your inputs.</span>
                            </div>

                            <!-- Success Alert -->
                            <div id="successAlert" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-600 px-4 py-3 rounded-lg text-sm font-medium flex items-start gap-3">
                                <i class="fa-solid fa-circle-check mt-0.5"></i>
                                <span id="successMessage">Quiz created successfully! Redirecting...</span>
                            </div>

                            <div class="space-y-4">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <!-- Course -->
                                    <div>
                                        <label for="course" class="block text-sm font-semibold text-slate-700 mb-1">Select Course <span class="text-red-500">*</span></label>
                                        <select id="course" name="course" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800 bg-white">
                                            <option value="" disabled selected>Choose a course</option>
                                            <% if (courses && courses.length > 0) { %>
                                                <% courses.forEach(c => { %>
                                                    <option value="<%= c._id %>"><%= c.title %></option>
                                                <% }) %>
                                            <% } else { %>
                                                <option value="" disabled>No courses available</option>
                                            <% } %>
                                        </select>
                                    </div>
                                    <!-- Lesson -->
                                    <div>
                                        <label for="lesson" class="block text-sm font-semibold text-slate-700 mb-1">Select Lesson <span class="text-red-500">*</span></label>
                                        <select id="lesson" name="lesson" required disabled class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800 bg-slate-50 cursor-not-allowed">
                                            <option value="" disabled selected>Select a course first</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Title -->
                                <div>
                                    <label for="title" class="block text-sm font-semibold text-slate-700 mb-1">Quiz Title <span class="text-red-500">*</span></label>
                                    <input type="text" id="title" name="title" required placeholder="e.g. End of Chapter 1 Quiz" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800">
                                </div>

                                <!-- Description -->
                                <div>
                                    <label for="description" class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
                                    <textarea id="description" name="description" rows="2" placeholder="Briefly describe what this quiz covers..." class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800"></textarea>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <!-- Passing Score -->
                                    <div>
                                        <label for="passingScore" class="block text-sm font-semibold text-slate-700 mb-1">Passing Score (%) <span class="text-red-500">*</span></label>
                                        <input type="number" id="passingScore" name="passingScore" min="1" max="100" value="60" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800">
                                    </div>
                                    <!-- Time Limit -->
                                    <div>
                                        <label for="timeLimitMinutes" class="block text-sm font-semibold text-slate-700 mb-1">Time Limit (Minutes)</label>
                                        <input type="number" id="timeLimitMinutes" name="timeLimitMinutes" min="0" value="0" placeholder="0 for unlimited" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800">
                                        <p class="text-xs text-slate-500 mt-1">Leave as 0 for no time limit.</p>
                                    </div>
                                </div>
                            </div>
                            
                            <hr class="border-slate-200 my-6">
                            
                            <!-- Action Buttons -->
                            <div class="flex items-center justify-end gap-3 pt-2">
                                <a href="/teacher/quizzes" class="px-5 py-2.5 rounded-lg text-slate-600 font-semibold hover:bg-slate-100 transition-colors">Cancel</a>
                                <button type="submit" id="submitBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-lg font-semibold shadow-sm transition-colors flex items-center justify-center min-w-[140px]">
                                    <span>Create Quiz</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            
        </div>
    </main>

    <!-- Page Specific Scripts -->
    <script>
        // Inject lessons data from the server
        const allLessons = <%- JSON.stringify(lessons || []) %>;

        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            // Dynamic Lesson Select based on Course
            const courseSelect = document.getElementById('course');
            const lessonSelect = document.getElementById('lesson');

            courseSelect.addEventListener('change', (e) => {
                const selectedCourseId = e.target.value;
                const filteredLessons = allLessons.filter(lesson => lesson.course === selectedCourseId);
                
                lessonSelect.innerHTML = '<option value="" disabled selected>Choose a lesson</option>';
                
                if (filteredLessons.length > 0) {
                    filteredLessons.forEach(lesson => {
                        const option = document.createElement('option');
                        option.value = lesson._id;
                        option.textContent = lesson.title;
                        lessonSelect.appendChild(option);
                    });
                    lessonSelect.disabled = false;
                    lessonSelect.classList.remove('bg-slate-50', 'cursor-not-allowed');
                } else {
                    lessonSelect.innerHTML = '<option value="" disabled selected>No lessons found</option>';
                    lessonSelect.disabled = true;
                    lessonSelect.classList.add('bg-slate-50', 'cursor-not-allowed');
                }
            });

            // Form Submission Logic
            const form = document.getElementById('createQuizForm');
            const submitBtn = document.getElementById('submitBtn');
            const errorAlert = document.getElementById('errorAlert');
            const errorMessage = document.getElementById('errorMessage');
            const successAlert = document.getElementById('successAlert');

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                // Reset alerts
                errorAlert.classList.add('hidden');
                successAlert.classList.add('hidden');
                
                // Get form data
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());
                
                // Client-side validation
                if (!data.title.trim() || !data.course || !data.lesson) {
                    errorMessage.textContent = 'Please fill in all required fields.';
                    errorAlert.classList.remove('hidden');
                    return;
                }

                // Loading state
                const originalBtnText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Creating...';

                try {
                    const response = await fetch('/teacher/quizzes', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        successAlert.classList.remove('hidden');
                        // Redirect after brief delay (to edit page to add questions!)
                        setTimeout(() => {
                            window.location.href = `/teacher/quizzes/${result.quiz._id}/edit`;
                        }, 1000);
                    } else {
                        errorMessage.textContent = result.message || 'Failed to create quiz. Please try again.';
                        errorAlert.classList.remove('hidden');
                        
                        // Re-enable button
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                        submitBtn.innerHTML = originalBtnText;
                    }
                } catch (error) {
                    console.error('Create quiz error:', error);
                    errorMessage.textContent = 'A network error occurred. Please try again.';
                    errorAlert.classList.remove('hidden');
                    
                    // Re-enable button
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                    submitBtn.innerHTML = originalBtnText;
                }
            });
        });
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>
</html>
