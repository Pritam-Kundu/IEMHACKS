<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <%- include('../partials/teacher-head', { title: typeof title !== 'undefined' ? title : 'EduSmart Teacher' }) %>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    

    <%- include('../partials/teacher-sidebar', { active: 'reports' }) %>

    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">
        <%- include('../partials/teacher-header', { active: 'reports' }) %>

        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800">Student Progress Report</h2>
                    <p class="text-slate-500 mt-1">Detailed performance tracking for all your active students.</p>
                </div>
                <button onclick="exportTableToCSV('EduSmart_Pro_Report.csv')" class="inline-flex items-center justify-center gap-2 bg-slate-800 text-white font-semibold px-4 py-2 rounded-lg hover:bg-slate-900 transition-colors shadow-sm whitespace-nowrap">
                    <i class="fa-solid fa-file-csv text-emerald-400"></i>
                    <span>Export CSV</span>
                </button>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-md overflow-hidden animate-fade-in-up opacity-0 delay-100 card-hover">
                <% if (reportData && reportData.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse" id="reportsTable">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                    <th class="p-4 font-semibold">Student Name</th>
                                    <th class="p-4 font-semibold">Course</th>
                                    <th class="p-4 font-semibold">Course Progress</th>
                                    <th class="p-4 font-semibold">Assignments Done</th>
                                    <th class="p-4 font-semibold text-right">Avg Score</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-sm">
                                <% reportData.forEach(row => { %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-4">
                                            <p class="font-bold text-slate-800"><%= row.studentName %></p>
                                            <p class="text-xs text-slate-500"><%= row.studentEmail %></p>
                                        </td>
                                        <td class="p-4 text-slate-600 font-medium">
                                            <%= row.courseName %>
                                        </td>
                                        <td class="p-4">
                                            <div class="flex items-center gap-2">
                                                <div class="w-full bg-slate-200 rounded-full h-2 max-w-[100px]">
                                                    <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= row.progress %>%"></div>
                                                </div>
                                                <span class="text-xs font-semibold text-slate-700 w-8 text-right"><%= row.progress %>%</span>
                                            </div>
                                        </td>
                                        <td class="p-4 text-slate-600">
                                            <%= row.assignmentsCompleted %> / <%= row.totalAssignments %>
                                        </td>
                                        <td class="p-4 text-right">
                                            <span class="inline-flex items-center justify-center px-2.5 py-1 rounded-full text-xs font-bold <%= row.assignmentScore >= 80 ? 'bg-green-100 text-green-700' : (row.assignmentScore >= 60 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700') %>">
                                                <%= row.assignmentScore %>%
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="p-12 text-center max-w-lg mx-auto">
                        <i class="fa-regular fa-folder-open text-5xl text-slate-300 mb-4"></i>
                        <h3 class="text-lg font-bold text-slate-800 mb-2">No Data Available</h3>
                        <p class="text-slate-500">You don't have any enrolled students yet. Reports will appear here once students join your courses and start completing assignments.</p>
                    </div>
                <% } %>
            </div>

        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                sidebar.classList.toggle('-translate-x-full');
                sidebarOverlay.classList.toggle('hidden');
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);
        });

        // Simple CSV Export function
        function exportTableToCSV(filename) {
            const table = document.getElementById("reportsTable");
            if(!table) return;

            let csv = [];
            const rows = table.querySelectorAll("tr");
            
            for (let i = 0; i < rows.length; i++) {
                let row = [], cols = rows[i].querySelectorAll("td, th");
                
                for (let j = 0; j < cols.length; j++) {
                    // Extract text content and clean it up (remove newlines and multiple spaces)
                    let text = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").replace(/\s+/g, " ").trim();
                    row.push('"' + text + '"');
                }
                csv.push(row.join(","));
            }
            
            const csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
            const downloadLink = document.createElement("a");
            downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>
</html>
