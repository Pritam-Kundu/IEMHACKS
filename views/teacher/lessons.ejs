<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <%- include('../partials/teacher-head', { title: typeof title !== 'undefined' ? title : 'EduSmart Teacher' }) %>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    

    <%- include('../partials/teacher-sidebar', { active: 'lessons' }) %>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">
        
        <%- include('../partials/teacher-header', { active: 'lessons' }) %>

        <!-- Page Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="flex items-center justify-between mb-6 animate-fade-in-up opacity-0">
                <h2 class="text-2xl font-bold text-slate-800">Lessons</h2>
                <a href="/teacher/lessons/create" class="inline-flex items-center justify-center gap-2 bg-indigo-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                    <i class="fa-solid fa-plus"></i>
                    <span>Create Lesson</span>
                </a>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-md overflow-hidden animate-fade-in-up opacity-0 delay-100 card-hover">
                <% if (lessons && lessons.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                    <th class="p-4 font-semibold">Lesson Title</th>
                                    <th class="p-4 font-semibold hidden sm:table-cell">Course</th>
                                    <th class="p-4 font-semibold">Duration / Type</th>
                                    <th class="p-4 font-semibold text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-sm">
                                <% lessons.forEach(lesson => { %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500 hidden sm:flex">
                                                    <span class="text-xs font-bold"><%= lesson.order || '-' %></span>
                                                </div>
                                                <div>
                                                    <a href="/lessons/<%= lesson._id %>" class="font-bold text-slate-800 hover:text-indigo-600 transition-colors block"><%= lesson.title %></a>
                                                    <p class="text-xs text-slate-500 sm:hidden"><%= lesson.course ? lesson.course.title : 'Unassigned' %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-4 text-slate-600 hidden sm:table-cell">
                                            <%= lesson.course ? lesson.course.title : 'N/A' %>
                                        </td>
                                        <td class="p-4 text-slate-600">
                                            <div class="flex flex-col gap-1 text-xs">
                                                <span class="inline-flex items-center gap-1">
                                                    <% if (lesson.type === 'video') { %>
                                                        <i class="fa-solid fa-video text-blue-400"></i> Video
                                                    <% } else if (lesson.type === 'document') { %>
                                                        <i class="fa-solid fa-file-pdf text-red-400"></i> Document
                                                    <% } else { %>
                                                        <i class="fa-solid fa-file-lines text-slate-400"></i> <%= lesson.type || 'Text' %>
                                                    <% } %>
                                                </span>
                                                <% if (lesson.duration) { %>
                                                    <span class="inline-flex items-center gap-1"><i class="fa-regular fa-clock text-slate-400"></i> <%= lesson.duration %></span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td class="p-4 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <a href="/teacher/lessons/<%= lesson._id %>/edit" class="w-8 h-8 rounded bg-slate-100 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 flex items-center justify-center transition-colors" title="Edit">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                                <button onclick="openDeleteModal('<%= lesson._id %>')" class="w-8 h-8 rounded bg-slate-100 text-slate-500 hover:text-red-600 hover:bg-red-50 flex items-center justify-center transition-colors" title="Delete">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="p-8 text-center max-w-2xl mx-auto py-12">
                        <i class="fa-solid fa-chalkboard-user text-5xl text-slate-300 mb-4"></i>
                        <h3 class="text-lg font-bold text-slate-800 mb-2">No Lessons Found</h3>
                        <p class="text-slate-500 mb-6">You haven't created any lessons for your courses yet.</p>
                        <a href="/teacher/lessons/create" class="inline-flex items-center justify-center gap-2 bg-indigo-600 text-white font-semibold px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                            <i class="fa-solid fa-plus"></i>
                            <span>Create Your First Lesson</span>
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="fixed inset-0 bg-slate-900/50 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6">
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-red-100 text-red-600 mb-4 mx-auto">
                <i class="fa-solid fa-triangle-exclamation text-xl"></i>
            </div>
            <h3 class="text-lg font-bold text-center text-slate-800 mb-2">Delete Lesson</h3>
            <p class="text-slate-500 text-center text-sm mb-6">Are you sure you want to delete this lesson? This action cannot be undone.</p>
            <div class="flex gap-3">
                <button onclick="closeDeleteModal()" class="flex-1 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg transition-colors">Cancel</button>
                <button id="confirmDeleteBtn" class="flex-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition-colors flex items-center justify-center gap-2">
                    <span>Delete</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);
        });

        // Delete Modal Logic
        const deleteModal = document.getElementById('deleteModal');
        let lessonIdToDelete = null;

        function openDeleteModal(id) {
            lessonIdToDelete = id;
            deleteModal.classList.remove('hidden');
        }

        function closeDeleteModal() {
            lessonIdToDelete = null;
            deleteModal.classList.add('hidden');
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
            if (!lessonIdToDelete) return;
            
            try {
                const response = await fetch(`/teacher/lessons/${lessonIdToDelete}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                const data = await response.json();
                
                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.message || 'Failed to delete lesson');
                    closeDeleteModal();
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred. Please try again.');
                closeDeleteModal();
            }
        });
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>
</html>
