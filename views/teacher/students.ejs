<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <%- include('../partials/teacher-head', { title: typeof title !== 'undefined' ? title : 'EduSmart Teacher' }) %>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    

    <%- include('../partials/teacher-sidebar', { active: 'students' }) %>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">
        
        <%- include('../partials/teacher-header', { active: 'students' }) %>

        <!-- Page Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="flex items-center justify-between mb-6 animate-fade-in-up opacity-0">
                <h2 class="text-2xl font-bold text-slate-800">Students</h2>
            <form action="/teacher/students" method="GET" class="flex flex-col sm:flex-row items-center gap-3 mb-6 w-full sm:w-auto">
                <div class="relative w-full sm:w-64">
                    <i class="fa-solid fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="text" name="search" value="<%= searchQuery || '' %>" placeholder="Search students..." class="pl-10 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 w-full">
                </div>
                
                <div class="w-full sm:w-auto flex gap-3">
                    <select name="course" class="border border-slate-200 rounded-lg text-sm py-2 px-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                        <option value="">All Courses</option>
                        <% if (locals.courses) { %>
                            <% courses.forEach(c => { %>
                                <option value="<%= c._id %>" <%= filterCourseId === c._id.toString() ? 'selected' : '' %>><%= c.title %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    
                    <button type="submit" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-slate-200">
                        Filter
                    </button>
                    <% if (searchQuery || filterCourseId) { %>
                        <a href="/teacher/students" class="flex items-center justify-center text-slate-500 hover:text-red-500 px-2 py-2 transition-colors" title="Clear Filters">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    <% } %>
                </div>
            </form>
        </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-md overflow-hidden animate-fade-in-up opacity-0 delay-100 card-hover">
                <% if (students && students.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                    <th class="p-4 font-semibold">Student Name</th>
                                    <th class="p-4 font-semibold hidden md:table-cell">Enrolled Courses</th>
                                    <th class="p-4 font-semibold hidden sm:table-cell">Avg Progress</th>
                                    <th class="p-4 font-semibold text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-sm">
                                <% students.forEach(item => { %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-4">
                                            <div class="flex items-center gap-3">
                                                <img src="<%= item.student.profilePicture || '/images/default-avatar.png' %>" alt="" class="w-10 h-10 rounded-full object-cover bg-slate-100">
                                                <div>
                                                    <p class="font-bold text-slate-800"><%= item.student.name %></p>
                                                    <p class="text-xs text-slate-500"><%= item.student.email %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-4 text-slate-600 hidden md:table-cell">
                                            <div class="flex flex-wrap gap-1">
                                                <% item.courses.slice(0, 2).forEach(c => { %>
                                                    <span class="inline-flex bg-slate-100 text-slate-700 px-2 py-1 rounded text-xs"><%= c.courseTitle %></span>
                                                <% }) %>
                                                <% if (item.courses.length > 2) { %>
                                                    <span class="inline-flex bg-slate-100 text-slate-500 px-2 py-1 rounded text-xs">+<%= item.courses.length - 2 %></span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td class="p-4 hidden sm:table-cell">
                                            <div class="flex items-center gap-2">
                                                <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden max-w-[80px]">
                                                    <div class="h-full bg-indigo-500" style="width: <%= item.averageProgress %>%"></div>
                                                </div>
                                                <span class="text-xs font-semibold text-slate-600"><%= item.averageProgress %>%</span>
                                            </div>
                                        </td>
                                        <td class="p-4 text-right">
                                            <a href="/teacher/students/<%= item.student._id %>" class="text-indigo-600 hover:text-indigo-900 font-medium">View Profile</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="p-8 text-center max-w-2xl mx-auto py-12">
                        <i class="fa-solid fa-user-graduate text-5xl text-slate-300 mb-4"></i>
                        <h3 class="text-lg font-bold text-slate-800 mb-2">No Students Found</h3>
                        <p class="text-slate-500">You don't have any students enrolled in your courses yet.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);
        });
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>
</html>
