<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS (CDN for rapid hackathon setup) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Dashboard-specific custom styles */
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        /* Sidebar styling */
        .sidebar-active { 
            background-color: #e0e7ff; 
            color: #4f46e5; 
            font-weight: 600; 
            border-right: 4px solid #4f46e5; 
        }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { 
            background-color: #f1f5f9; 
            color: #334155; 
        }
        
        /* Utility */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-xl">E</div>
                <span class="text-xl font-bold text-slate-900">EduSmart <span class="text-xs text-indigo-600 ml-1 font-semibold uppercase">Teacher</span></span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/teacher/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-layer-group w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/teacher/courses" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                <span>My Courses</span>
            </a>
            <a href="/teacher/students" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-users w-5 text-center"></i>
                <span>Students</span>
            </a>
            <a href="/teacher/lessons" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chalkboard-user w-5 text-center"></i>
                <span>Lessons</span>
            </a>
            <a href="/teacher/quizzes" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-clipboard-question w-5 text-center"></i>
                <span>Quizzes</span>
            </a>
            <a href="/teacher/assignments" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-file-pen w-5 text-center"></i>
                <span>Assignments</span>
            </a>
            <a href="/teacher/ai-tutor" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-robot w-5 text-center"></i>
                <span>AI Tutor</span>
            </a>
            <a href="/teacher/analytics" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-pie w-5 text-center"></i>
                <span>Analytics</span>
            </a>
            <a href="/teacher/reports" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-regular fa-file-lines w-5 text-center"></i>
                <span>Reports</span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/teacher/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
            <!-- Using existing logout flow -->
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block mr-6">My Courses</h1>
                    
                    <!-- Global Links -->
                    <div class="hidden md:flex items-center space-x-6 border-l pl-6 border-slate-200">
                        <a href="/" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">Home</a>
                        <a href="/#features" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">Features</a>
                        <a href="/#how-it-works" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">How it Works</a>
                        <a href="/#about" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">About</a>
                    </div>
                </div>
                
                <div class="flex items-center gap-5">
                    
                    <!-- Language Switcher -->
                    <div class="relative group mr-2">
                        <button class="inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors gap-1">
                            <i class="fa-solid fa-globe text-xl"></i>
                            <%= locals.language === 'bn' ? 'বাংলা' : 'English' %>
                        </button>
                        <div class="absolute right-0 mt-0 w-32 bg-white border border-slate-200 rounded-md shadow-lg hidden group-hover:block z-50 overflow-hidden">
                            <button onclick="changeLanguageImmediately('en')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'en' ? 'font-bold' : '' %>">English</button>
                            <button onclick="changeLanguageImmediately('bn')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'bn' ? 'font-bold' : '' %>">বাংলা</button>
                        </div>
                    </div>

                    <%- include('../partials/teacher-header-controls') %>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800"><%= course.title %></h2>
                    <p class="text-slate-500 mt-1"><i class="fa-solid fa-layer-group mr-2"></i><%= course.subject ? course.subject.name : course.category %></p>
                </div>
                <div class="flex items-center gap-3">
                    <a href="/teacher/courses/<%= course._id %>/edit" class="inline-flex items-center justify-center gap-2 bg-white border border-slate-300 text-slate-700 font-medium px-4 py-2 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span>Edit Course</span>
                    </a>
                </div>
            </div>

            <!-- Course Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
                        <i class="fa-solid fa-users text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Students</p>
                        <p class="text-2xl font-bold text-slate-800"><%= enrollments ? enrollments.length : 0 %></p>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
                        <i class="fa-solid fa-chalkboard-user text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Lessons</p>
                        <p class="text-2xl font-bold text-slate-800"><%= lessons ? lessons.length : 0 %></p>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600 shrink-0">
                        <i class="fa-solid fa-clipboard-question text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Quizzes</p>
                        <p class="text-2xl font-bold text-slate-800"><%= quizzes ? quizzes.length : 0 %></p>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600 shrink-0">
                        <i class="fa-solid fa-file-pen text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Assignments</p>
                        <p class="text-2xl font-bold text-slate-800"><%= assignments ? assignments.length : 0 %></p>
                    </div>
                </div>
            </div>

            <!-- Content Tabs -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-8">
                <div class="border-b border-slate-200">
                    <nav class="flex -mb-px px-6" aria-label="Tabs">
                        <button class="tab-btn w-1/3 py-4 px-1 text-center border-b-2 border-indigo-500 text-indigo-600 font-medium text-sm" data-target="lessonsTab">
                            <i class="fa-solid fa-chalkboard-user mr-2"></i>Lessons
                        </button>
                        <button class="tab-btn w-1/3 py-4 px-1 text-center border-b-2 border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 font-medium text-sm transition-colors" data-target="quizzesTab">
                            <i class="fa-solid fa-clipboard-question mr-2"></i>Quizzes
                        </button>
                        <button class="tab-btn w-1/3 py-4 px-1 text-center border-b-2 border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 font-medium text-sm transition-colors" data-target="assignmentsTab">
                            <i class="fa-solid fa-file-pen mr-2"></i>Assignments
                        </button>
                    </nav>
                </div>

                <!-- Lessons Tab -->
                <div id="lessonsTab" class="tab-content p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-slate-800">Lessons</h3>
                        <a href="/teacher/lessons/create?course=<%= course._id %>" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center gap-1">
                            <i class="fa-solid fa-plus"></i> Add Lesson
                        </a>
                    </div>
                    <% if (lessons && lessons.length > 0) { %>
                        <div class="space-y-3">
                            <% lessons.forEach(lesson => { %>
                                <div class="flex items-center justify-between p-4 border border-slate-100 rounded-lg bg-slate-50">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-sm shrink-0">
                                            <%= lesson.order %>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-800"><%= lesson.title %></p>
                                            <p class="text-xs text-slate-500"><%= lesson.duration %> mins</p>
                                        </div>
                                    </div>
                                    <div>
                                        <a href="/teacher/lessons/<%= lesson._id %>/edit" class="text-slate-400 hover:text-indigo-600 p-2"><i class="fa-solid fa-pen"></i></a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 bg-slate-50 rounded-lg border border-dashed border-slate-300">
                            <p class="text-slate-500">No lessons created yet.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Quizzes Tab -->
                <div id="quizzesTab" class="tab-content p-6 hidden">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-slate-800">Quizzes</h3>
                        <a href="/teacher/quizzes/create?course=<%= course._id %>" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center gap-1">
                            <i class="fa-solid fa-plus"></i> Add Quiz
                        </a>
                    </div>
                    <% if (quizzes && quizzes.length > 0) { %>
                        <div class="space-y-3">
                            <% quizzes.forEach(quiz => { %>
                                <div class="flex items-center justify-between p-4 border border-slate-100 rounded-lg bg-slate-50">
                                    <div>
                                        <p class="font-bold text-slate-800"><%= quiz.title %></p>
                                        <p class="text-xs text-slate-500"><%= quiz.questions ? quiz.questions.length : 0 %> Questions • <%= quiz.timeLimit || 0 %> mins</p>
                                    </div>
                                    <div>
                                        <a href="/teacher/quizzes/<%= quiz._id %>" class="text-slate-400 hover:text-indigo-600 p-2"><i class="fa-solid fa-gear"></i> Manage</a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 bg-slate-50 rounded-lg border border-dashed border-slate-300">
                            <p class="text-slate-500">No quizzes created yet.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Assignments Tab -->
                <div id="assignmentsTab" class="tab-content p-6 hidden">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-slate-800">Assignments</h3>
                        <a href="/teacher/assignments/create?course=<%= course._id %>" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center gap-1">
                            <i class="fa-solid fa-plus"></i> Add Assignment
                        </a>
                    </div>
                    <% if (assignments && assignments.length > 0) { %>
                        <div class="space-y-3">
                            <% assignments.forEach(assignment => { %>
                                <div class="flex items-center justify-between p-4 border border-slate-100 rounded-lg bg-slate-50">
                                    <div>
                                        <p class="font-bold text-slate-800"><%= assignment.title %></p>
                                        <p class="text-xs text-slate-500">Due: <%= new Date(assignment.dueDate).toLocaleDateString() %> • <%= assignment.points %> pts</p>
                                    </div>
                                    <div>
                                        <a href="/teacher/assignments/<%= assignment._id %>" class="text-slate-400 hover:text-indigo-600 p-2"><i class="fa-solid fa-gear"></i> Manage</a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 bg-slate-50 rounded-lg border border-dashed border-slate-300">
                            <p class="text-slate-500">No assignments created yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Enrolled Students Section -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-8">
                <div class="p-6 border-b border-slate-200">
                    <h3 class="text-lg font-bold text-slate-800">Enrolled Students</h3>
                </div>
                
                <% if (enrollments && enrollments.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                    <th class="p-4 font-semibold">Student</th>
                                    <th class="p-4 font-semibold">Progress</th>
                                    <th class="p-4 font-semibold">Enrolled On</th>
                                    <th class="p-4 font-semibold text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-sm">
                                <% enrollments.forEach(enrollment => { %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-4">
                                            <div class="flex items-center gap-3">
                                                <img src="<%= enrollment.student.profilePicture || '/images/default-avatar.png' %>" alt="" class="w-8 h-8 rounded-full object-cover">
                                                <div>
                                                    <p class="font-bold text-slate-800"><%= enrollment.student.name %></p>
                                                    <p class="text-xs text-slate-500"><%= enrollment.student.email %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-4">
                                            <div class="flex items-center gap-2">
                                                <div class="w-full bg-slate-200 rounded-full h-2 max-w-[100px]">
                                                    <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= enrollment.progress || 0 %>%"></div>
                                                </div>
                                                <span class="text-xs font-medium text-slate-600"><%= enrollment.progress || 0 %>%</span>
                                            </div>
                                        </td>
                                        <td class="p-4 text-slate-600">
                                            <%= new Date(enrollment.enrolledAt).toLocaleDateString() %>
                                        </td>
                                        <td class="p-4 text-right">
                                            <a href="/teacher/students/<%= enrollment.student._id %>" class="text-indigo-600 hover:text-indigo-900 font-medium">View Progress</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="p-8 text-center">
                        <p class="text-slate-500">No students enrolled yet.</p>
                    </div>
                <% } %>
            </div>

        </div>
    </main>

    <!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            // Tab Navigation Logic
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabContents = document.querySelectorAll('.tab-content');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Reset all tabs
                    tabBtns.forEach(t => {
                        t.classList.remove('border-indigo-500', 'text-indigo-600');
                        t.classList.add('border-transparent', 'text-slate-500');
                    });
                    tabContents.forEach(c => c.classList.add('hidden'));

                    // Activate clicked tab
                    btn.classList.remove('border-transparent', 'text-slate-500');
                    btn.classList.add('border-indigo-500', 'text-indigo-600');
                    
                    const targetId = btn.getAttribute('data-target');
                    document.getElementById(targetId).classList.remove('hidden');
                });
            });
        });
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>
</html>
