<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <%- include('../partials/teacher-head', { title: typeof title !== 'undefined' ? title : 'EduSmart Teacher' }) %>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    

    <%- include('../partials/teacher-sidebar', { active: 'course-details' }) %>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">
        
        <%- include('../partials/teacher-header', { active: 'course-details' }) %>

        <!-- Page Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 animate-fade-in-up opacity-0">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800"><%= course.title %></h2>
                    <p class="text-slate-500 mt-1"><i class="fa-solid fa-layer-group mr-2"></i><%= course.subject ? course.subject.name : course.category %></p>
                </div>
                <div class="flex items-center gap-3">
                    <a href="/teacher/courses/<%= course._id %>/edit" class="inline-flex items-center justify-center gap-2 bg-white border border-slate-300 text-slate-700 font-medium px-4 py-2 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span>Edit Course</span>
                    </a>
                </div>
            </div>

            <!-- Course Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8 animate-fade-in-up opacity-0 delay-100">
                <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-md card-hover flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
                        <i class="fa-solid fa-users text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Students</p>
                        <p class="text-2xl font-bold text-slate-800"><%= enrollments ? enrollments.length : 0 %></p>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-md card-hover flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
                        <i class="fa-solid fa-chalkboard-user text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Lessons</p>
                        <p class="text-2xl font-bold text-slate-800"><%= lessons ? lessons.length : 0 %></p>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-md card-hover flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600 shrink-0">
                        <i class="fa-solid fa-clipboard-question text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Quizzes</p>
                        <p class="text-2xl font-bold text-slate-800"><%= quizzes ? quizzes.length : 0 %></p>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-md card-hover flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600 shrink-0">
                        <i class="fa-solid fa-file-pen text-xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">Assignments</p>
                        <p class="text-2xl font-bold text-slate-800"><%= assignments ? assignments.length : 0 %></p>
                    </div>
                </div>
            </div>

            <!-- Content Tabs -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-md overflow-hidden mb-8 animate-fade-in-up opacity-0 delay-200 card-hover">
                <div class="border-b border-slate-200">
                    <nav class="flex -mb-px px-6" aria-label="Tabs">
                        <button class="tab-btn w-1/3 py-4 px-1 text-center border-b-2 border-indigo-500 text-indigo-600 font-medium text-sm" data-target="lessonsTab">
                            <i class="fa-solid fa-chalkboard-user mr-2"></i>Lessons
                        </button>
                        <button class="tab-btn w-1/3 py-4 px-1 text-center border-b-2 border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 font-medium text-sm transition-colors" data-target="quizzesTab">
                            <i class="fa-solid fa-clipboard-question mr-2"></i>Quizzes
                        </button>
                        <button class="tab-btn w-1/3 py-4 px-1 text-center border-b-2 border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300 font-medium text-sm transition-colors" data-target="assignmentsTab">
                            <i class="fa-solid fa-file-pen mr-2"></i>Assignments
                        </button>
                    </nav>
                </div>

                <!-- Lessons Tab -->
                <div id="lessonsTab" class="tab-content p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-slate-800">Lessons</h3>
                        <a href="/teacher/lessons/create?course=<%= course._id %>" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center gap-1">
                            <i class="fa-solid fa-plus"></i> Add Lesson
                        </a>
                    </div>
                    <% if (lessons && lessons.length > 0) { %>
                        <div class="space-y-3">
                            <% lessons.forEach(lesson => { %>
                                <div class="flex items-center justify-between p-4 border border-slate-100 rounded-lg bg-slate-50">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-sm shrink-0">
                                            <%= lesson.order %>
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-800"><%= lesson.title %></p>
                                            <p class="text-xs text-slate-500"><%= lesson.duration %> mins</p>
                                        </div>
                                    </div>
                                    <div>
                                        <a href="/teacher/lessons/<%= lesson._id %>/edit" class="text-slate-400 hover:text-indigo-600 p-2"><i class="fa-solid fa-pen"></i></a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 bg-slate-50 rounded-lg border border-dashed border-slate-300">
                            <p class="text-slate-500">No lessons created yet.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Quizzes Tab -->
                <div id="quizzesTab" class="tab-content p-6 hidden">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-slate-800">Quizzes</h3>
                        <a href="/teacher/quizzes/create?course=<%= course._id %>" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center gap-1">
                            <i class="fa-solid fa-plus"></i> Add Quiz
                        </a>
                    </div>
                    <% if (quizzes && quizzes.length > 0) { %>
                        <div class="space-y-3">
                            <% quizzes.forEach(quiz => { %>
                                <div class="flex items-center justify-between p-4 border border-slate-100 rounded-lg bg-slate-50">
                                    <div>
                                        <p class="font-bold text-slate-800"><%= quiz.title %></p>
                                        <p class="text-xs text-slate-500"><%= quiz.questions ? quiz.questions.length : 0 %> Questions • <%= quiz.timeLimit || 0 %> mins</p>
                                    </div>
                                    <div>
                                        <a href="/teacher/quizzes/<%= quiz._id %>" class="text-slate-400 hover:text-indigo-600 p-2"><i class="fa-solid fa-gear"></i> Manage</a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 bg-slate-50 rounded-lg border border-dashed border-slate-300">
                            <p class="text-slate-500">No quizzes created yet.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Assignments Tab -->
                <div id="assignmentsTab" class="tab-content p-6 hidden">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-slate-800">Assignments</h3>
                        <a href="/teacher/assignments/create?course=<%= course._id %>" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center gap-1">
                            <i class="fa-solid fa-plus"></i> Add Assignment
                        </a>
                    </div>
                    <% if (assignments && assignments.length > 0) { %>
                        <div class="space-y-3">
                            <% assignments.forEach(assignment => { %>
                                <div class="flex items-center justify-between p-4 border border-slate-100 rounded-lg bg-slate-50">
                                    <div>
                                        <p class="font-bold text-slate-800"><%= assignment.title %></p>
                                        <p class="text-xs text-slate-500">Due: <%= new Date(assignment.dueDate).toLocaleDateString() %> • <%= assignment.points %> pts</p>
                                    </div>
                                    <div>
                                        <a href="/teacher/assignments/<%= assignment._id %>" class="text-slate-400 hover:text-indigo-600 p-2"><i class="fa-solid fa-gear"></i> Manage</a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-8 bg-slate-50 rounded-lg border border-dashed border-slate-300">
                            <p class="text-slate-500">No assignments created yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Enrolled Students Section -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-md overflow-hidden mb-8 animate-fade-in-up opacity-0 delay-200 card-hover">
                <div class="p-6 border-b border-slate-200">
                    <h3 class="text-lg font-bold text-slate-800">Enrolled Students</h3>
                </div>
                
                <% if (enrollments && enrollments.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                    <th class="p-4 font-semibold">Student</th>
                                    <th class="p-4 font-semibold">Progress</th>
                                    <th class="p-4 font-semibold">Enrolled On</th>
                                    <th class="p-4 font-semibold text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-sm">
                                <% enrollments.forEach(enrollment => { %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-4">
                                            <div class="flex items-center gap-3">
                                                <img src="<%= enrollment.student.profilePicture || '/images/default-avatar.png' %>" alt="" class="w-8 h-8 rounded-full object-cover">
                                                <div>
                                                    <p class="font-bold text-slate-800"><%= enrollment.student.name %></p>
                                                    <p class="text-xs text-slate-500"><%= enrollment.student.email %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-4">
                                            <div class="flex items-center gap-2">
                                                <div class="w-full bg-slate-200 rounded-full h-2 max-w-[100px]">
                                                    <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= enrollment.progress || 0 %>%"></div>
                                                </div>
                                                <span class="text-xs font-medium text-slate-600"><%= enrollment.progress || 0 %>%</span>
                                            </div>
                                        </td>
                                        <td class="p-4 text-slate-600">
                                            <%= new Date(enrollment.enrolledAt).toLocaleDateString() %>
                                        </td>
                                        <td class="p-4 text-right">
                                            <a href="/teacher/students/<%= enrollment.student._id %>" class="text-indigo-600 hover:text-indigo-900 font-medium">View Progress</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="p-8 text-center">
                        <p class="text-slate-500">No students enrolled yet.</p>
                    </div>
                <% } %>
            </div>

        </div>
    </main>

    <!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            // Tab Navigation Logic
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabContents = document.querySelectorAll('.tab-content');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Reset all tabs
                    tabBtns.forEach(t => {
                        t.classList.remove('border-indigo-500', 'text-indigo-600');
                        t.classList.add('border-transparent', 'text-slate-500');
                    });
                    tabContents.forEach(c => c.classList.add('hidden'));

                    // Activate clicked tab
                    btn.classList.remove('border-transparent', 'text-slate-500');
                    btn.classList.add('border-indigo-500', 'text-indigo-600');
                    
                    const targetId = btn.getAttribute('data-target');
                    document.getElementById(targetId).classList.remove('hidden');
                });
            });
        });
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>
</html>
