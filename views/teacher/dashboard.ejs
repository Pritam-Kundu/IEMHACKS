<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS (CDN for rapid hackathon setup) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Dashboard-specific custom styles */
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        /* Sidebar styling */
        .sidebar-active { 
            background-color: #e0e7ff; 
            color: #4f46e5; 
            font-weight: 600; 
            border-right: 4px solid #4f46e5; 
        }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { 
            background-color: #f1f5f9; 
            color: #334155; 
        }
        
        /* Utility */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/teacher/dashboard" class="flex items-center gap-2 text-indigo-600 hover:text-indigo-700 transition-colors">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
                <span class="font-mono text-xl font-bold tracking-tight text-slate-900">EduSmart <span class="font-sans text-xs text-indigo-600 ml-1 font-semibold uppercase tracking-normal">Pro</span></span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/teacher/dashboard" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-layer-group w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/teacher/courses" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                <span>My Courses</span>
            </a>
            <a href="/teacher/students" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-users w-5 text-center"></i>
                <span>Students</span>
            </a>
            <a href="/teacher/lessons" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chalkboard-user w-5 text-center"></i>
                <span>Lessons</span>
            </a>
            <a href="/teacher/quizzes" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-clipboard-question w-5 text-center"></i>
                <span>Quizzes</span>
            </a>
            <a href="/teacher/assignments" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-file-pen w-5 text-center"></i>
                <span>Assignments</span>
            </a>
            <a href="/teacher/analytics" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-pie w-5 text-center"></i>
                <span>Analytics</span>
            </a>
            <a href="/teacher/reports" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-regular fa-file-lines w-5 text-center"></i>
                <span>Reports</span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/teacher/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
            <!-- Using existing logout flow -->
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block mr-6">Dashboard</h1>
                    
                    <!-- Global Links -->
                    <div class="hidden md:flex items-center space-x-6 border-l pl-6 border-slate-200">
                        <a href="/" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">Home</a>
                        <a href="/#features" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">Features</a>
                        <a href="/#how-it-works" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">How it Works</a>
                        <a href="/#about" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">About</a>
                    </div>
                </div>
                
                <div class="flex items-center gap-5">
                    <button class="relative text-slate-500 hover:text-indigo-600 transition-colors focus:outline-none">
                        <i class="fa-regular fa-bell text-xl"></i>
                        <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    
                    <a href="/teacher/profile" class="flex items-center gap-3 cursor-pointer group">
                        <img src="<%= user.profilePicture || '/images/default-avatar.png' %>" alt="Profile" class="w-9 h-9 rounded-full object-cover border-2 border-indigo-100 group-hover:border-indigo-300 transition-colors">
                        <div class="hidden md:block">
                            <p class="text-sm font-semibold text-slate-800">Prof. <%= user.lastName %></p>
                            <p class="text-xs text-slate-500 capitalize"><%= user.role %></p>
                        </div>
                    </a>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            
            <!-- Welcome Hero Card -->
            <div class="bg-gradient-to-r from-slate-900 to-indigo-900 rounded-2xl p-6 sm:p-8 text-white shadow-lg mb-8 relative overflow-hidden">
                <!-- Decorative Elements -->
                <div class="absolute right-0 top-0 w-64 h-64 bg-white opacity-5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
                <div class="absolute right-10 bottom-0 w-40 h-40 bg-white opacity-5 rounded-full translate-y-1/2"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    <div>
                        <h2 class="text-3xl font-bold mb-2">Welcome Back, <%= user.name %>! 👋</h2>
                        <p class="text-indigo-200 text-lg max-w-xl">Here's what's happening with your students and courses today.</p>
                    </div>
                    
                    <div class="flex flex-col sm:flex-row gap-3 min-w-[280px]">
                        <a href="/teacher/courses/create" class="inline-flex items-center justify-center gap-2 bg-indigo-500 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-indigo-600 transition-colors shadow-sm">
                            <i class="fa-solid fa-plus"></i>
                            <span>Create Course</span>
                        </a>
                        <a href="/teacher/assignments/create" class="inline-flex items-center justify-center gap-2 bg-white/10 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-white/20 transition-colors shadow-sm border border-white/20">
                            <i class="fa-solid fa-file-pen"></i>
                            <span>New Assignment</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Overview Statistics Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
                <!-- Stat Card: Courses -->
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between group hover:border-indigo-300 transition-colors">
                    <div>
                        <p class="text-sm text-slate-500 font-medium mb-1">Total Courses</p>
                        <p class="text-2xl font-bold text-slate-800"><%= totalCourses || 0 %></p>
                    </div>
                    <div class="w-12 h-12 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                </div>
                
                <!-- Stat Card: Students -->
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between group hover:border-emerald-300 transition-colors">
                    <div>
                        <p class="text-sm text-slate-500 font-medium mb-1">Total Students</p>
                        <p class="text-2xl font-bold text-slate-800"><%= totalStudents || 0 %></p>
                    </div>
                    <div class="w-12 h-12 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
                
                <!-- Stat Card: Avg Score -->
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between group hover:border-purple-300 transition-colors">
                    <div>
                        <p class="text-sm text-slate-500 font-medium mb-1">Avg Student Score</p>
                        <p class="text-2xl font-bold text-slate-800"><%= averageStudentScore || 0 %>%</p>
                    </div>
                    <div class="w-12 h-12 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                </div>
                
                <!-- Stat Card: Pending Assignments -->
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center justify-between group hover:border-orange-300 transition-colors">
                    <div>
                        <p class="text-sm text-slate-500 font-medium mb-1">Pending Submissions</p>
                        <p class="text-2xl font-bold text-slate-800"><%= pendingSubmissions || 0 %></p>
                    </div>
                    <div class="w-12 h-12 rounded-lg bg-orange-50 text-orange-600 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-inbox"></i>
                    </div>
                </div>
            </div>

            <!-- Two Column Layout: Main & Side -->
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 sm:gap-8 mb-8">
                
                <!-- Left Column (Main: Courses & Assignments) -->
                <div class="xl:col-span-2 space-y-8">
                    
                    <!-- My Courses Section -->
                    <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-200 flex items-center justify-between">
                            <h3 class="text-lg font-bold text-slate-800">My Courses</h3>
                            <a href="/teacher/courses" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium bg-indigo-50 px-3 py-1.5 rounded-lg">View All</a>
                        </div>
                        
                        <% if (courses && courses.length > 0) { %>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                                            <th class="p-4 font-semibold">Course</th>
                                            <th class="p-4 font-semibold">Students</th>
                                            <th class="p-4 font-semibold hidden md:table-cell">Lessons</th>
                                            <th class="p-4 font-semibold hidden sm:table-cell">Status</th>
                                            <th class="p-4 font-semibold text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 text-sm">
                                        <% courses.forEach(course => { %>
                                            <tr class="hover:bg-slate-50 transition-colors">
                                                <td class="p-4">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-10 h-10 rounded-lg bg-indigo-100 overflow-hidden shrink-0 hidden sm:block">
                                                            <img src="<%= course.thumbnail || '/images/default-course.png' %>" alt="" class="w-full h-full object-cover">
                                                        </div>
                                                        <div>
                                                            <p class="font-bold text-slate-800 truncate max-w-[150px] sm:max-w-[200px]" title="<%= course.title %>"><%= course.title %></p>
                                                            <p class="text-xs text-slate-500"><%= course.subject ? course.subject.name : 'Subject' %></p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="p-4 text-slate-700 font-medium">
                                                    <i class="fa-regular fa-user text-slate-400 mr-1 text-xs"></i> <%= course.studentsCount || 0 %>
                                                </td>
                                                <td class="p-4 text-slate-700 hidden md:table-cell">
                                                    <%= course.lessonsCount || 0 %>
                                                </td>
                                                <td class="p-4 hidden sm:table-cell">
                                                    <% if (course.isPublished) { %>
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">Published</span>
                                                    <% } else { %>
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700">Draft</span>
                                                    <% } %>
                                                </td>
                                                <td class="p-4 text-right">
                                                    <a href="/teacher/courses/<%= course._id %>" class="text-indigo-600 hover:text-indigo-900 font-medium text-sm">Manage</a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <!-- Empty State: Courses -->
                            <div class="p-8 text-center flex flex-col items-center justify-center">
                                <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-4 text-2xl border border-slate-100">
                                    <i class="fa-solid fa-folder-plus"></i>
                                </div>
                                <h4 class="text-slate-800 font-bold mb-1">No Courses Created</h4>
                                <p class="text-slate-500 text-sm mb-5">You haven't created any courses yet. Start building your curriculum.</p>
                                <a href="/teacher/courses/create" class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm">Create First Course</a>
                            </div>
                        <% } %>
                    </section>

                    <!-- Recent Assignments Section -->
                    <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-200 flex items-center justify-between">
                            <h3 class="text-lg font-bold text-slate-800">Recent Assignments</h3>
                            <a href="/teacher/assignments" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium bg-indigo-50 px-3 py-1.5 rounded-lg">View All</a>
                        </div>
                        
                        <% if (assignments && assignments.length > 0) { %>
                            <div class="divide-y divide-slate-100">
                                <% assignments.forEach(assignment => { %>
                                    <div class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50 transition-colors">
                                        <div class="flex-1">
                                            <h4 class="font-bold text-slate-800 mb-1"><%= assignment.title %></h4>
                                            <p class="text-xs text-slate-500 mb-2 flex items-center gap-2">
                                                <span><i class="fa-regular fa-folder text-slate-400"></i> <%= assignment.course ? assignment.course.title : 'Course' %></span>
                                                <span>•</span>
                                                <span class="<%= new Date(assignment.dueDate) < new Date() ? 'text-red-500 font-medium' : '' %>">
                                                    <i class="fa-regular fa-calendar text-slate-400"></i> Due: <%= new Date(assignment.dueDate).toLocaleDateString() %>
                                                </span>
                                            </p>
                                            <div class="flex gap-2">
                                                <% if (assignment.status === 'Closed') { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 uppercase tracking-wider">Closed</span>
                                                <% } else if (assignment.status === 'Due Soon') { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-orange-100 text-orange-700 uppercase tracking-wider">Due Soon</span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 uppercase tracking-wider">Published</span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-6 border-t sm:border-t-0 pt-3 sm:pt-0">
                                            <div class="text-center">
                                                <p class="text-lg font-bold text-indigo-600 leading-none"><%= assignment.submissionCount || 0 %></p>
                                                <p class="text-[10px] text-slate-500 font-medium uppercase tracking-wider mt-1">Submitted</p>
                                            </div>
                                            <div class="text-center">
                                                <p class="text-lg font-bold text-orange-500 leading-none"><%= assignment.pendingCount || 0 %></p>
                                                <p class="text-[10px] text-slate-500 font-medium uppercase tracking-wider mt-1">To Grade</p>
                                            </div>
                                            <a href="/teacher/assignments/<%= assignment._id %>" class="bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 px-4 py-2 rounded-lg text-sm font-medium transition-colors ml-2">Review</a>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <!-- Empty State: Assignments -->
                            <div class="p-6 text-center py-10">
                                <p class="text-slate-500 text-sm mb-4">No assignments created yet.</p>
                                <a href="/teacher/assignments/create" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">Create Assignment &rarr;</a>
                            </div>
                        <% } %>
                    </section>
                </div>

                <!-- Right Column (Sidebar Information) -->
                <div class="space-y-8">
                    
                    <!-- Students Needing Attention -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-200">
                            <h3 class="font-bold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-triangle-exclamation text-red-500"></i> Needs Attention
                            </h3>
                            <p class="text-xs text-slate-500 mt-1">Students struggling with recent quizzes</p>
                        </div>
                        
                        <div class="p-5">
                            <% if (studentsNeedingAttention && studentsNeedingAttention.length > 0) { %>
                                <div class="space-y-4">
                                    <% studentsNeedingAttention.forEach(student => { %>
                                        <div class="flex items-center justify-between group">
                                            <div class="flex items-center gap-3">
                                                <img src="<%= student.profilePicture || '/images/default-avatar.png' %>" alt="Student" class="w-9 h-9 rounded-full object-cover bg-slate-100">
                                                <div>
                                                    <p class="text-sm font-bold text-slate-800"><%= student.name %></p>
                                                    <p class="text-[10px] text-slate-500 truncate max-w-[120px]" title="<%= student.courseTitle %>"><%= student.courseTitle %></p>
                                                </div>
                                            </div>
                                            <span class="inline-flex items-center px-2 py-1 rounded-md text-[10px] font-medium bg-red-50 text-red-600 border border-red-100">
                                                <%= student.issue %>
                                            </span>
                                        </div>
                                    <% }) %>
                                </div>
                                <a href="/teacher/students/at-risk" class="block w-full text-center mt-5 text-sm font-semibold text-indigo-600 hover:text-indigo-800">Review All At-Risk Students</a>
                            <% } else { %>
                                <div class="text-center py-6">
                                    <div class="w-12 h-12 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
                                        <i class="fa-solid fa-check"></i>
                                    </div>
                                    <p class="text-sm font-medium text-slate-800">Looking Good!</p>
                                    <p class="text-xs text-slate-500 mt-1">All your students are progressing well.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Recent Activity Feed -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-200">
                            <h3 class="font-bold text-slate-800">Recent Activity</h3>
                        </div>
                        <div class="p-5">
                            <% if (activities && activities.length > 0) { %>
                                <div class="space-y-4">
                                    <% activities.forEach((activity, index) => { %>
                                        <div class="flex items-start gap-3 <%= index !== activities.length - 1 ? 'pb-4 border-b border-slate-50' : '' %>">
                                            <!-- Activity Icon -->
                                            <div class="shrink-0 w-8 h-8 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-500 text-xs mt-0.5">
                                                <% if (activity.type === 'assignment_submitted') { %>
                                                    <i class="fa-solid fa-file-arrow-up text-orange-500"></i>
                                                <% } else if (activity.type === 'quiz_completed') { %>
                                                    <i class="fa-solid fa-spell-check text-purple-500"></i>
                                                <% } else { %>
                                                    <i class="fa-solid fa-bell"></i>
                                                <% } %>
                                            </div>
                                            <!-- Activity Details -->
                                            <div>
                                                <p class="text-sm font-medium text-slate-700 leading-tight mb-1"><%= activity.description %></p>
                                                <time class="text-[10px] text-slate-400 font-medium"><%= new Date(activity.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></time>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <!-- Empty State: Activity -->
                                <div class="text-center py-6">
                                    <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-3 mx-auto text-xl border border-slate-100">
                                        <i class="fa-regular fa-clock"></i>
                                    </div>
                                    <p class="text-sm text-slate-500">No recent activity found.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    
                    <!-- Quick Actions Widget -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
                        <h3 class="font-bold text-slate-800 mb-4">Quick Actions</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <a href="/teacher/courses/create" class="flex flex-col items-center justify-center p-3 rounded-lg border border-slate-200 hover:bg-indigo-50 hover:border-indigo-200 transition-colors group text-center">
