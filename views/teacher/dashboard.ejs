<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">

<head>
    <%- include('../partials/teacher-head', { title: typeof title !== 'undefined' ? title : 'EduSmart Teacher' }) %>
</head>

<body class="flex h-screen overflow-hidden text-slate-800">

    

    <%- include('../partials/teacher-sidebar', { active: 'dashboard' }) %>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">

        <%- include('../partials/teacher-header', { active: 'dashboard' }) %>

        <!-- Dashboard Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">

            <!-- Welcome Hero Card -->
            <div class="animate-fade-in-up opacity-0 mb-8">
                <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-indigo-600 via-blue-600 to-indigo-500 p-7 sm:p-10 text-white shadow-xl shadow-indigo-200/40">
                    <!-- Decorative shapes -->
                    <div class="absolute right-0 top-0 w-72 h-72 bg-white/5 rounded-full -translate-y-1/3 translate-x-1/4"></div>
                    <div class="absolute right-20 bottom-0 w-48 h-48 bg-white/10 rounded-full translate-y-1/2"></div>
                    <div class="absolute left-1/2 top-1/2 w-96 h-96 bg-blue-400/10 rounded-full -translate-x-1/2 -translate-y-1/2 blur-3xl"></div>

                    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                        <div>
                            <%
                                const hour = new Date().getHours();
                                let greeting = hour < 12 ? 'Good Morning' : hour < 18 ? 'Good Afternoon' : 'Good Evening';
                            %>
                            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-semibold tracking-wider uppercase mb-4 backdrop-blur-md">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                Teacher Dashboard
                            </div>
                            <h2 class="text-3xl sm:text-4xl font-extrabold mb-3 tracking-tight"><%= greeting %>, <span class="text-indigo-100"><%= user.name %>! 👋</span></h2>
                            <p class="text-indigo-100/80 text-lg max-w-xl font-medium">Here's what's happening with your students and courses today.</p>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-3 min-w-[280px]">
                            <a href="/teacher/courses/create" class="inline-flex items-center justify-center gap-2 bg-white text-indigo-600 font-bold px-6 py-3 rounded-xl hover:bg-indigo-50 hover:scale-[1.02] active:scale-95 transition-all shadow-lg shadow-black/10">
                                <i class="fa-solid fa-plus text-indigo-500"></i>
                                <span>Create Course</span>
                            </a>
                            <a href="/teacher/assignments/create" class="inline-flex items-center justify-center gap-2 bg-indigo-500/30 backdrop-blur-md text-white border border-white/20 font-bold px-6 py-3 rounded-xl hover:bg-indigo-500/40 hover:scale-[1.02] active:scale-95 transition-all">
                                <i class="fa-solid fa-file-pen text-indigo-200"></i>
                                <span>New Assignment</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Overview Statistics Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6 mb-8 delay-100 animate-fade-in-up opacity-0">
                <!-- Stat Card: Courses -->
                <div class="stat-glow card-hover bg-gradient-to-br from-blue-500 via-indigo-500 to-blue-600 rounded-2xl p-6 text-white shadow-lg shadow-indigo-200/40 relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 text-white/10 text-7xl"><i class="fa-solid fa-book-open"></i></div>
                    <div class="relative z-10">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/80">Total Courses</span>
                            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center"><i class="fa-solid fa-book-open"></i></div>
                        </div>
                        <h3 class="text-4xl font-black"><%= totalCourses || 0 %></h3>
                    </div>
                </div>

                <!-- Stat Card: Students -->
                <div class="stat-glow card-hover bg-gradient-to-br from-emerald-400 via-teal-400 to-emerald-500 rounded-2xl p-6 text-white shadow-lg shadow-emerald-200/40 relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 text-white/10 text-7xl"><i class="fa-solid fa-users"></i></div>
                    <div class="relative z-10">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/80">Total Students</span>
                            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center"><i class="fa-solid fa-users"></i></div>
                        </div>
                        <h3 class="text-4xl font-black"><%= totalStudents || 0 %></h3>
                    </div>
                </div>

                <!-- Stat Card: Avg Score -->
                <div class="stat-glow card-hover bg-gradient-to-br from-purple-500 via-fuchsia-500 to-purple-600 rounded-2xl p-6 text-white shadow-lg shadow-purple-200/40 relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 text-white/10 text-7xl"><i class="fa-solid fa-chart-line"></i></div>
                    <div class="relative z-10">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/80">Avg Score</span>
                            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center"><i class="fa-solid fa-chart-line"></i></div>
                        </div>
                        <h3 class="text-4xl font-black"><%= averageStudentScore || 0 %><span class="text-xl font-bold opacity-80">%</span></h3>
                    </div>
                </div>

                <!-- Stat Card: Pending Assignments -->
                <div class="stat-glow card-hover bg-gradient-to-br from-orange-400 via-orange-500 to-amber-500 rounded-2xl p-6 text-white shadow-lg shadow-orange-200/40 relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 text-white/10 text-7xl"><i class="fa-solid fa-inbox"></i></div>
                    <div class="relative z-10">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/80">Submissions</span>
                            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center"><i class="fa-solid fa-inbox"></i></div>
                        </div>
                        <h3 class="text-4xl font-black"><%= pendingSubmissions || 0 %></h3>
                    </div>
                </div>
            </div>

            <!-- Two Column Layout: Main & Side -->

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 sm:gap-8 mb-8">

                <!-- Left Column (Main: Courses & Assignments) -->
                <div class="xl:col-span-2 space-y-8">

                    <!-- My Courses Section -->
                    <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-200 flex items-center justify-between">
                            <h3 class="text-lg font-bold text-slate-800">My Courses</h3>
                            <a href="/teacher/courses"
                                class="text-sm text-indigo-600 hover:text-indigo-800 font-medium bg-indigo-50 px-3 py-1.5 rounded-lg">View
                                All</a>
                        </div>

                        <% if (courses && courses.length> 0) { %>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <% courses.forEach(course => { %>
                            <div class="course-card card-hover bg-white rounded-2xl border border-gray-100 overflow-hidden flex flex-col h-full shadow-sm">
                                <div class="course-img-wrap h-36 bg-gray-100 relative shrink-0">
                                    <img src="<%= course.thumbnail || '/images/default-course.png' %>" alt="Course" class="w-full h-full object-cover">
                                    <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-sm px-3 py-1 rounded-lg text-xs font-bold text-indigo-600 shadow-sm">
                                        <%= course.subject ? course.subject.name : 'General' %>
                                    </div>
                                    <div class="absolute top-3 right-3 bg-white/95 backdrop-blur-sm px-2 py-1 rounded-lg text-xs font-bold shadow-sm flex items-center gap-1">
                                        <% if (course.isPublished) { %>
                                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> <span class="text-emerald-700">Published</span>
                                        <% } else { %>
                                            <span class="w-2 h-2 rounded-full bg-slate-400"></span> <span class="text-slate-600">Draft</span>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="p-5 flex flex-col flex-1">
                                    <h4 class="font-bold text-gray-800 mb-1 line-clamp-2 text-sm" title="<%= course.title %>"><%= course.title %></h4>
                                    <p class="text-xs text-gray-400 mb-4 flex items-center gap-3 mt-auto font-medium">
                                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-users"></i> <%= course.studentsCount || 0 %> Students</span>
                                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-book"></i> <%= course.lessonsCount || 0 %> Lessons</span>
                                    </p>

                                    <div class="mt-4 pt-4 border-t border-gray-100 flex justify-between items-center">
                                        <a href="/teacher/courses/<%= course._id %>" class="text-sm font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
                                            Manage Course <i class="fa-solid fa-arrow-right text-xs"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                        <% } else { %>
                                <!-- Empty State: Courses -->
                                <div class="p-8 text-center flex flex-col items-center justify-center">
                                    <div
                                        class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-4 text-2xl border border-slate-100">
                                        <i class="fa-solid fa-folder-plus"></i>
                                    </div>
                                    <h4 class="text-slate-800 font-bold mb-1">No Courses Created</h4>
                                    <p class="text-slate-500 text-sm mb-5">You haven't created any courses yet. Start
                                        building your curriculum.</p>
                                    <a href="/teacher/courses/create"
                                        class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm">Create
                                        First Course</a>
                                </div>
                                <% } %>
                    </section>

                    <!-- Recent Assignments Section -->
                    <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-200 flex items-center justify-between">
                            <h3 class="text-lg font-bold text-slate-800">Recent Assignments</h3>
                            <a href="/teacher/assignments"
                                class="text-sm text-indigo-600 hover:text-indigo-800 font-medium bg-indigo-50 px-3 py-1.5 rounded-lg">View
                                All</a>
                        </div>

                        <% if (assignments && assignments.length> 0) { %>
                            <div class="divide-y divide-slate-100">
                                <% assignments.forEach(assignment=> { %>
                                    <div
                                        class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50 transition-colors">
                                        <div class="flex-1">
                                            <h4 class="font-bold text-slate-800 mb-1">
                                                <%= assignment.title %>
                                            </h4>
                                            <p class="text-xs text-slate-500 mb-2 flex items-center gap-2">
                                                <span><i class="fa-regular fa-folder text-slate-400"></i>
                                                    <%= assignment.course ? assignment.course.title : 'Course' %>
                                                </span>
                                                <span>•</span>
                                                <span
                                                    class="<%= new Date(assignment.dueDate) < new Date() ? 'text-red-500 font-medium' : '' %>">
                                                    <i class="fa-regular fa-calendar text-slate-400"></i> Due: <%= new
                                                        Date(assignment.dueDate).toLocaleDateString() %>
                                                </span>
                                            </p>
                                            <div class="flex gap-2">
                                                <% if (assignment.status==='Closed' ) { %>
                                                    <span
                                                        class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 uppercase tracking-wider">Closed</span>
                                                    <% } else if (assignment.status==='Due Soon' ) { %>
                                                        <span
                                                            class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-orange-100 text-orange-700 uppercase tracking-wider">Due
                                                            Soon</span>
                                                        <% } else { %>
                                                            <span
                                                                class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 uppercase tracking-wider">Published</span>
                                                            <% } %>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-6 border-t sm:border-t-0 pt-3 sm:pt-0">
                                            <div class="text-center">
                                                <p class="text-lg font-bold text-indigo-600 leading-none">
                                                    <%= assignment.submissionCount || 0 %>
                                                </p>
                                                <p
                                                    class="text-[10px] text-slate-500 font-medium uppercase tracking-wider mt-1">
                                                    Submitted</p>
                                            </div>
                                            <div class="text-center">
                                                <p class="text-lg font-bold text-orange-500 leading-none">
                                                    <%= assignment.pendingCount || 0 %>
                                                </p>
                                                <p
                                                    class="text-[10px] text-slate-500 font-medium uppercase tracking-wider mt-1">
                                                    To Grade</p>
                                            </div>
                                            <a href="/teacher/assignments/<%= assignment._id %>"
                                                class="bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 px-4 py-2 rounded-lg text-sm font-medium transition-colors ml-2">Review</a>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                            <% } else { %>
                                <!-- Empty State: Assignments -->
                                <div class="p-6 text-center py-10">
                                    <p class="text-slate-500 text-sm mb-4">No assignments created yet.</p>
                                    <a href="/teacher/assignments/create"
                                        class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">Create
                                        Assignment &rarr;</a>
                                </div>
                                <% } %>
                    </section>
                </div>

                <!-- Right Column (Sidebar Information) -->
                <div class="space-y-8">

                    <!-- Students Needing Attention -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-200">
                            <h3 class="font-bold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-triangle-exclamation text-red-500"></i> Needs Attention
                            </h3>
                            <p class="text-xs text-slate-500 mt-1">Students struggling with recent quizzes</p>
                        </div>

                        <div class="p-5">
                            <% if (studentsNeedingAttention && studentsNeedingAttention.length> 0) { %>
                                <div class="space-y-4">
                                    <% studentsNeedingAttention.forEach(student=> { %>
                                        <div class="flex flex-col gap-2 p-3 border border-slate-100 rounded-lg hover:bg-slate-50 transition-colors group">
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-3">
                                                    <img src="<%= student.profilePicture || '/images/default-avatar.png' %>"
                                                        alt="Student"
                                                        class="w-9 h-9 rounded-full object-cover bg-slate-100">
                                                    <div>
                                                        <p class="text-sm font-bold text-slate-800">
                                                            <%= student.name %>
                                                        </p>
                                                        <p class="text-[10px] text-slate-500">
                                                            Last Updated: <%= new Date(student.lastUpdated).toLocaleDateString(undefined, {month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'}) %>
                                                        </p>
                                                    </div>
                                                </div>
                                                <span class="inline-flex items-center px-2 py-1 rounded-md text-[10px] font-bold <%= student.type === 'ML_RISK' ? (student.risk === 'HIGH' ? 'bg-red-50 text-red-600 border border-red-100' : 'bg-orange-50 text-orange-600 border border-orange-100') : 'bg-yellow-50 text-yellow-700 border border-yellow-100' %>">
                                                    <%= student.risk %> RISK
                                                </span>
                                            </div>
                                            <div class="grid grid-cols-2 gap-2 mt-2 bg-slate-50 p-2 rounded text-xs text-slate-600">
                                                <div>
                                                    <span class="font-semibold block text-[10px] text-slate-400 uppercase tracking-wider">Probability</span>
                                                    <span class="<%= parseInt(student.probability) > 60 ? 'text-red-600 font-bold' : '' %>"><%= student.probability %></span>
                                                </div>
                                                <div>
                                                    <span class="font-semibold block text-[10px] text-slate-400 uppercase tracking-wider">Weak Topic</span>
                                                    <span class="truncate block max-w-full" title="<%= student.weakTopic %>"><%= student.weakTopic %></span>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <a href="/teacher/students/at-risk"
                                    class="block w-full text-center mt-5 text-sm font-semibold text-indigo-600 hover:text-indigo-800">Review
                                    All At-Risk Students</a>
                                <% } else { %>
                                    <div class="text-center py-6">
                                        <div
                                            class="w-12 h-12 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
                                            <i class="fa-solid fa-check"></i>
                                        </div>
                                        <p class="text-sm font-medium text-slate-800">Looking Good!</p>
                                        <p class="text-xs text-slate-500 mt-1">All your students are progressing well.
                                        </p>
                                    </div>
                                    <% } %>
                        </div>
                    </div>

                    <!-- Recent Activity Feed -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-200">
                            <h3 class="font-bold text-slate-800">Recent Activity</h3>
                        </div>
                        <div class="p-5">
                            <% if (activities && activities.length> 0) { %>
                                <div class="space-y-4">
                                    <% activities.forEach((activity, index)=> { %>
                                        <div
                                            class="flex items-start gap-3 <%= index !== activities.length - 1 ? 'pb-4 border-b border-slate-50' : '' %>">
                                            <!-- Activity Icon -->
                                            <div
                                                class="shrink-0 w-8 h-8 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-500 text-xs mt-0.5">
                                                <% if (activity.type==='assignment_submitted' ) { %>
                                                    <i class="fa-solid fa-file-arrow-up text-orange-500"></i>
                                                    <% } else if (activity.type==='quiz_completed' ) { %>
                                                        <i class="fa-solid fa-spell-check text-purple-500"></i>
                                                        <% } else { %>
                                                            <i class="fa-solid fa-bell"></i>
                                                            <% } %>
                                            </div>
                                            <!-- Activity Details -->
                                            <div>
                                                <p class="text-sm font-medium text-slate-700 leading-tight mb-1">
                                                    <%= activity.description %>
                                                </p>
                                                <time class="text-[10px] text-slate-400 font-medium">
                                                    <%= new Date(activity.date).toLocaleDateString(undefined, {
                                                        month: 'short' , day: 'numeric' , hour: '2-digit' ,
                                                        minute: '2-digit' }) %>
                                                </time>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <!-- Empty State: Activity -->
                                    <div class="text-center py-6">
                                        <div
                                            class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-3 mx-auto text-xl border border-slate-100">
                                            <i class="fa-regular fa-clock"></i>
                                        </div>
                                        <p class="text-sm text-slate-500">No recent activity found.</p>
                                    </div>
                                    <% } %>
                        </div>
                    </div>

                    <!-- Quick Actions Widget -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
                        <h3 class="font-bold text-slate-800 mb-4">Quick Actions</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <a href="/teacher/courses/create"
                                class="flex flex-col items-center justify-center p-3 rounded-lg border border-slate-200 hover:bg-indigo-50 hover:border-indigo-200 transition-colors group text-center">
                                <i
                                    class="fa-solid fa-book-medical text-indigo-500 text-xl mb-2 group-hover:scale-110 transition-transform"></i>
                                <span class="text-xs font-semibold text-slate-700 group-hover:text-indigo-700">New
                                    Course</span>
                            </a>
                            <a href="/teacher/quizzes/create"
                                class="flex flex-col items-center justify-center p-3 rounded-lg border border-slate-200 hover:bg-purple-50 hover:border-purple-200 transition-colors group text-center">
                                <i
                                    class="fa-solid fa-list-check text-purple-500 text-xl mb-2 group-hover:scale-110 transition-transform"></i>
                                <span class="text-xs font-semibold text-slate-700 group-hover:text-purple-700">Create
                                    Quiz</span>
                            </a>
                            <a href="/teacher/assignments/create"
                                class="flex flex-col items-center justify-center p-3 rounded-lg border border-slate-200 hover:bg-orange-50 hover:border-orange-200 transition-colors group text-center">
                                <i
                                    class="fa-solid fa-file-pen text-orange-500 text-xl mb-2 group-hover:scale-110 transition-transform"></i>
                                <span class="text-xs font-semibold text-slate-700 group-hover:text-orange-700">New
                                    Assignment</span>
                            </a>
                            <a href="/teacher/students"
                                class="flex flex-col items-center justify-center p-3 rounded-lg border border-slate-200 hover:bg-emerald-50 hover:border-emerald-200 transition-colors group text-center">
                                <i
                                    class="fa-solid fa-users text-emerald-500 text-xl mb-2 group-hover:scale-110 transition-transform"></i>
                                <span class="text-xs font-semibold text-slate-700 group-hover:text-emerald-700">View
                                    Students</span>
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </main>

    <!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');

            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');

                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };

            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);
        });
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>

</html>
