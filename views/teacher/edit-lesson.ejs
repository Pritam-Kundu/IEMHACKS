<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <%- include('../partials/teacher-head', { title: typeof title !== 'undefined' ? title : 'EduSmart Teacher' }) %>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    

    <%- include('../partials/teacher-sidebar', { active: 'edit-lesson' }) %>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">
        
        <%- include('../partials/teacher-header', { active: 'edit-lesson' }) %>

        <!-- Dashboard Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            
            <div class="max-w-4xl mx-auto">
                <div class="bg-white rounded-2xl shadow-md border border-slate-200 overflow-hidden animate-fade-in-up opacity-0 delay-100 card-hover">
                    <div class="p-6 sm:p-8 border-b border-slate-200 bg-slate-50">
                        <h2 class="text-2xl font-bold text-slate-800">Edit Lesson</h2>
                        <p class="text-slate-500 mt-1">Update the content and settings for your lesson.</p>
                    </div>
                    
                    <div class="p-6 sm:p-8">
                        <form id="editLessonForm" class="space-y-6" data-lesson-id="<%= lesson._id %>">
                            <!-- Error Alert -->
                            <div id="errorAlert" class="hidden bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-lg text-sm font-medium flex items-start gap-3">
                                <i class="fa-solid fa-circle-exclamation mt-0.5"></i>
                                <span id="errorMessage">Please check your inputs.</span>
                            </div>

                            <!-- Success Alert -->
                            <div id="successAlert" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-600 px-4 py-3 rounded-lg text-sm font-medium flex items-start gap-3">
                                <i class="fa-solid fa-circle-check mt-0.5"></i>
                                <span id="successMessage">Lesson updated successfully! Redirecting...</span>
                            </div>

                            <div class="space-y-4">
                                <!-- Video Preview (If exists) -->
                                <% if (lesson.muxPlaybackId || lesson.videoUrl) { %>
                                <div class="mb-6">
                                    <label class="block text-sm font-semibold text-slate-700 mb-2">Current Video Preview</label>
                                    <div class="rounded-xl overflow-hidden shadow-sm bg-black aspect-video relative max-w-2xl">
                                        <% if (lesson.muxPlaybackId) { %>
                                            <mux-player
                                                playback-id="<%= lesson.muxPlaybackId %>"
                                                metadata-video-title="<%= lesson.title %>"
                                                class="w-full h-full"
                                            ></mux-player>
                                        <% } else if (lesson.videoUrl && (lesson.videoUrl.startsWith('/uploads/') || lesson.videoUrl.endsWith('.mp4') || lesson.videoUrl.endsWith('.webm'))) { %>
                                            <video controls preload="metadata" class="w-full h-full">
                                                <source src="<%= lesson.videoUrl %>" type="video/mp4">
                                                Your browser does not support the video tag.
                                            </video>
                                        <% } else if (lesson.videoUrl) { %>
                                            <iframe src="<%= lesson.videoUrl %>" 
                                                    class="absolute top-0 left-0 w-full h-full border-0"
                                                    allowfullscreen></iframe>
                                        <% } %>
                                    </div>
                                </div>
                                <% } %>

                                <!-- Course -->
                                <div>
                                    <label for="course" class="block text-sm font-semibold text-slate-700 mb-1">Select Course <span class="text-red-500">*</span></label>
                                    <select id="course" name="course" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800 bg-white">
                                        <option value="" disabled>Choose a course</option>
                                        <% if (courses && courses.length > 0) { %>
                                            <% courses.forEach(c => { %>
                                                <option value="<%= c._id %>" <%= lesson.course._id.toString() === c._id.toString() ? 'selected' : '' %>><%= c.title %></option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                </div>

                                <!-- Title -->
                                <div>
                                    <label for="title" class="block text-sm font-semibold text-slate-700 mb-1">Lesson Title <span class="text-red-500">*</span></label>
                                    <input type="text" id="title" name="title" value="<%= lesson.title %>" required placeholder="e.g. Introduction to React" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800">
                                </div>

                                <!-- Description -->
                                <div>
                                    <label for="description" class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
                                    <textarea id="description" name="description" rows="2" placeholder="Briefly describe what this lesson is about..." class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800"><%= lesson.description %></textarea>
                                </div>

                                <!-- Content -->
                                <div>
                                    <label for="content" class="block text-sm font-semibold text-slate-700 mb-1">Content (Markdown / Text)</label>
                                    <textarea id="content" name="content" rows="6" placeholder="Write lesson content here..." class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800"><%= lesson.content %></textarea>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <!-- Video Upload -->
                                    <div>
                                        <label for="muxVideoFile" class="block text-sm font-semibold text-slate-700 mb-1">Upload Video (Mux)</label>
                                        <input type="file" id="muxVideoFile" accept="video/*" class="w-full px-4 py-2 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800 bg-white">
                                        
                                        <div id="uploadProgressContainer" class="hidden mt-3 w-full bg-slate-200 rounded-full h-2.5">
                                            <div id="uploadProgressBar" class="bg-indigo-600 h-2.5 rounded-full" style="width: 0%"></div>
                                        </div>
                                        <p id="uploadProgressText" class="text-xs text-slate-500 mt-1 hidden">0%</p>
                                        
                                        <% if (lesson.muxStatus === 'ready') { %>
                                            <p class="text-xs text-emerald-600 mt-2"><i class="fas fa-check-circle mr-1"></i> Mux Video is ready</p>
                                        <% } else if (lesson.muxStatus === 'preparing') { %>
                                            <p class="text-xs text-amber-600 mt-2"><i class="fas fa-spinner fa-spin mr-1"></i> Mux Video is processing...</p>
                                        <% } else if (lesson.videoUrl && (lesson.videoUrl.startsWith('/uploads/') || lesson.videoUrl.endsWith('.mp4'))) { %>
                                            <p class="text-xs text-emerald-600 mt-2"><i class="fas fa-check-circle mr-1"></i> Current file: <%= lesson.videoUrl.split('/').pop() %></p>
                                        <% } %>
                                    </div>
                                    <!-- Video URL -->
                                    <div>
                                        <label for="videoUrl" class="block text-sm font-semibold text-slate-700 mb-1">Or Video URL (Fallback)</label>
                                        <input type="url" id="videoUrl" name="videoUrl" value="<%= lesson.videoUrl || '' %>" placeholder="https://youtube.com/..." class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800">
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <!-- Duration -->
                                    <div>
                                        <label for="duration" class="block text-sm font-semibold text-slate-700 mb-1">Duration (Minutes)</label>
                                        <input type="number" id="duration" name="duration" min="0" value="<%= lesson.duration || 0 %>" placeholder="e.g. 15" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800">
                                    </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <!-- Order -->
                                    <div>
                                        <label for="order" class="block text-sm font-semibold text-slate-700 mb-1">Order (Position in Course)</label>
                                        <input type="number" id="order" name="order" min="1" value="<%= lesson.order || 1 %>" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all text-slate-800">
                                    </div>
                                    <!-- Free Preview -->
                                    <div class="flex items-center h-full pt-6">
                                        <label class="flex items-center gap-3 cursor-pointer">
                                            <input type="checkbox" id="isFree" name="isFree" <%= lesson.isFree ? 'checked' : '' %> class="w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                                            <span class="text-sm font-medium text-slate-700">Free Preview (Available without enrollment)</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            
                            <hr class="border-slate-200 my-6">
                            
                            <!-- Action Buttons -->
                            <div class="flex items-center justify-end gap-3 pt-2">
                                <a href="/teacher/lessons" class="px-5 py-2.5 rounded-lg text-slate-600 font-semibold hover:bg-slate-100 transition-colors">Cancel</a>
                                <button type="submit" id="submitBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-lg font-semibold shadow-sm transition-colors flex items-center justify-center min-w-[140px]">
                                    <span>Save Changes</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            
        </div>
    </main>

    <!-- Page Specific Scripts -->
    <script src="https://unpkg.com/@mux/upchunk@3"></script>
    <script src="https://unpkg.com/@mux/mux-player"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            // Form Submission Logic
            const form = document.getElementById('editLessonForm');
            const submitBtn = document.getElementById('submitBtn');
            const errorAlert = document.getElementById('errorAlert');
            const errorMessage = document.getElementById('errorMessage');
            const successAlert = document.getElementById('successAlert');

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                // Reset alerts
                errorAlert.classList.add('hidden');
                successAlert.classList.add('hidden');
                
                const lessonId = form.getAttribute('data-lesson-id');
                
                // Get form data
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());
                
                // Client-side validation
                if (!data.title.trim() || !data.course) {
                    errorMessage.textContent = 'Please fill in all required fields.';
                    errorAlert.classList.remove('hidden');
                    return;
                }
                
                // Handling checkbox
                data.isFree = form.querySelector('#isFree').checked;

                // Loading state
                const originalBtnText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-70', 'cursor-not-allowed');

                const muxVideoFile = document.getElementById('muxVideoFile').files[0];
                const progressContainer = document.getElementById('uploadProgressContainer');
                const progressBar = document.getElementById('uploadProgressBar');
                const progressText = document.getElementById('uploadProgressText');

                try {
                    if (muxVideoFile) {
                        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Requesting Upload URL...';
                        
                        // 1. Get Direct Upload URL
                        const urlRes = await fetch('/teacher/upload/mux-url', { method: 'POST' });
                        const urlData = await urlRes.json();
                        if (!urlData.success) throw new Error('Failed to get Mux upload URL');

                        const uploadUrl = urlData.uploadUrl;
                        const uploadId = urlData.uploadId;
                        
                        progressContainer.classList.remove('hidden');
                        progressText.classList.remove('hidden');
                        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Uploading Video...';

                        // 2. Upload with UpChunk
                        await new Promise((resolve, reject) => {
                            const upload = UpChunk.createUpload({
                                endpoint: uploadUrl,
                                file: muxVideoFile,
                                chunkSize: 30720 // 30MB chunk
                            });

                            upload.on('progress', progress => {
                                const percentage = progress.detail.toFixed(0);
                                progressBar.style.width = percentage + '%';
                                progressText.textContent = `Uploading... ${percentage}%`;
                            });

                            upload.on('success', () => {
                                progressText.textContent = 'Upload Complete! Processing...';
                                resolve();
                            });

                            upload.on('error', err => {
                                reject(new Error('Video upload failed: ' + err.detail.message));
                            });
                        });

                        // 3. Set the muxAssetId to be the upload ID (backend will resolve it to asset_id)
                        data.muxAssetId = uploadId;
                    }

                    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Saving...';

                    const response = await fetch(`/teacher/lessons/${lessonId}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        successAlert.classList.remove('hidden');
                        setTimeout(() => {
                            window.location.href = '/teacher/lessons';
                        }, 1000);
                    } else {
                        throw new Error(result.message || 'Failed to update lesson.');
                    }
                } catch (error) {
                    console.error('Update lesson error:', error);
                    errorMessage.textContent = error.message || 'A network error occurred. Please try again.';
                    errorAlert.classList.remove('hidden');
                    
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                    submitBtn.innerHTML = originalBtnText;
                }
            });
        });
    </script>
    <%- include('../partials/teacher-header-scripts') %>
    <%- include('../partials/language-modal') %>
</body>
</html>
