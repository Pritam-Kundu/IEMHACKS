<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- Tailwind CSS (CDN for rapid hackathon setup, can be replaced with build later) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* Dashboard-specific custom styles */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        /* Sidebar styling */
        .sidebar-active {
            background-color: #e0e7ff;
            color: #4f46e5;
            font-weight: 600;
            border-right: 4px solid #4f46e5;
        }

        .sidebar-item {
            transition: all 0.2s ease-in-out;
        }

        .sidebar-item:hover:not(.sidebar-active) {
            background-color: #f1f5f9;
            color: #334155;
        }

        /* Utility */
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }

        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar"
        class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2 text-indigo-600 hover:text-indigo-700 transition-colors">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
                <span class="font-mono text-2xl font-bold tracking-tight text-slate-900">EduSmart <span class="font-sans text-xs text-blue-600 ml-1 font-semibold uppercase tracking-normal">Student</span></span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/student/dashboard"
                class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-house w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.dashboard') : 'Dashboard' %></span>
            </a>
            <a href="/student/courses" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.myCourses') : 'My Courses' %></span>
            </a>
            <a href="/student/quizzes" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-clipboard-question w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.quizzes') : 'Quizzes' %></span>
            </a>
            <a href="/student/ai-tutor"
                class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-robot w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.aiTutor') : 'AI Tutor' %></span>
            </a>
            <a href="/student/progress"
                class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.progress') : 'Progress' %></span>
            </a>
            <a href="/student/leaderboard"
                class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-trophy w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.leaderboard') : 'Leaderboard' %></span>
            </a>
            <a href="/student/badges" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.badges') : 'Badges' %></span>
            </a>
            <a href="/student/offline-videos" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-download w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.offlineVideos') : 'Offline Videos' %></span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/student/settings"
                class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.settings') : 'Settings' %></span>
            </a>
            <!-- Using existing logout flow -->
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit"
                    class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span><%= typeof t === 'function' ? t('common.logout') : 'Logout' %></span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">

        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn"
                        class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block mr-6">Dashboard</h1>

                    <!-- Global Links -->
                    <div class="hidden md:flex items-center space-x-6 border-l pl-6 border-slate-200">
                        <a href="/" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('common.home') : 'Home' %></a>
                        <a href="/#features"
                            class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('home.featuresHeader') : 'Features' %></a>
                        <a href="/#how-it-works"
                            class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('home.howItWorks') : 'How it Works' %></a>
                        <a href="/#about"
                            class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('nav.aboutUs') : 'About' %></a>
                    </div>
                </div>

                <div class="flex items-center gap-5">
                    
                    <!-- Language Switcher -->
                    <div class="relative group mr-2">
                        <button class="inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors gap-1">
                            <i class="fa-solid fa-globe text-xl"></i>
                            <%= locals.language === 'bn' ? 'বাংলা' : 'English' %>
                        </button>
                        <div class="absolute right-0 mt-0 w-32 bg-white border border-slate-200 rounded-md shadow-lg hidden group-hover:block z-50 overflow-hidden">
                            <button onclick="changeLanguageImmediately('en')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'en' ? 'font-bold' : '' %>">English</button>
                            <button onclick="changeLanguageImmediately('bn')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'bn' ? 'font-bold' : '' %>">বাংলা</button>
                        </div>
                    </div>

                    <%- include('../partials/student-header-controls') %>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">

            <!-- Welcome Hero Card -->
            <div
                class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-6 sm:p-8 text-white shadow-lg mb-8 relative overflow-hidden">
                <!-- Decorative Elements -->
                <div
                    class="absolute right-0 top-0 w-64 h-64 bg-white opacity-5 rounded-full -translate-y-1/2 translate-x-1/3">
                </div>
                <div class="absolute right-10 bottom-0 w-40 h-40 bg-white opacity-10 rounded-full translate-y-1/2">
                </div>

                <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    <div>
                        <h2 class="text-3xl font-bold mb-2">Good Morning, <%= user.name %>! 👋</h2>
                        <p class="text-indigo-100 text-lg max-w-xl">Keep Learning, Keep Growing! You're making great
                            progress towards your learning goals.</p>
                    </div>

                    <!-- Continue Learning Quick Action -->
                    <% if (continueLearning) { %>
                        <div class="bg-white/20 backdrop-blur-md rounded-xl p-5 border border-white/30 min-w-[280px]">
                            <p class="text-sm text-indigo-100 font-medium mb-1">Current Focus</p>
                            <p class="text-lg font-bold mb-3 truncate" title="<%= continueLearning.lessonTitle %>">
                                <%= continueLearning.lessonTitle %>
                            </p>
                            <a href="/student/lesson"
                                class="inline-flex items-center justify-center gap-2 bg-white text-indigo-700 font-semibold px-5 py-2.5 rounded-lg w-full hover:bg-indigo-50 transition-colors shadow-sm">
                                <span><%= typeof t === 'function' ? t('student.continueLearning') : 'Continue Learning' %></span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                        <% } else { %>
                            <div
                                class="bg-white/20 backdrop-blur-md rounded-xl p-5 border border-white/30 min-w-[280px] text-center">
                                <p class="text-sm text-indigo-100 font-medium mb-2">Ready to start learning?</p>
                                <a href="/student/explore"
                                    class="inline-flex items-center justify-center gap-2 bg-white text-indigo-700 font-semibold px-5 py-2.5 rounded-lg w-full hover:bg-indigo-50 transition-colors shadow-sm">
                                    <span><%= typeof t === 'function' ? t('student.exploreCourses') : 'Explore Courses' %></span>
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </a>
                            </div>
                            <% } %>
                </div>
            </div>

            <!-- Quick Statistics Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
                <!-- Stat Card: Courses -->
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center gap-4">
                    <div
                        class="w-12 h-12 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-xl shrink-0">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-medium"><%= typeof t === 'function' ? t('student.courses') : 'Courses Enrolled' %></p>
                        <p class="text-2xl font-bold text-slate-800">
                            <%= coursesEnrolled || 0 %>
                        </p>
                    </div>
                </div>

                <!-- Stat Card: Lessons -->
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center gap-4">
                    <div
                        class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl shrink-0">
                        <i class="fa-solid fa-check-double"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-medium"><%= typeof t === 'function' ? t('student.completed') : 'Lessons Completed' %></p>
                        <p class="text-2xl font-bold text-slate-800">
                            <%= lessonsCompleted || 0 %>
                        </p>
                    </div>
                </div>

                <!-- Stat Card: Streak -->
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center gap-4">
                    <div
                        class="w-12 h-12 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center text-xl shrink-0">
                        <i class="fa-solid fa-fire"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-medium"><%= typeof t === 'function' ? t('student.currentStreak') : 'Current Streak' %></p>
                        <p class="text-2xl font-bold text-slate-800">
                            <%= currentStreak || 0 %> <span class="text-base font-normal text-slate-500"><%= typeof t === 'function' ? t('student.days') : 'Days' %></span>
                        </p>
                    </div>
                </div>

                <!-- Stat Card: Quiz Score -->
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex items-center gap-4">
                    <div
                        class="w-12 h-12 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center text-xl shrink-0">
                        <i class="fa-solid fa-bullseye"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-500 font-medium">Avg. Quiz Score</p>
                        <p class="text-2xl font-bold text-slate-800">
                            <%= averageQuizScore || 0 %>%
                        </p>
                    </div>
                </div>
            </div>

            <!-- Layout: 2/3 Main Content, 1/3 Sidebar Info -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 mb-8">

                <!-- Left Column (Main) -->
                <div class="lg:col-span-2 space-y-8">

                    <!-- My Courses Section -->
                    <section>
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-bold text-slate-800">My Courses</h3>
                            <a href="/student/courses"
                                class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">View All</a>
                        </div>

                        <% if (enrollments && enrollments.length> 0) { %>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <% enrollments.forEach(enrollment=> { %>
                                    <div
                                        class="bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md transition-shadow group flex flex-col h-full">
                                        <div class="h-32 bg-slate-200 relative overflow-hidden shrink-0">
                                            <img src="<%= enrollment.course.thumbnail || '/images/default-course.png' %>"
                                                alt="Course Thumbnail"
                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                            <div
                                                class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-md text-xs font-semibold text-slate-700">
                                                <%= enrollment.course.subject ? enrollment.course.subject.name
                                                    : 'General' %>
                                            </div>
                                        </div>
                                        <div class="p-5 flex flex-col flex-1">
                                            <h4 class="font-bold text-slate-800 mb-1 line-clamp-2"
                                                title="<%= enrollment.course.title %>">
                                                <%= enrollment.course.title %>
                                            </h4>
                                            <p class="text-sm text-slate-500 mb-4 flex items-center gap-1.5 mt-auto">
                                                <i class="fa-regular fa-user text-xs"></i>
                                                <%= enrollment.course.teacher ? enrollment.course.teacher.name
                                                    : 'Instructor' %>
                                            </p>

                                            <!-- Simple calculated progress for UI presentation -->
                                            <% const curProgress=enrollment.status==='completed' ? 100 : 45; %>
                                                <div class="w-full bg-slate-100 rounded-full h-2 mb-2 overflow-hidden">
                                                    <div class="bg-indigo-600 h-2 rounded-full"
                                                        style="width: <%= curProgress %>%"></div>
                                                </div>
                                                <div
                                                    class="flex justify-between items-center text-xs text-slate-500 font-medium mb-4">
                                                    <span><%= typeof t === 'function' ? t('navigation.progress') : 'Progress' %></span>
                                                    <span>
                                                        <%= curProgress %>%
                                                    </span>
                                                </div>

                                                <a href="/student/course/<%= enrollment.course._id %>"
                                                    class="text-center w-full block py-2 border border-slate-200 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                                                    View Course
                                                </a>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                            <% } else { %>
                                <!-- Empty State: Courses -->
                                <div
                                    class="bg-white rounded-xl p-8 border border-slate-200 text-center flex flex-col items-center justify-center shadow-sm">
                                    <div
                                        class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-400 mb-4 text-2xl border border-slate-100">
                                        <i class="fa-solid fa-folder-open"></i>
                                    </div>
                                    <h4 class="text-slate-800 font-bold mb-1">No Courses Yet</h4>
                                    <p class="text-slate-500 text-sm mb-5">You haven't enrolled in any courses yet.</p>
                                    <a href="/student/explore"
                                        class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm">Browse
                                        Courses</a>
                                </div>
                                <% } %>
                    </section>

                    <!-- AI Tutor Promotional Banner -->
                    <div
                        class="bg-gradient-to-r from-slate-900 to-slate-800 rounded-xl p-6 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md relative overflow-hidden">
                        <div
                            class="absolute right-0 bottom-0 opacity-10 pointer-events-none translate-x-1/4 translate-y-1/4">
                            <i class="fa-solid fa-robot text-9xl"></i>
                        </div>
                        <div class="relative z-10">
                            <h3 class="text-xl font-bold text-white mb-2 flex items-center gap-2">
                                <i class="fa-solid fa-wand-magic-sparkles text-indigo-400"></i> Need Help?
                            </h3>
                            <p class="text-slate-300 text-sm max-w-md leading-relaxed">Ask the EduSmart AI Tutor about
                                any lesson, assignment or difficult concept you're stuck on.</p>
                        </div>
                        <a href="/student/ai-tutor"
                            class="relative z-10 shrink-0 bg-indigo-500 hover:bg-indigo-600 text-white font-semibold py-2.5 px-6 rounded-lg transition-colors whitespace-nowrap shadow-lg shadow-indigo-500/30">
                            Ask AI Tutor
                        </a>
                    </div>
                </div>

                <!-- Right Column (Sidebar Information) -->
                <div class="space-y-8">

                    <!-- Daily Learning Goal -->
                    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
                        <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-target text-orange-500"></i> Today's Goal
                        </h3>

                        <div class="flex items-end justify-between mb-2">
                            <div>
                                <p class="text-2xl font-bold text-slate-800">20 <span
                                        class="text-sm font-normal text-slate-500">/ 30 min</span></p>
                            </div>
                            <p class="text-sm font-medium text-orange-600 bg-orange-50 px-2 py-1 rounded-md">10 mins
                                left</p>
                        </div>

                        <div class="w-full bg-slate-100 rounded-full h-2.5 mb-1 overflow-hidden">
                            <!-- Progress visualization based on 20/30 -->
                            <div class="bg-orange-500 h-2.5 rounded-full" style="width: 66%"></div>
                        </div>
                    </div>

                    <!-- Recent Badges / Gamification -->
                    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-bold text-slate-800">Recent Badges</h3>
                            <a href="/student/badges"
                                class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">View All</a>
                        </div>

                        <% if (badges && badges.length> 0) { %>
                            <div class="grid grid-cols-2 gap-3">
                                <% badges.forEach(badge=> { %>
                                    <div class="flex flex-col items-center p-3 bg-slate-50 rounded-lg border border-slate-100 text-center"
                                        title="<%= badge.description %>">
                                        <div
                                            class="w-12 h-12 bg-amber-50 rounded-full border border-amber-200 flex items-center justify-center mb-2 shadow-sm text-xl text-amber-500">
                                            <% if(badge.icon && badge.icon.startsWith('fa-')) { %>
                                                <i class="fa-solid <%= badge.icon %>"></i>
                                                <% } else if (badge.icon) { %>
                                                    <img src="<%= badge.icon %>" alt="<%= badge.name %>"
                                                        class="w-7 h-7 object-contain">
                                                    <% } else { %>
                                                        <i class="fa-solid fa-award"></i>
                                                        <% } %>
                                        </div>
                                        <p class="text-xs font-semibold text-slate-700 leading-tight">
                                            <%= badge.name %>
                                        </p>
                                    </div>
                                    <% }) %>
                            </div>
                            <% } else { %>
                                <!-- Empty State: Badges -->
                                <div
                                    class="text-center py-5 bg-slate-50 rounded-lg border border-slate-100 border-dashed">
                                    <div class="text-slate-300 text-3xl mb-2"><i class="fa-solid fa-medal"></i></div>
                                    <p class="text-sm text-slate-500 mb-3"><%= typeof t === 'function' ? t('student.achievementsEarned') : 'Your first achievement is waiting!' %></p>
                                    <a href="/student/explore"
                                        class="text-xs font-semibold bg-white border border-slate-200 px-3 py-1.5 rounded-md hover:bg-slate-50 text-slate-700 shadow-sm transition-colors">Start
                                        Learning</a>
                                </div>
                                <% } %>
                    </div>

                    <!-- Recent Activity Feed -->
                    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
                        <h3 class="font-bold text-slate-800 mb-5">Recent Activity</h3>

                        <% if (activities && activities.length> 0) { %>
                            <div class="space-y-4">
                                <% activities.forEach((activity, index)=> { %>
                                    <div
                                        class="flex items-start gap-3 <%= index !== activities.length - 1 ? 'pb-4 border-b border-slate-100' : '' %>">
                                        <!-- Activity Icon -->
                                        <div
                                            class="shrink-0 w-8 h-8 rounded-full bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 text-xs">
                                            <% if (activity.type==='lesson_completed' ) { %>
                                                <i class="fa-solid fa-check"></i>
                                                <% } else if (activity.type==='quiz_completed' ) { %>
                                                    <i class="fa-solid fa-list-check"></i>
                                                    <% } else { %>
                                                        <i class="fa-solid fa-bolt"></i>
                                                        <% } %>
                                        </div>
                                        <!-- Activity Details -->
                                        <div>
                                            <p class="text-sm font-medium text-slate-700 leading-tight mb-1">
                                                <%= activity.description %>
                                            </p>
                                            <time class="text-xs text-slate-400 font-medium">
                                                <%= new Date(activity.date).toLocaleDateString(undefined, {
                                                    month: 'short' , day: 'numeric' , year: 'numeric' }) %>
                                            </time>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                            <% } else { %>
                                <!-- Empty State: Activity -->
                                <div class="text-center py-6">
                                    <div
                                        class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-3 mx-auto text-xl border border-slate-100">
                                        <i class="fa-regular fa-clock"></i>
                                    </div>
                                    <p class="text-sm text-slate-500">No recent activity.</p>
                                </div>
                                <% } %>
                    </div>

                </div>
            </div>

        </div>
    </main>

    <!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');

            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');

                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden'); // Restore body scroll
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden'); // Prevent body scroll
                }
            };

            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            /**
             * Phase 13 Preparation: IndexedDB Initialization 
             * This provides the architecture placeholder for offline caching.
             * The actual caching sync logic will be added in Phase 13.
             */
            if ('indexedDB' in window) {
                // Future IndexedDB implementation placeholder
                console.log('IndexedDB is supported. Ready for offline mode caching.');
            }
        });
    </script>
    <%- include('../partials/language-modal') %>
</body>

</html>