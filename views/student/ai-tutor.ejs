<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="/js/voice/speechToText.js"></script>
    <script src="/js/voice/textToSpeech.js"></script>
    
    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #fef3f2 100%); min-height: 100vh; }
        .sidebar-item { transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); }
        .sidebar-item:hover:not(.sidebar-active) { background: linear-gradient(135deg, #eef2ff, #f5f3ff); color: #4f46e5; transform: translateX(4px); }
        .sidebar-active { background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff !important; border-radius: 12px; box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3); }
        .sidebar-active div {
            background: transparent !important;
            color: #fff !important;
            box-shadow: none !important;
        }
        .sidebar-active i { color: #fff !important; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
        .delay-100 { animation-delay: 0.1s; } .delay-200 { animation-delay: 0.2s; } .delay-300 { animation-delay: 0.3s; }
        .card-hover { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .card-hover:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08); }
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
        .scrollbar-thin::-webkit-scrollbar { width: 5px; } .scrollbar-thin::-webkit-scrollbar-track { background: transparent; } .scrollbar-thin::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

        /* Sophisticated AI Tutor Styles */
        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-top: 1px solid rgba(255,255,255,0.8);
        }

        /* Message Animations */
        @keyframes messagePop {
            0% { opacity: 0; transform: translateY(15px) scale(0.95); }
            100% { opacity: 1; transform: translateY(0) scale(1); }
        }
        .message-enter {
            animation: messagePop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        /* Thinking Dots Animation */
        .typing-dot {
            animation: typingDot 1.4s infinite ease-in-out both;
        }
        .typing-dot:nth-child(1) { animation-delay: -0.32s; }
        .typing-dot:nth-child(2) { animation-delay: -0.16s; }
        @keyframes typingDot {
            0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
            40% { transform: scale(1); opacity: 1; }
        }

        /* Sleek Scrollbar */
        .sleek-scrollbar::-webkit-scrollbar { width: 6px; }
        .sleek-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .sleek-scrollbar::-webkit-scrollbar-thumb { background-color: rgba(203, 213, 225, 0.5); border-radius: 20px; }
        .sleek-scrollbar:hover::-webkit-scrollbar-thumb { background-color: rgba(148, 163, 184, 0.8); }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-gray-800">
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-20 hidden lg:hidden transition-opacity"></div>
    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-[260px] bg-white/90 backdrop-blur-xl border-r border-indigo-100/50 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col shadow-lg shadow-indigo-100/20">
        <div class="p-5 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2.5 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-blue-500 flex items-center justify-center shadow-md shadow-indigo-200/50"><i class="fa-solid fa-graduation-cap text-white text-lg"></i></div>
                <div><span class="font-extrabold text-lg text-gray-900 tracking-tight">EduSmart</span><span class="block text-[10px] font-semibold text-indigo-500 uppercase tracking-widest -mt-0.5">Student</span></div>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors"><i class="fa-solid fa-xmark text-lg"></i></button>
        </div>
        <nav class="flex-1 px-3 py-2 space-y-1 overflow-y-auto scrollbar-thin">
            <a href="/student/dashboard" class="sidebar-item group flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-indigo-600 bg-indigo-50 group-hover:bg-white group-hover:shadow-sm"><i class="fa-solid fa-house text-sm"></i></div><span class="font-semibold"><%= typeof t === 'function' ? t('navigation.dashboard') : 'Dashboard' %></span></a>
            <a href="/student/courses" class="sidebar-item group flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-violet-600 bg-violet-50 group-hover:bg-white group-hover:shadow-sm"><i class="fa-solid fa-book-open text-sm"></i></div><span class="font-semibold"><%= typeof t === 'function' ? t('navigation.myCourses') : 'My Courses' %></span></a>

            <a href="/student/explore" class="sidebar-item group flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-sky-600 bg-sky-50 group-hover:bg-white group-hover:shadow-sm"><i class="fa-solid fa-compass text-sm"></i></div>
                <span class="font-semibold">Explore</span>
            </a>




            <a href="/student/quizzes" class="sidebar-item group flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-amber-600 bg-amber-50 group-hover:bg-white group-hover:shadow-sm"><i class="fa-solid fa-clipboard-question text-sm"></i></div><span class="font-semibold"><%= typeof t === 'function' ? t('navigation.quizzes') : 'Quizzes' %></span></a>
            <a href="/student/ai-tutor" class="sidebar-item group sidebar-active flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-cyan-600 bg-cyan-50 group-hover:bg-white group-hover:shadow-sm"><i class="fa-solid fa-robot text-sm"></i></div><span class="font-semibold"><%= typeof t === 'function' ? t('navigation.aiTutor') : 'AI Tutor' %></span></a>
            <a href="/student/progress" class="sidebar-item group flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-purple-600 bg-purple-50 group-hover:bg-white group-hover:shadow-sm"><i class="fa-solid fa-chart-line text-sm"></i></div><span class="font-semibold"><%= typeof t === 'function' ? t('navigation.progress') : 'Progress' %></span></a>
            <a href="/student/leaderboard" class="sidebar-item group flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-yellow-600 bg-yellow-50 group-hover:bg-white group-hover:shadow-sm"><i class="fa-solid fa-trophy text-sm"></i></div><span class="font-semibold"><%= typeof t === 'function' ? t('navigation.leaderboard') : 'Leaderboard' %></span></a>
            <a href="/student/badges" class="sidebar-item group flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-emerald-600 bg-emerald-50 group-hover:bg-white group-hover:shadow-sm"><i class="fa-solid fa-medal text-sm"></i></div><span class="font-semibold"><%= typeof t === 'function' ? t('navigation.badges') : 'Badges' %></span></a>
            <a href="/student/offline-videos" class="sidebar-item group flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><div class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-slate-600 bg-slate-50 group-hover:bg-white group-hover:shadow-sm"><i class="fa-solid fa-download text-sm"></i></div><span class="font-semibold"><%= typeof t === 'function' ? t('navigation.offlineVideos') : 'Offline Videos' %></span></a>
        </nav>
        <div class="p-3 border-t border-gray-100">
            <a href="/student/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-gear w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.settings') : 'Settings' %></span></a>
            <form action="/logout" method="POST" class="w-full mt-1"><button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-red-500 hover:bg-red-50 hover:text-red-600 text-sm font-medium"><i class="fa-solid fa-arrow-right-from-bracket w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('common.logout') : 'Logout' %></span></button></form>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">
        <!-- Header -->
        <header class="glass border-b border-white/50 sticky top-0 z-10">
            <div class="flex items-center justify-between px-5 sm:px-8 py-3.5">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden w-9 h-9 rounded-xl flex items-center justify-center text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors"><i class="fa-solid fa-bars text-lg"></i></button>
                    <h1 class="text-lg font-bold text-gray-800 hidden sm:block">AI Tutor</h1>
                    <div class="hidden md:flex items-center space-x-5 border-l pl-5 border-gray-200/50 ml-2">
                        <a href="/" class="text-sm text-gray-400 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('common.home') : 'Home' %></a>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="relative group">
                        <button class="inline-flex items-center justify-center rounded-xl px-3 py-2 text-sm font-medium text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors gap-1.5"><i class="fa-solid fa-globe text-lg"></i><span class="hidden sm:inline"><%= locals.language === 'bn' ? 'বাংলা' : 'English' %></span></button>
                        <div class="absolute right-0 mt-1 w-36 bg-white border border-gray-100 rounded-xl shadow-xl shadow-gray-100/50 hidden group-hover:block z-50 overflow-hidden">
                            <button onclick="changeLanguageImmediately('en')" class="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors <%= locals.language === 'en' ? 'font-bold text-indigo-600' : '' %>">English</button>
                            <button onclick="changeLanguageImmediately('bn')" class="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors <%= locals.language === 'bn' ? 'font-bold text-indigo-600' : '' %>">বাংলা</button>
                        </div>
                    </div>
                    <%- include('../partials/student-header-controls') %>
                </div>
            </div>
        </header>

        <!-- Content -->
        <div class="flex-1 flex flex-col overflow-hidden p-4 sm:p-6 lg:p-8 h-full">
            <div class="flex items-center justify-between mb-6 animate-fade-in-up">
                <div>
                    <h2 class="text-2xl font-extrabold text-gray-800 tracking-tight flex items-center gap-3">
                        <span class="w-1.5 h-8 bg-gradient-to-b from-indigo-500 to-purple-500 rounded-full"></span>
                        EduSmart AI Tutor
                    </h2>
                    <p class="text-sm text-gray-500 mt-1 ml-5">Your intelligent learning companion</p>
                </div>
                <div class="px-4 py-2 bg-gradient-to-r from-indigo-50 to-purple-50 text-indigo-700 rounded-xl text-xs font-bold border border-indigo-100 shadow-sm flex items-center gap-2">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                    </span>
                    Gemini Powered
                </div>
            </div>
            
            <div class="flex-1 bg-white/80 rounded-3xl shadow-sm border border-indigo-50 flex flex-col overflow-hidden relative min-h-[400px] backdrop-blur-xl animate-fade-in-up delay-100">
                <!-- Chat History Area -->
                <div class="flex-1 overflow-y-auto p-6 space-y-6 sleek-scrollbar bg-gradient-to-br from-transparent to-indigo-50/30" id="chatContainer">
                    
                    <!-- AI Welcome Message -->
                    <div class="flex items-start gap-4 max-w-3xl message-enter">
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center text-white shrink-0 shadow-md shadow-indigo-200">
                            <i class="fa-solid fa-sparkles text-sm"></i>
                        </div>
                        <div class="bg-white border border-gray-100 p-5 rounded-2xl rounded-tl-sm shadow-sm">
                            <p class="text-gray-800 font-bold mb-2 flex items-center gap-2">EduSmart Tutor <span class="text-[10px] bg-indigo-50 text-indigo-600 px-2.5 py-0.5 rounded-lg font-bold uppercase tracking-wider">AI</span></p>
                            <p class="text-gray-600 leading-relaxed text-[15px]">Hello <%= user.name %>! 👋 I'm your personal AI tutor. I can help you understand difficult concepts, explain math problems, or prepare for your upcoming quizzes. What would you like to learn today?</p>
                        </div>
                    </div>
                    
                </div>
                
                <!-- Chat Input Area -->
                <div class="p-4 glass-panel relative z-10">
                    <form id="aiTutorForm" class="flex flex-col gap-3 max-w-4xl mx-auto">
                        <!-- Image Preview Area -->
                        <div id="imagePreviewContainer" class="hidden flex flex-wrap gap-2 px-2"></div>
                        
                        <div class="flex items-end gap-3 w-full">
                            <div class="flex-1 relative flex items-center bg-white rounded-2xl border border-gray-200 shadow-sm transition-all focus-within:shadow-md focus-within:border-indigo-300">
                                <button type="button" id="micBtn" class="absolute left-4 text-gray-400 hover:text-indigo-600 transition-colors z-10" aria-label="Start voice input" title="Start voice input">
                                    <i class="fa-solid fa-microphone"></i>
                                </button>
                                <textarea id="promptInput" rows="1" class="w-full bg-transparent border-0 py-3.5 pl-12 pr-20 focus:ring-0 focus:outline-none resize-none max-h-32 text-gray-700 placeholder-gray-400 sleek-scrollbar text-[15px]" placeholder="Ask a question or upload a photo..."></textarea>
                                
                                <div class="absolute right-3 flex items-center gap-1.5 z-10">
                                    <button type="button" id="cameraBtn" class="text-gray-400 hover:text-indigo-600 transition-colors w-8 h-8 flex items-center justify-center rounded-lg hover:bg-indigo-50" title="Take a photo">
                                        <i class="fa-solid fa-camera"></i>
                                    </button>
                                    <button type="button" id="attachBtn" class="text-gray-400 hover:text-indigo-600 transition-colors w-8 h-8 flex items-center justify-center rounded-lg hover:bg-indigo-50" title="Attach file">
                                        <i class="fa-solid fa-paperclip"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="submit" class="w-14 h-14 bg-gradient-to-br from-indigo-600 to-purple-600 text-white rounded-2xl flex items-center justify-center shadow-md shadow-indigo-200 transition-all hover:shadow-lg transform hover:-translate-y-1 shrink-0">
                                <i class="fa-solid fa-paper-plane"></i>
                            </button>
                        </div>

                        <!-- Hidden File Inputs -->
                        <input type="file" id="fileInput" accept="image/*,application/pdf" class="hidden" multiple>
                        <input type="file" id="cameraInput" accept="image/*" capture="environment" class="hidden">
                    </form>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                if (isOpen) { sidebar.classList.add('-translate-x-full'); sidebarOverlay.classList.add('hidden'); document.body.classList.remove('overflow-hidden'); }
                else { sidebar.classList.remove('-translate-x-full'); sidebarOverlay.classList.remove('hidden'); document.body.classList.add('overflow-hidden'); }
            };
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            /**
             * AI Tutor Chat Logic
             */
            const aiTutorForm = document.getElementById('aiTutorForm');
            const promptInput = document.getElementById('promptInput');
            const chatContainer = document.getElementById('chatContainer');
            const submitBtn = aiTutorForm.querySelector('button[type="submit"]');
            
            let conversationId = null;

            // Simple markdown parser for basic formatting
            const parseMarkdown = (text) => {
                let html = text
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/`(.*?)`/g, '<code class="bg-gray-100 px-1.5 py-0.5 rounded-lg text-sm text-pink-600 border border-gray-200">$1</code>')
                    .replace(/\n/g, '<br>');
                return html;
            };

            const appendMessage = (sender, text, attachmentsList = []) => {
                const isAI = sender === 'ai';
                
                const wrapper = document.createElement('div');
                wrapper.className = `flex items-start gap-4 max-w-3xl message-enter ${isAI ? '' : 'ml-auto flex-row-reverse'}`;
                
                let iconHtml = '';
                if (isAI) {
                    iconHtml = `
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center text-white shrink-0 shadow-md shadow-indigo-200">
                            <i class="fa-solid fa-sparkles text-sm"></i>
                        </div>
                    `;
                } else {
                    iconHtml = `
                        <div class="w-10 h-10 rounded-2xl bg-white flex items-center justify-center text-gray-500 shrink-0 shadow-sm border border-gray-100">
                            <i class="fa-solid fa-user"></i>
                        </div>
                    `;
                }

                let speakerHtml = '';
                if (isAI && text) {
                    speakerHtml = `
                        <div class="tts-controls flex items-center gap-2 mt-3 pt-3 border-t border-gray-100/60">
                            <button type="button" class="tts-btn text-[11px] font-bold text-gray-400 hover:text-indigo-600 flex items-center gap-1.5 transition-colors uppercase tracking-wider bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100 hover:border-indigo-200 hover:bg-indigo-50" aria-label="Read this response aloud" title="Read this response aloud">
                                <i class="fa-solid fa-volume-up"></i> <span>Listen</span>
                            </button>
                            <button type="button" class="tts-pause-btn text-[11px] font-bold text-gray-400 hover:text-indigo-600 flex items-center gap-1.5 transition-colors uppercase tracking-wider hidden bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100 hover:border-indigo-200 hover:bg-indigo-50" aria-label="Pause speech" title="Pause speech">
                                <i class="fa-solid fa-pause"></i> <span>Pause</span>
                            </button>
                        </div>
                    `;
                }

                let attachHtml = '';
                if (attachmentsList && attachmentsList.length > 0) {
                    attachHtml = `<div class="flex flex-wrap gap-2 mb-3">` + 
                        attachmentsList.map(url => {
                            if (url.startsWith('data:image')) {
                                return `<img src="${url}" class="max-w-[200px] max-h-[200px] rounded-xl border-2 border-white/20 object-cover shadow-sm" />`;
                            } else {
                                return `<div class="bg-black/10 px-3 py-2 rounded-xl text-sm flex items-center gap-2 border border-white/20 font-medium"><i class="fa-solid fa-file-pdf"></i> Document</div>`;
                            }
                        }).join('') + 
                    `</div>`;
                }

                const bubbleHtml = `
                    <div class="${isAI ? 'bg-white border border-gray-100 rounded-tl-sm' : 'bg-gradient-to-br from-indigo-600 to-purple-600 text-white rounded-tr-sm shadow-md shadow-indigo-200/50'} p-5 rounded-2xl shadow-sm">
                        ${isAI ? '<p class="text-gray-800 font-bold mb-2 flex items-center gap-2">EduSmart Tutor <span class="text-[10px] bg-indigo-50 text-indigo-600 px-2.5 py-0.5 rounded-lg font-bold uppercase tracking-wider">AI</span></p>' : ''}
                        <div class="${isAI ? 'text-gray-600' : 'text-indigo-50'} leading-relaxed overflow-x-auto whitespace-pre-wrap text-[15px]">${attachHtml}${isAI ? parseMarkdown(text) : text}</div>
                        ${speakerHtml}
                    </div>
                `;

                wrapper.innerHTML = iconHtml + bubbleHtml;
                chatContainer.appendChild(wrapper);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                return wrapper;
            };

            const appendLoading = () => {
                const wrapper = document.createElement('div');
                wrapper.id = "ai-loading";
                wrapper.className = "flex items-start gap-4 max-w-3xl message-enter";
                wrapper.innerHTML = `
                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center text-white shrink-0 shadow-md shadow-indigo-200">
                        <i class="fa-solid fa-sparkles text-sm"></i>
                    </div>
                    <div class="bg-white border border-gray-100 p-5 rounded-2xl rounded-tl-sm shadow-sm flex items-center gap-2 h-[68px]">
                        <div class="w-2 h-2 bg-indigo-400 rounded-full typing-dot"></div>
                        <div class="w-2 h-2 bg-purple-400 rounded-full typing-dot"></div>
                        <div class="w-2 h-2 bg-pink-400 rounded-full typing-dot"></div>
                    </div>
                `;
                chatContainer.appendChild(wrapper);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                return wrapper;
            };

            // Initialize Voice Utilities
            const userLang = 'en-US'; // Can be dynamically set based on user profile if available
            
            const stt = new EduSmartSpeechToText({
                language: userLang,
                onResult: (res) => {
                    // Update input with interim or final results
                    let currentVal = promptInput.value.replace(/\s*\[.*\]$/, ''); // Remove previous interim
                    if (res.final) {
                        promptInput.value = currentVal + (currentVal ? ' ' : '') + res.final;
                    } else if (res.interim) {
                        promptInput.value = currentVal + (currentVal ? ' ' : '') + `[${res.interim}]`;
                    }
                },
                onStateChange: (state) => {
                    const micBtn = document.getElementById('micBtn');
                    if(!micBtn) return;
                    const micIcon = micBtn.querySelector('i');
                    if (state === 'LISTENING' || state === 'PROCESSING') {
                        micBtn.classList.add('text-rose-500');
                        micBtn.classList.remove('text-gray-400');
                        micIcon.className = 'fa-solid fa-microphone-lines animate-pulse';
                        micBtn.setAttribute('aria-label', 'Stop voice input');
                        micBtn.setAttribute('title', 'Stop voice input');
                    } else {
                        // Clean up interim markers if any
                        promptInput.value = promptInput.value.replace(/\s*\[.*\]$/, '');
                        
                        micBtn.classList.remove('text-rose-500');
                        micBtn.classList.add('text-gray-400');
                        micIcon.className = 'fa-solid fa-microphone';
                        micBtn.setAttribute('aria-label', 'Start voice input');
                        micBtn.setAttribute('title', 'Start voice input');
                    }
                },
                onError: (err) => {
                    appendMessage('ai', `**Voice Input Error:** ${err}`);
                }
            });

            const tts = new EduSmartTextToSpeech({
                language: userLang
            });

            if(document.getElementById('micBtn')) {
                document.getElementById('micBtn').addEventListener('click', () => {
                    stt.toggle();
                });
            }

            // Delegate TTS button clicks
            chatContainer.addEventListener('click', (e) => {
                const pauseBtn = e.target.closest('.tts-pause-btn');
                if (pauseBtn) {
                    const isPaused = pauseBtn.classList.contains('paused');
                    if (isPaused) {
                        tts.resume();
                    } else {
                        tts.pause();
                    }
                    return;
                }
                
                const btn = e.target.closest('.tts-btn');
                if (btn) {
                    const textContainer = btn.parentElement.parentElement.querySelector('.text-gray-600');
                    if (textContainer) {
                        const isCurrentlyPlaying = btn.classList.contains('playing');
                        const controlsContainer = btn.closest('.tts-controls');
                        const currentPauseBtn = controlsContainer ? controlsContainer.querySelector('.tts-pause-btn') : null;
                        
                        // Reset all buttons
                        document.querySelectorAll('.tts-btn').forEach(b => {
                            b.classList.remove('playing', 'text-indigo-600', 'border-indigo-200', 'bg-indigo-50');
                            b.classList.add('text-gray-400');
                            const i = b.querySelector('i');
                            if(i) i.className = 'fa-solid fa-volume-up';
                            const span = b.querySelector('span');
                            if(span) span.innerText = 'Listen';
                            b.setAttribute('aria-label', 'Read this response aloud');
                        });
                        document.querySelectorAll('.tts-pause-btn').forEach(pb => {
                            pb.classList.add('hidden');
                            pb.classList.remove('paused', 'text-indigo-600', 'border-indigo-200', 'bg-indigo-50');
                            pb.classList.add('text-gray-400');
                            const pi = pb.querySelector('i');
                            if (pi) pi.className = 'fa-solid fa-pause';
                            const pspan = pb.querySelector('span');
                            if (pspan) pspan.innerText = 'Pause';
                            pb.setAttribute('aria-label', 'Pause reading');
                            pb.setAttribute('title', 'Pause reading');
                        });

                        if (isCurrentlyPlaying) {
                            tts.stop();
                        } else {
                            btn.classList.add('playing', 'text-indigo-600', 'border-indigo-200', 'bg-indigo-50');
                            btn.classList.remove('text-gray-400');
                            const i = btn.querySelector('i');
                            if(i) i.className = 'fa-solid fa-circle-stop animate-pulse';
                            const span = btn.querySelector('span');
                            if(span) span.innerText = 'Stop';
                            btn.setAttribute('aria-label', 'Stop reading');
                            
                            if (currentPauseBtn) {
                                currentPauseBtn.classList.remove('hidden');
                            }
                            
                            tts.onStateChange = (state) => {
                                if (state === 'STOPPED' || state === 'ERROR') {
                                    btn.classList.remove('playing', 'text-indigo-600', 'border-indigo-200', 'bg-indigo-50');
                                    btn.classList.add('text-gray-400');
                                    const bi = btn.querySelector('i');
                                    if(bi) bi.className = 'fa-solid fa-volume-up';
                                    const bspan = btn.querySelector('span');
                                    if(bspan) bspan.innerText = 'Listen';
                                    btn.setAttribute('aria-label', 'Read this response aloud');
                                    
                                    if (currentPauseBtn) {
                                        currentPauseBtn.classList.add('hidden');
                                        currentPauseBtn.classList.remove('paused', 'text-indigo-600', 'border-indigo-200', 'bg-indigo-50');
                                        currentPauseBtn.classList.add('text-gray-400');
                                        const pi = currentPauseBtn.querySelector('i');
                                        if (pi) pi.className = 'fa-solid fa-pause';
                                        const pspan = currentPauseBtn.querySelector('span');
                                        if (pspan) pspan.innerText = 'Pause';
                                    }
                                } else if (state === 'PAUSED') {
                                    if (currentPauseBtn) {
                                        currentPauseBtn.classList.add('paused', 'text-indigo-600', 'border-indigo-200', 'bg-indigo-50');
                                        currentPauseBtn.classList.remove('text-gray-400');
                                        const pi = currentPauseBtn.querySelector('i');
                                        if (pi) pi.className = 'fa-solid fa-play';
                                        const pspan = currentPauseBtn.querySelector('span');
                                        if (pspan) pspan.innerText = 'Resume';
                                        currentPauseBtn.setAttribute('aria-label', 'Resume reading');
                                        currentPauseBtn.setAttribute('title', 'Resume reading');
                                    }
                                    const bi = btn.querySelector('i');
                                    if (bi) bi.classList.remove('animate-pulse');
                                } else if (state === 'PLAYING') {
                                    if (currentPauseBtn) {
                                        currentPauseBtn.classList.remove('hidden');
                                        currentPauseBtn.classList.remove('paused', 'text-indigo-600', 'border-indigo-200', 'bg-indigo-50');
                                        currentPauseBtn.classList.add('text-gray-400');
                                        const pi = currentPauseBtn.querySelector('i');
                                        if (pi) pi.className = 'fa-solid fa-pause';
                                        const pspan = currentPauseBtn.querySelector('span');
                                        if (pspan) pspan.innerText = 'Pause';
                                        currentPauseBtn.setAttribute('aria-label', 'Pause reading');
                                        currentPauseBtn.setAttribute('title', 'Pause reading');
                                    }
                                    const bi = btn.querySelector('i');
                                    if (bi) bi.classList.add('animate-pulse');
                                }
                            };
                            
                            tts.speak(textContainer.innerText);
                        }
                    }
                }
            });

            // File Attachment Logic
            const fileInput = document.getElementById('fileInput');
            const cameraInput = document.getElementById('cameraInput');
            const attachBtn = document.getElementById('attachBtn');
            const cameraBtn = document.getElementById('cameraBtn');
            const imagePreviewContainer = document.getElementById('imagePreviewContainer');
            
            let currentAttachments = [];

            const handleFiles = (files) => {
                Array.from(files).forEach(file => {
                    if (!file.type.startsWith('image/') && file.type !== 'application/pdf') {
                        alert('Unsupported file type. Please upload images or PDFs.');
                        return;
                    }
                    
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const base64Data = e.target.result.split(',')[1];
                        const id = Date.now().toString(36) + Math.random().toString(36).substr(2);
                        
                        currentAttachments.push({
                            id,
                            data: base64Data,
                            mimeType: file.type,
                            dataUrl: e.target.result
                        });
                        
                        renderPreviews();
                    };
                    reader.readAsDataURL(file);
                });
            };

            const renderPreviews = () => {
                imagePreviewContainer.innerHTML = '';
                if (currentAttachments.length > 0) {
                    imagePreviewContainer.classList.remove('hidden');
                    currentAttachments.forEach(att => {
                        const previewWrapper = document.createElement('div');
                        previewWrapper.className = 'relative w-16 h-16 rounded-xl overflow-hidden border-2 border-white shadow-md group mt-3';
                        
                        if (att.mimeType.startsWith('image/')) {
                            previewWrapper.innerHTML = `
                                <img src="${att.dataUrl}" class="w-full h-full object-cover" />
                                <button type="button" class="absolute top-1 right-1 bg-black/60 hover:bg-rose-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-sm" onclick="removeAttachment('${att.id}')">
                                    <i class="fa-solid fa-times"></i>
                                </button>
                            `;
                        } else {
                            previewWrapper.innerHTML = `
                                <div class="w-full h-full bg-indigo-50 flex items-center justify-center text-indigo-400">
                                    <i class="fa-solid fa-file-pdf text-xl"></i>
                                </div>
                                <button type="button" class="absolute top-1 right-1 bg-black/60 hover:bg-rose-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-sm" onclick="removeAttachment('${att.id}')">
                                    <i class="fa-solid fa-times"></i>
                                </button>
                            `;
                        }
                        imagePreviewContainer.appendChild(previewWrapper);
                    });
                } else {
                    imagePreviewContainer.classList.add('hidden');
                }
            };

            window.removeAttachment = (id) => {
                currentAttachments = currentAttachments.filter(att => att.id !== id);
                renderPreviews();
            };

            if (attachBtn) attachBtn.addEventListener('click', () => fileInput.click());
            if (cameraBtn) cameraBtn.addEventListener('click', () => cameraInput.click());
            
            if (fileInput) fileInput.addEventListener('change', (e) => { handleFiles(e.target.files); fileInput.value = ''; });
            if (cameraInput) cameraInput.addEventListener('change', (e) => { handleFiles(e.target.files); cameraInput.value = ''; });

            // Enter to submit (Shift+Enter for newline)
            promptInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if(promptInput.value.trim() !== '' || currentAttachments.length > 0) {
                        aiTutorForm.dispatchEvent(new Event('submit'));
                    }
                }
            });

            aiTutorForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const text = promptInput.value.trim();
                
                // Allow submitting if there's text OR attachments
                if (!text && currentAttachments.length === 0) return;

                // Extract attachments and render them locally in bubble
                const sentAttachments = [...currentAttachments];
                const previewUrls = sentAttachments.map(a => a.dataUrl);

                // Append user message
                appendMessage('user', text, previewUrls);
                
                promptInput.value = '';
                currentAttachments = [];
                renderPreviews();
                
                // Disable input and show loading
                promptInput.disabled = true;
                submitBtn.disabled = true;
                const loadingIndicator = appendLoading();

                try {
                    const response = await fetch('/api/ai/chat', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            message: text,
                            conversationId: conversationId,
                            stream: true,
                            attachments: sentAttachments.map(a => ({
                                data: a.data,
                                mimeType: a.mimeType
                            }))
                        })
                    });

                    loadingIndicator.remove();

                    if (!response.ok) {
                        let errMsg = "Unknown error";
                        try {
                            const errData = await response.json();
                            errMsg = errData.error || errMsg;
                        } catch(e) {}
                        appendMessage('ai', "Sorry, I encountered an error: " + errMsg);
                        return;
                    }

                    // Create empty bubble for streaming
                    const aiBubble = appendMessage('ai', "");
                    const textContainer = aiBubble.querySelector('.text-gray-600');
                    let fullText = "";

                    const reader = response.body.getReader();
                    const decoder = new TextDecoder();
                    let buffer = "";

                    while (true) {
                        const { done, value } = await reader.read();
                        if (done) break;
                        
                        buffer += decoder.decode(value, { stream: true });
                        
                        let boundary = buffer.indexOf('\n\n');
                        while (boundary !== -1) {
                            const chunk = buffer.slice(0, boundary).replace(/^data:\s*/, '').trim();
                            buffer = buffer.slice(boundary + 2);
                            
                            if (chunk === '[DONE]') break;
                            
                            if (chunk) {
                                try {
                                    const parsed = JSON.parse(chunk);
                                    if (parsed.type === 'meta') {
                                        conversationId = parsed.conversationId;
                                    } else if (parsed.type === 'chunk') {
                                        fullText += parsed.text;
                                        textContainer.innerHTML = parseMarkdown(fullText);
                                        chatContainer.scrollTop = chatContainer.scrollHeight;
                                    } else if (parsed.type === 'error') {
                                        fullText += "\n\n**Error:** " + parsed.message;
                                        textContainer.innerHTML = parseMarkdown(fullText);
                                        chatContainer.scrollTop = chatContainer.scrollHeight;
                                    }
                                    
                                    // Make sure TTS button is added if it was a streamed response
                                    if (!aiBubble.querySelector('.tts-btn') && fullText.length > 0) {
                                        const speakerHtml = `
                                            <div class="tts-controls flex gap-2 mt-3 pt-3 border-t border-gray-100/60">
                                                <button type="button" class="tts-btn text-[11px] font-bold text-gray-400 hover:text-indigo-600 flex items-center gap-1.5 transition-colors uppercase tracking-wider bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100 hover:border-indigo-200 hover:bg-indigo-50" aria-label="Read this response aloud" title="Read this response aloud">
                                                    <i class="fa-solid fa-volume-up"></i> <span>Listen</span>
                                                </button>
                                                <button type="button" class="tts-pause-btn hidden text-[11px] font-bold text-gray-400 hover:text-indigo-600 flex items-center gap-1.5 transition-colors uppercase tracking-wider bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100 hover:border-indigo-200 hover:bg-indigo-50" aria-label="Pause reading" title="Pause reading">
                                                    <i class="fa-solid fa-pause"></i> <span>Pause</span>
                                                </button>
                                            </div>
                                        `;
                                        textContainer.insertAdjacentHTML('afterend', speakerHtml);
                                    }
                                } catch (e) {
                                    console.error("Error parsing chunk:", e, chunk);
                                }
                            }
                            boundary = buffer.indexOf('\n\n');
                        }
                    }
                } catch (err) {
                    console.error(err);
                    loadingIndicator.remove();
                    appendMessage('ai', "Network error. Please try again later.");
                } finally {
                    promptInput.disabled = false;
                    submitBtn.disabled = false;
                    promptInput.focus();
                }
            });

            const loadHistory = async () => {
                try {
                    const histRes = await fetch('/api/ai/history');
                    const histData = await histRes.json();
                    
                    if (histData.success && histData.conversations && histData.conversations.length > 0) {
                        conversationId = histData.conversations[0]._id;
                        
                        const msgRes = await fetch(`/api/ai/history/${conversationId}/messages`);
                        const msgData = await msgRes.json();
                        
                        if (msgData.success && msgData.messages && msgData.messages.length > 0) {
                            // Clear welcome message
                            chatContainer.innerHTML = '';
                            
                            msgData.messages.forEach(msg => {
                                appendMessage(msg.sender, msg.content);
                            });
                        }
                    }
                } catch (e) {
                    console.error("Failed to load history", e);
                }
            };

            if ('indexedDB' in window) {
                // Future IndexedDB implementation placeholder
                console.log('IndexedDB is supported. Ready for offline mode caching.');
            }

            // Load history then check for initial query
            loadHistory().then(() => {
                const urlParams = new URLSearchParams(window.location.search);
                const initialQuery = urlParams.get('initialQuery');
                
                if (initialQuery) {
                    promptInput.value = initialQuery;
                    // clear URL without reloading
                    window.history.replaceState({}, document.title, window.location.pathname);
                    // simulate submit
                    aiTutorForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
                }
            });
        });
    </script>
    <%- include('../partials/language-modal') %>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
