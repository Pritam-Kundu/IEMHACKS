<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS (CDN for rapid hackathon setup, can be replaced with build later) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Dashboard-specific custom styles */
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        /* Sidebar styling */
        .sidebar-active { 
            background-color: #e0e7ff; 
            color: #4f46e5; 
            font-weight: 600; 
            border-right: 4px solid #4f46e5; 
        }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { 
            background-color: #f1f5f9; 
            color: #334155; 
        }
        
        /* Utility */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/student/dashboard" class="flex items-center gap-2 text-indigo-600 hover:text-indigo-700 transition-colors">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
                <span class="font-mono text-xl font-bold tracking-tight text-slate-900">EduSmart</span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/student/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-house w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/student/courses" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                <span>My Courses</span>
            </a>
            <a href="/student/quizzes" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-clipboard-question w-5 text-center"></i>
                <span>Quizzes</span>
            </a>
            <a href="/student/ai-tutor" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-robot w-5 text-center"></i>
                <span>AI Tutor</span>
            </a>
            <a href="/student/progress" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span>Progress</span>
            </a>
            <a href="/student/leaderboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-trophy w-5 text-center"></i>
                <span>Leaderboard</span>
            </a>
            <a href="/student/badges" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span>Badges</span>
            </a>
            <a href="/student/offline-videos" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-download w-5 text-center"></i>
                <span>Offline Videos</span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/student/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
            <!-- Using existing logout flow -->
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block mr-6">AI Tutor</h1>
                    
                    <!-- Global Links -->
                    <div class="hidden md:flex items-center space-x-6 border-l pl-6 border-slate-200">
                        <a href="/" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">Home</a>
                        <a href="/#features" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">Features</a>
                        <a href="/#how-it-works" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">How it Works</a>
                        <a href="/#about" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">About</a>
                    </div>
                </div>
                
                <div class="flex items-center gap-5">
                    <button class="relative text-slate-500 hover:text-indigo-600 transition-colors focus:outline-none">
                        <i class="fa-regular fa-bell text-xl"></i>
                        <!-- Notification indicator (example active state) -->
                        <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    
                    <a href="/student/profile" class="flex items-center gap-3 cursor-pointer group">
                        <img src="<%= user.profilePicture || '/images/default-avatar.png' %>" alt="Profile" class="w-9 h-9 rounded-full object-cover border-2 border-indigo-100 group-hover:border-indigo-300 transition-colors">
                        <div class="hidden md:block">
                            <p class="text-sm font-semibold text-slate-800"><%= user.name %></p>
                            <p class="text-xs text-slate-500 capitalize"><%= user.role %></p>
                        </div>
                    </a>
                </div>
            </div>
        </header>

        
        <!-- Dashboard Content -->

        <div class="flex-1 flex flex-col overflow-hidden p-4 sm:p-6 lg:p-8 h-full">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-slate-800">EduSmart AI Tutor</h2>
                <div class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-xs font-bold border border-purple-200">
                    <i class="fa-solid fa-bolt mr-1"></i> Gemini Powered
                </div>
            </div>
            
            <div class="flex-1 bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden relative min-h-[400px]">
                <!-- Chat History Area -->
                <div class="flex-1 overflow-y-auto p-6 space-y-6 bg-slate-50" id="chatContainer">
                    
                    <!-- AI Welcome Message -->
                    <div class="flex items-start gap-4 max-w-3xl">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shrink-0 shadow-md">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-none shadow-sm">
                            <p class="text-slate-700 font-medium mb-1">EduSmart Tutor</p>
                            <p class="text-slate-600 leading-relaxed">Hello <%= user.name %>! 👋 I'm your personal AI tutor. I can help you understand difficult concepts, explain math problems, or prepare for your upcoming quizzes. What would you like to learn today?</p>
                        </div>
                    </div>
                    
                </div>
                
                <!-- Chat Input Area -->
                <div class="p-4 bg-white border-t border-slate-200">
                    <form id="aiTutorForm" class="flex items-end gap-3 max-w-4xl mx-auto">
                        <div class="flex-1 relative">
                            <textarea id="promptInput" rows="1" class="w-full bg-slate-100 border-0 rounded-2xl py-3 pl-4 pr-12 focus:ring-2 focus:ring-indigo-500 resize-none max-h-32" placeholder="Ask a question about your courses..."></textarea>
                            <button type="button" class="absolute right-3 bottom-3 text-slate-400 hover:text-indigo-600 transition-colors">
                                <i class="fa-solid fa-paperclip"></i>
                            </button>
                        </div>
                        <button type="submit" class="w-12 h-12 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full flex items-center justify-center shadow-md transition-colors shrink-0">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- Page Specific Scripts -->
<!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden'); // Restore body scroll
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden'); // Prevent body scroll
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            /**
             * AI Tutor Chat Logic
             */
            const aiTutorForm = document.getElementById('aiTutorForm');
            const promptInput = document.getElementById('promptInput');
            const chatContainer = document.getElementById('chatContainer');
            const submitBtn = aiTutorForm.querySelector('button[type="submit"]');
            
            let conversationId = null;

            // Simple markdown parser for basic formatting
            const parseMarkdown = (text) => {
                let html = text
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/`(.*?)`/g, '<code class="bg-slate-200 px-1 py-0.5 rounded text-sm text-pink-600">$1</code>')
                    .replace(/\n/g, '<br>');
                return html;
            };

            const appendMessage = (sender, text) => {
                const isAI = sender === 'ai';
                
                const wrapper = document.createElement('div');
                wrapper.className = `flex items-start gap-4 max-w-3xl ${isAI ? '' : 'ml-auto flex-row-reverse'}`;
                
                let iconHtml = '';
                if (isAI) {
                    iconHtml = `
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shrink-0 shadow-md">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                    `;
                } else {
                    iconHtml = `
                        <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 shrink-0 shadow-sm border border-slate-300">
                            <i class="fa-solid fa-user"></i>
                        </div>
                    `;
                }

                const bubbleHtml = `
                    <div class="${isAI ? 'bg-white border border-slate-200 rounded-tl-none' : 'bg-indigo-600 text-white rounded-tr-none'} p-4 rounded-2xl shadow-sm">
                        ${isAI ? '<p class="text-slate-700 font-medium mb-1">EduSmart Tutor</p>' : ''}
                        <div class="${isAI ? 'text-slate-600' : 'text-indigo-50'} leading-relaxed overflow-x-auto whitespace-pre-wrap">${isAI ? parseMarkdown(text) : text}</div>
                    </div>
                `;

                wrapper.innerHTML = isAI ? iconHtml + bubbleHtml : iconHtml + bubbleHtml;
                chatContainer.appendChild(wrapper);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                return wrapper;
            };

            const appendLoading = () => {
                const wrapper = document.createElement('div');
                wrapper.id = "ai-loading";
                wrapper.className = "flex items-start gap-4 max-w-3xl";
                wrapper.innerHTML = `
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shrink-0 shadow-md">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div class="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-none shadow-sm flex gap-1 items-center h-14">
                        <div class="w-2 h-2 bg-indigo-400 rounded-full animate-bounce" style="animation-delay: 0s"></div>
                        <div class="w-2 h-2 bg-indigo-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                        <div class="w-2 h-2 bg-indigo-400 rounded-full animate-bounce" style="animation-delay: 0.4s"></div>
                    </div>
                `;
                chatContainer.appendChild(wrapper);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                return wrapper;
            };

            // Enter to submit (Shift+Enter for newline)
            promptInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if(promptInput.value.trim() !== '') {
                        aiTutorForm.dispatchEvent(new Event('submit'));
                    }
                }
            });

            aiTutorForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const text = promptInput.value.trim();
                if (!text) return;

                // Append user message
                appendMessage('user', text);
                promptInput.value = '';
                
                // Disable input and show loading
                promptInput.disabled = true;
                submitBtn.disabled = true;
                const loadingIndicator = appendLoading();

                try {
                    const response = await fetch('/api/ai/chat', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            message: text,
                            conversationId: conversationId,
                            stream: true
                        })
                    });

                    loadingIndicator.remove();

                    if (!response.ok) {
                        let errMsg = "Unknown error";
                        try {
                            const errData = await response.json();
                            errMsg = errData.error || errMsg;
                        } catch(e) {}
                        appendMessage('ai', "Sorry, I encountered an error: " + errMsg);
                        return;
                    }

                    // Create empty bubble for streaming
                    const aiBubble = appendMessage('ai', "");
                    const textContainer = aiBubble.querySelector('.text-slate-600');
                    let fullText = "";

                    const reader = response.body.getReader();
                    const decoder = new TextDecoder();
                    let buffer = "";

                    while (true) {
                        const { done, value } = await reader.read();
                        if (done) break;
                        
                        buffer += decoder.decode(value, { stream: true });
                        
                        let boundary = buffer.indexOf('\n\n');
                        while (boundary !== -1) {
                            const chunk = buffer.slice(0, boundary).replace(/^data:\s*/, '').trim();
                            buffer = buffer.slice(boundary + 2);
                            
                            if (chunk === '[DONE]') break;
                            
                            if (chunk) {
                                try {
                                    const parsed = JSON.parse(chunk);
                                    if (parsed.type === 'meta') {
                                        conversationId = parsed.conversationId;
                                    } else if (parsed.type === 'chunk') {
                                        fullText += parsed.text;
                                        textContainer.innerHTML = parseMarkdown(fullText);
                                        chatContainer.scrollTop = chatContainer.scrollHeight;
                                    } else if (parsed.type === 'error') {
                                        fullText += "\n\n**Error:** " + parsed.message;
                                        textContainer.innerHTML = parseMarkdown(fullText);
                                        chatContainer.scrollTop = chatContainer.scrollHeight;
                                    }
                                } catch (e) {
                                    console.error("Error parsing chunk:", e, chunk);
                                }
                            }
                            boundary = buffer.indexOf('\n\n');
                        }
                    }
                } catch (err) {
                    console.error(err);
                    loadingIndicator.remove();
                    appendMessage('ai', "Network error. Please try again later.");
                } finally {
                    promptInput.disabled = false;
                    submitBtn.disabled = false;
                    promptInput.focus();
                }
            });

            if ('indexedDB' in window) {
                // Future IndexedDB implementation placeholder
                console.log('IndexedDB is supported. Ready for offline mode caching.');
            }
        });
    </script>
</body>
</html>
