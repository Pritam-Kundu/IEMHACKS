            </a>
                        <a href="/student/badges" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.badges') : 'Badges' %></span>
            </a>
            <a href="/student/offline-videos" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-download w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.offlineVideos') : 'Offline Videos' %></span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/student/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.settings') : 'Settings' %></span>
            </a>
            <!-- Using existing logout flow -->
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span><%= typeof t === 'function' ? t('common.logout') : 'Logout' %></span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block mr-6">AI Tutor</h1>
                    
                    <!-- Global Links -->
                    <div class="hidden md:flex items-center space-x-6 border-l pl-6 border-slate-200">
                        <a href="/" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('common.home') : 'Home' %></a>
                        <a href="/#features" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('home.featuresHeader') : 'Features' %></a>
                        <a href="/#how-it-works" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('home.howItWorks') : 'How it Works' %></a>
                        <a href="/#about" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('nav.aboutUs') : 'About' %></a>
                    </div>
                </div>
                
                <div class="flex items-center gap-5">
                    
                    <!-- Language Switcher -->
                    <div class="relative group mr-2">
                        <button class="inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors gap-1">
                            <i class="fa-solid fa-globe text-xl"></i>
                            <%= locals.language === 'bn' ? 'বাংলা' : 'English' %>
                        </button>
                        <div class="absolute right-0 mt-0 w-32 bg-white border border-slate-200 rounded-md shadow-lg hidden group-hover:block z-50 overflow-hidden">
                            <button onclick="changeLanguageImmediately('en')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'en' ? 'font-bold' : '' %>">English</button>
                            <button onclick="changeLanguageImmediately('bn')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'bn' ? 'font-bold' : '' %>">বাংলা</button>
                        </div>
                    </div>

                    <%- include('../partials/student-header-controls') %>
                </div>
            </div>
        </header>

        
        <!-- Dashboard Content -->

        <div class="flex-1 flex flex-col overflow-hidden p-4 sm:p-6 lg:p-8 h-full bg-slate-50/50">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-slate-800 tracking-tight">EduSmart AI Tutor</h2>
                    <p class="text-sm text-slate-500 mt-1">Your intelligent learning companion</p>
                </div>
                <div class="px-4 py-1.5 bg-gradient-to-r from-purple-100 to-indigo-100 text-indigo-700 rounded-full text-xs font-bold border border-indigo-200/50 shadow-sm flex items-center gap-2">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                    </span>
                    Gemini Powered
                </div>
            </div>
            
            <div class="flex-1 bg-white/80 rounded-2xl shadow-sm border border-slate-200/60 flex flex-col overflow-hidden relative min-h-[400px] backdrop-blur-sm">
                <!-- Chat History Area -->
                <div class="flex-1 overflow-y-auto p-6 space-y-6 sleek-scrollbar bg-gradient-to-br from-transparent to-indigo-50/20" id="chatContainer">
                    
                    <!-- AI Welcome Message -->
                    <div class="flex items-start gap-4 max-w-3xl message-enter">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center text-white shrink-0 shadow-md ring-2 ring-white">
                            <i class="fa-solid fa-sparkles text-sm"></i>
                        </div>
                        <div class="bg-white border border-slate-100 p-5 rounded-2xl rounded-tl-sm shadow-sm">
                            <p class="text-slate-800 font-semibold mb-2 flex items-center gap-2">EduSmart Tutor <span class="text-[10px] bg-indigo-50 text-indigo-600 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">AI</span></p>
                            <p class="text-slate-600 leading-relaxed text-[15px]">Hello <%= user.name %>! 👋 I'm your personal AI tutor. I can help you understand difficult concepts, explain math problems, or prepare for your upcoming quizzes. What would you like to learn today?</p>
                        </div>
                    </div>
                    
                </div>
                
                <!-- Chat Input Area -->
                <div class="p-4 glass-panel relative z-10">
                    <form id="aiTutorForm" class="flex flex-col gap-3 max-w-4xl mx-auto">
                        <!-- Image Preview Area -->
                        <div id="imagePreviewContainer" class="hidden flex flex-wrap gap-2 px-2"></div>
                        
                        <div class="flex items-end gap-3 w-full">
                            <div class="flex-1 relative flex items-center bg-white rounded-2xl border border-slate-200 shadow-sm transition-all focus-within:shadow-md focus-within:border-indigo-300">
                                <button type="button" id="micBtn" class="absolute left-4 text-slate-400 hover:text-indigo-600 transition-colors z-10" aria-label="Start voice input" title="Start voice input">
                                    <i class="fa-solid fa-microphone"></i>
                                </button>
                                <textarea id="promptInput" rows="1" class="w-full bg-transparent border-0 py-3.5 pl-12 pr-20 focus:ring-0 focus:outline-none resize-none max-h-32 text-slate-700 placeholder-slate-400 sleek-scrollbar" placeholder="Ask a question or upload a photo..."></textarea>
                                
                                <div class="absolute right-3 flex items-center gap-1 z-10">
                                    <button type="button" id="cameraBtn" class="text-slate-400 hover:text-indigo-600 transition-colors p-1.5 rounded-md hover:bg-slate-100" title="Take a photo">
                                        <i class="fa-solid fa-camera"></i>
                                    </button>
                                    <button type="button" id="attachBtn" class="text-slate-400 hover:text-indigo-600 transition-colors p-1.5 rounded-md hover:bg-slate-100" title="Attach file">
                                        <i class="fa-solid fa-paperclip"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="submit" class="w-12 h-12 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white rounded-2xl flex items-center justify-center shadow-md transition-all hover:shadow-lg transform hover:-translate-y-0.5 shrink-0">
                                <i class="fa-solid fa-paper-plane"></i>
                            </button>
