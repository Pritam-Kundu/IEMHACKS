<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #fef3f2 100%); min-height: 100vh; }
        .sidebar-item { transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); }
        .sidebar-item:hover:not(.sidebar-active) { background: linear-gradient(135deg, #eef2ff, #f5f3ff); color: #4f46e5; transform: translateX(4px); }
        .sidebar-active { background: linear-gradient(135deg, #4f46e5, #6366f1); color: #fff !important; border-radius: 12px; box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3); }
        .sidebar-active i { color: #fff !important; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
        .delay-100 { animation-delay: 0.1s; } .delay-200 { animation-delay: 0.2s; } .delay-300 { animation-delay: 0.3s; }
        .card-hover { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .card-hover:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08); }
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
        .scrollbar-thin::-webkit-scrollbar { width: 5px; } .scrollbar-thin::-webkit-scrollbar-track { background: transparent; } .scrollbar-thin::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-gray-800">
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-20 hidden lg:hidden transition-opacity"></div>
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-[260px] bg-white/90 backdrop-blur-xl border-r border-indigo-100/50 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col shadow-lg shadow-indigo-100/20">
        <div class="p-5 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2.5 group"><div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-blue-500 flex items-center justify-center shadow-md shadow-indigo-200/50"><i class="fa-solid fa-graduation-cap text-white text-lg"></i></div><div><span class="font-extrabold text-lg text-gray-900 tracking-tight">EduSmart</span><span class="block text-[10px] font-semibold text-indigo-500 uppercase tracking-widest -mt-0.5">Student</span></div></a>
            <button id="closeSidebarBtn" class="lg:hidden w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors"><i class="fa-solid fa-xmark text-lg"></i></button>
        </div>
        <nav class="flex-1 px-3 py-2 space-y-1 overflow-y-auto scrollbar-thin">
            <a href="/student/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-house w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.dashboard') : 'Dashboard' %></span></a>
            <a href="/student/courses" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-book-open w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.myCourses') : 'My Courses' %></span></a>
            <a href="/student/quizzes" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-clipboard-question w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.quizzes') : 'Quizzes' %></span></a>
            <a href="/student/ai-tutor" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-robot w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.aiTutor') : 'AI Tutor' %></span></a>
            <a href="/student/progress" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-chart-line w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.progress') : 'Progress' %></span></a>
            <a href="/student/leaderboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-trophy w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.leaderboard') : 'Leaderboard' %></span></a>
            <a href="/student/badges" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-medal w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.badges') : 'Badges' %></span></a>
            <a href="/student/offline-videos" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-download w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.offlineVideos') : 'Offline Videos' %></span></a>
        </nav>
        <div class="p-3 border-t border-gray-100">
            <a href="/student/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 text-sm font-medium"><i class="fa-solid fa-gear w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('navigation.settings') : 'Settings' %></span></a>
            <form action="/logout" method="POST" class="w-full mt-1"><button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-xl text-red-500 hover:bg-red-50 hover:text-red-600 text-sm font-medium"><i class="fa-solid fa-arrow-right-from-bracket w-5 text-center text-base"></i><span><%= typeof t === 'function' ? t('common.logout') : 'Logout' %></span></button></form>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-screen lg:ml-[260px] w-full">
        <header class="glass border-b border-white/50 sticky top-0 z-10">
            <div class="flex items-center justify-between px-5 sm:px-8 py-3.5">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden w-9 h-9 rounded-xl flex items-center justify-center text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors"><i class="fa-solid fa-bars text-lg"></i></button>
                    <h1 class="text-lg font-bold text-gray-800 hidden sm:block">Quizzes</h1>
                    <div class="hidden md:flex items-center space-x-5 border-l pl-5 border-gray-200/50 ml-2">
                        <a href="/" class="text-sm text-gray-400 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('common.home') : 'Home' %></a>
                        <a href="/#features" class="text-sm text-gray-400 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('home.featuresHeader') : 'Features' %></a>
                        <a href="/#how-it-works" class="text-sm text-gray-400 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('home.howItWorks') : 'How it Works' %></a>
                        <a href="/#about" class="text-sm text-gray-400 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('nav.aboutUs') : 'About' %></a>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="relative group">
                        <button class="inline-flex items-center justify-center rounded-xl px-3 py-2 text-sm font-medium text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors gap-1.5"><i class="fa-solid fa-globe text-lg"></i><span class="hidden sm:inline"><%= locals.language === 'bn' ? 'বাংলা' : 'English' %></span></button>
                        <div class="absolute right-0 mt-1 w-36 bg-white border border-gray-100 rounded-xl shadow-xl shadow-gray-100/50 hidden group-hover:block z-50 overflow-hidden">
                            <button onclick="changeLanguageImmediately('en')" class="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors <%= locals.language === 'en' ? 'font-bold text-indigo-600' : '' %>">English</button>
                            <button onclick="changeLanguageImmediately('bn')" class="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors <%= locals.language === 'bn' ? 'font-bold text-indigo-600' : '' %>">বাংলা</button>
                        </div>
                    </div>
                    <%- include('../partials/student-header-controls') %>
                </div>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 scrollbar-thin">
            <!-- Title -->
            <div class="animate-fade-in-up opacity-0 mb-8">
                <h2 class="text-2xl font-extrabold text-gray-800 flex items-center gap-3">
                    <span class="w-1.5 h-8 bg-gradient-to-b from-purple-500 to-indigo-500 rounded-full"></span>
                    Quizzes
                </h2>
                <p class="text-gray-400 text-sm mt-1 ml-5">Test your knowledge and track your scores</p>
            </div>

            <!-- Available Quizzes -->
            <div class="animate-fade-in-up opacity-0 delay-100 mb-8">
                <h3 class="text-sm font-bold text-gray-800 mb-4 flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-purple-50 flex items-center justify-center"><i class="fa-solid fa-clipboard-question text-purple-500 text-xs"></i></div>
                    Available Quizzes
                </h3>
                <% if (availableQuizzes && availableQuizzes.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                    <% availableQuizzes.forEach(quiz => { %>
                    <div class="card-hover bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
                        <h4 class="font-bold text-base text-gray-800 mb-1"><%= quiz.title %></h4>
                        <p class="text-sm text-gray-400 mb-4"><%= quiz.course ? quiz.course.title : '' %></p>
                        <div class="flex justify-between items-center mb-5 text-xs font-medium">
                            <span class="bg-emerald-50 text-emerald-600 px-2.5 py-1 rounded-lg"><i class="fa-solid fa-check-double mr-1"></i>Pass: <%= quiz.passingScore %>%</span>
                            <span class="bg-indigo-50 text-indigo-600 px-2.5 py-1 rounded-lg"><i class="fa-regular fa-clock mr-1"></i><%= quiz.timeLimitMinutes > 0 ? quiz.timeLimitMinutes + 'm' : 'No limit' %></span>
                        </div>
                        <a href="/student/quizzes/<%= quiz._id %>" class="block w-full text-center bg-indigo-50 text-indigo-600 py-2.5 rounded-xl font-bold text-sm hover:bg-indigo-100 transition-colors">View Details</a>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                <div class="bg-white rounded-2xl border border-gray-100 p-10 text-center shadow-sm">
                    <div class="w-16 h-16 bg-purple-50 rounded-2xl flex items-center justify-center text-purple-300 mb-4 mx-auto text-3xl"><i class="fa-solid fa-clipboard-question"></i></div>
                    <p class="text-gray-400 font-medium">No quizzes available for your enrolled courses yet.</p>
                </div>
                <% } %>
            </div>

            <!-- Recent Attempts -->
            <div class="animate-fade-in-up opacity-0 delay-200">
                <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
                    <h3 class="text-sm font-bold text-gray-800 mb-5 flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center"><i class="fa-solid fa-history text-blue-500 text-xs"></i></div>
                        Recent Quiz Attempts
                    </h3>
                    <% if (recentAttempts && recentAttempts.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="text-xs text-gray-400 uppercase tracking-wider border-b border-gray-100">
                                    <th class="py-3 px-4 font-semibold">Quiz / Course</th>
                                    <th class="py-3 px-4 font-semibold">Date</th>
                                    <th class="py-3 px-4 font-semibold">Score</th>
                                    <th class="py-3 px-4 font-semibold">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentAttempts.forEach(attempt => { %>
                                <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
                                    <td class="py-3.5 px-4">
                                        <p class="font-bold text-gray-800 text-sm"><%= attempt.quiz ? attempt.quiz.title : 'Deleted Quiz' %></p>
                                        <p class="text-xs text-gray-400"><%= attempt.quiz && attempt.quiz.course ? attempt.quiz.course.title : '' %></p>
                                    </td>
                                    <td class="py-3.5 px-4 text-sm text-gray-500"><%= new Date(attempt.createdAt).toLocaleDateString() %></td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center justify-center px-3 py-1 rounded-lg text-xs font-bold <%= attempt.score >= (attempt.quiz ? attempt.quiz.passingScore : 60) ? 'bg-emerald-50 text-emerald-600' : 'bg-red-50 text-red-600' %>">
                                            <%= attempt.score %>%
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <% if (attempt.quiz) { %>
                                        <a href="/student/quizzes/<%= attempt.quiz._id %>/result?attemptId=<%= attempt._id %>" class="text-indigo-600 hover:text-indigo-700 text-sm font-bold">Review</a>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="text-center py-10">
                        <div class="w-16 h-16 bg-indigo-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-indigo-300 text-3xl"><i class="fa-solid fa-clipboard-question"></i></div>
                        <p class="text-gray-400 font-medium">You haven't attempted any quizzes yet.</p>
                        <p class="text-sm text-gray-300 mt-1">Enroll in a course to access its quizzes.</p>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                if (isOpen) { sidebar.classList.add('-translate-x-full'); sidebarOverlay.classList.add('hidden'); document.body.classList.remove('overflow-hidden'); }
                else { sidebar.classList.remove('-translate-x-full'); sidebarOverlay.classList.remove('hidden'); document.body.classList.add('overflow-hidden'); }
            };
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);
        });
    </script>
    <%- include('../partials/language-modal') %>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
