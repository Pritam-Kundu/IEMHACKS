<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS (CDN for rapid hackathon setup, can be replaced with build later) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Dashboard-specific custom styles */
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        /* Sidebar styling */
        .sidebar-active { 
            background-color: #e0e7ff; 
            color: #4f46e5; 
            font-weight: 600; 
            border-right: 4px solid #4f46e5; 
        }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { 
            background-color: #f1f5f9; 
            color: #334155; 
        }
        
        /* Utility */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/student/dashboard" class="flex items-center gap-2 text-indigo-600 hover:text-indigo-700 transition-colors">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
                <span class="font-mono text-xl font-bold tracking-tight text-slate-900">EduSmart <span class="text-xs text-indigo-600 ml-1 font-semibold uppercase font-sans tracking-normal">Student</span></span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/student/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-house w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.dashboard') : 'Dashboard' %></span>
            </a>
            <a href="/student/courses" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.myCourses') : 'My Courses' %></span>
            </a>
            <a href="/student/quizzes" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-clipboard-question w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.quizzes') : 'Quizzes' %></span>
            </a>
            <a href="/student/ai-tutor" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-robot w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.aiTutor') : 'AI Tutor' %></span>
            </a>
            <a href="/student/progress" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.progress') : 'Progress' %></span>
            </a>
            <a href="/student/leaderboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-trophy w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.leaderboard') : 'Leaderboard' %></span>
            </a>
            <a href="/student/badges" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.badges') : 'Badges' %></span>
            </a>
            <a href="/student/offline-videos" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-download w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.offlineVideos') : 'Offline Videos' %></span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/student/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.settings') : 'Settings' %></span>
            </a>
            <!-- Using existing logout flow -->
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span><%= typeof t === 'function' ? t('common.logout') : 'Logout' %></span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block mr-6">Quizzes</h1>
                    
                    <!-- Global Links -->
                    <div class="hidden md:flex items-center space-x-6 border-l pl-6 border-slate-200">
                        <a href="/" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('common.home') : 'Home' %></a>
                        <a href="/#features" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('home.featuresHeader') : 'Features' %></a>
                        <a href="/#how-it-works" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('home.howItWorks') : 'How it Works' %></a>
                        <a href="/#about" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors"><%= typeof t === 'function' ? t('nav.aboutUs') : 'About' %></a>
                    </div>
                </div>
                
                <div class="flex items-center gap-5">
                    
                    <!-- Language Switcher -->
                    <div class="relative group mr-2">
                        <button class="inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors gap-1">
                            <i class="fa-solid fa-globe text-xl"></i>
                            <%= locals.language === 'bn' ? 'বাংলা' : 'English' %>
                        </button>
                        <div class="absolute right-0 mt-0 w-32 bg-white border border-slate-200 rounded-md shadow-lg hidden group-hover:block z-50 overflow-hidden">
                            <button onclick="changeLanguageImmediately('en')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'en' ? 'font-bold' : '' %>">English</button>
                            <button onclick="changeLanguageImmediately('bn')" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 <%= locals.language === 'bn' ? 'font-bold' : '' %>">বাংলা</button>
                        </div>
                    </div>

                    <%- include('../partials/student-header-controls') %>
                </div>
            </div>
        </header>

        
        <!-- Dashboard Content -->

        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <h2 class="text-2xl font-bold text-slate-800 mb-6">Quizzes</h2>
            
            <div class="mb-8">
                <h3 class="text-xl font-bold text-slate-800 mb-4">Available Quizzes</h3>
                <% if (availableQuizzes && availableQuizzes.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% availableQuizzes.forEach(quiz => { %>
                            <div class="bg-white border border-slate-200 rounded-lg p-6 shadow-sm hover:shadow-md transition">
                                <h4 class="font-bold text-lg text-slate-800 mb-1"><%= quiz.title %></h4>
                                <p class="text-sm text-slate-500 mb-4"><%= quiz.course ? quiz.course.title : '' %></p>
                                <div class="flex justify-between items-center mb-4 text-sm text-slate-600">
                                    <span><i class="fa-solid fa-check-double text-green-500 mr-1"></i> Pass: <%= quiz.passingScore %>%</span>
                                    <span><i class="fa-regular fa-clock text-indigo-500 mr-1"></i> <%= quiz.timeLimitMinutes > 0 ? quiz.timeLimitMinutes + 'm' : 'No limit' %></span>
                                </div>
                                <a href="/student/quizzes/<%= quiz._id %>" class="block w-full text-center bg-indigo-50 text-indigo-700 py-2 rounded font-medium hover:bg-indigo-100 transition-colors">View Details</a>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 text-center">
                        <p class="text-slate-500">No quizzes available for your enrolled courses yet.</p>
                    </div>
                <% } %>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-lg font-semibold text-slate-800 mb-4">Recent Quiz Attempts</h3>
                <% if (recentAttempts && recentAttempts.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-600 text-sm border-y border-slate-200">
                                    <th class="py-3 px-4 font-medium">Quiz / Course</th>
                                    <th class="py-3 px-4 font-medium">Date</th>
                                    <th class="py-3 px-4 font-medium">Score</th>
                                    <th class="py-3 px-4 font-medium">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentAttempts.forEach(attempt => { %>
                                    <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                        <td class="py-3 px-4">
                                            <p class="font-medium text-slate-800"><%= attempt.quiz ? attempt.quiz.title : 'Deleted Quiz' %></p>
                                            <p class="text-xs text-slate-500"><%= attempt.quiz && attempt.quiz.course ? attempt.quiz.course.title : '' %></p>
                                        </td>
                                        <td class="py-3 px-4 text-sm text-slate-600">
                                            <%= new Date(attempt.createdAt).toLocaleDateString() %>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="inline-flex items-center justify-center px-2 py-1 rounded text-xs font-bold <%= attempt.score >= (attempt.quiz ? attempt.quiz.passingScore : 60) ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                                                <%= attempt.score %>%
                                            </span>
                                        </td>
                                        <td class="py-3 px-4">
                                            <% if (attempt.quiz) { %>
                                                <a href="/student/quizzes/<%= attempt.quiz._id %>/result?attemptId=<%= attempt._id %>" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">Review</a>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-12">
                        <div class="w-16 h-16 bg-indigo-50 rounded-full flex items-center justify-center mx-auto mb-4 text-indigo-400">
                            <i class="fa-solid fa-clipboard-question text-2xl"></i>
                        </div>
                        <p class="text-slate-500 font-medium">You haven't attempted any quizzes yet.</p>
                        <p class="text-sm text-slate-400 mt-1">Enroll in a course to access its quizzes.</p>
                    </div>
                <% } %>
            </div>
        </div>
        
        <!-- Page Specific Scripts -->
<!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden'); // Restore body scroll
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden'); // Prevent body scroll
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            /**
             * Phase 13 Preparation: IndexedDB Initialization 
             * This provides the architecture placeholder for offline caching.
             * The actual caching sync logic will be added in Phase 13.
             */
            if ('indexedDB' in window) {
                // Future IndexedDB implementation placeholder
                console.log('IndexedDB is supported. Ready for offline mode caching.');
            }
        });
    </script>
    <%- include('../partials/language-modal') %>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
