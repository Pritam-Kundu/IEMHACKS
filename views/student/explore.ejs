<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS (CDN for rapid hackathon setup, can be replaced with build later) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Dashboard-specific custom styles */
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        /* Sidebar styling */
        .sidebar-active { 
            background-color: #e0e7ff; 
            color: #4f46e5; 
            font-weight: 600; 
            border-right: 4px solid #4f46e5; 
        }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { 
            background-color: #f1f5f9; 
            color: #334155; 
        }
        
        /* Utility */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/student/dashboard" class="flex items-center gap-2 text-indigo-600 hover:text-indigo-700 transition-colors">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
                <span class="font-mono text-xl font-bold tracking-tight text-slate-900">EduSmart <span class="font-sans text-xs text-blue-600 ml-1 font-semibold uppercase tracking-normal">Student</span></span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/student/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-house w-5 text-center"></i>
                <span>Dashboard</span>
            </a>
            <a href="/student/courses" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                <span>My Courses</span>
            </a>
            <a href="/student/quizzes" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-clipboard-question w-5 text-center"></i>
                <span>Quizzes</span>
            </a>
            <a href="/student/ai-tutor" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-robot w-5 text-center"></i>
                <span>AI Tutor</span>
            </a>
            <a href="/student/progress" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span>Progress</span>
            </a>
            <a href="/student/leaderboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-trophy w-5 text-center"></i>
                <span>Leaderboard</span>
            </a>
            <a href="/student/badges" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span>Badges</span>
            </a>
            <a href="/student/offline-videos" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-download w-5 text-center"></i>
                <span>Offline Videos</span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/student/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span>Settings</span>
            </a>
            <!-- Using existing logout flow -->
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <div class="flex items-center gap-4">
                    <button id="openSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 class="text-xl font-bold text-slate-800 hidden sm:block mr-6">Explore Courses</h1>
                    
                    <!-- Global Links -->
                    <div class="hidden md:flex items-center space-x-6 border-l pl-6 border-slate-200">
                        <a href="/" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">Home</a>
                        <a href="/#features" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">Features</a>
                        <a href="/#how-it-works" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">How it Works</a>
                        <a href="/#about" class="text-slate-500 hover:text-indigo-600 font-medium transition-colors">About</a>
                    </div>
                </div>
                
                <div class="flex items-center gap-5">
                    <button class="relative text-slate-500 hover:text-indigo-600 transition-colors focus:outline-none">
                        <i class="fa-regular fa-bell text-xl"></i>
                        <!-- Notification indicator (example active state) -->
                        <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    
                    <a href="/student/settings" class="flex items-center gap-3 cursor-pointer group">
                        <img src="<%= user.profilePicture || '/images/default-avatar.png' %>" alt="Profile" class="w-9 h-9 rounded-full object-cover border-2 border-indigo-100 group-hover:border-indigo-300 transition-colors">
                        <div class="hidden md:block">
                            <p class="text-sm font-semibold text-slate-800"><%= user.name %></p>
                            <p class="text-xs text-slate-500 capitalize"><%= user.role %></p>
                        </div>
                    </a>
                </div>
            </div>
        </header>

        
        <!-- Dashboard Content -->

        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-slate-800">Explore Courses</h2>
                <a href="/student/courses" class="text-sm font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-2 transition-colors">
                    <i class="fa-solid fa-arrow-left"></i> Back to My Courses
                </a>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-lg font-semibold text-slate-800 mb-4">Available Courses</h3>
                
                <!-- Filter Section -->
                <div class="flex flex-col md:flex-row gap-4 mb-6">
                    <div class="flex-1 relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                        </div>
                        <input type="text" id="courseSearch" placeholder="Search courses by title..." class="w-full pl-10 pr-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
                    </div>
                    <div class="w-full md:w-48">
                        <select id="subjectFilter" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm text-slate-700 bg-white">
                            <option value="all">All Subjects</option>
                            <% if (typeof subjects !== 'undefined') { %>
                                <% subjects.forEach(sub => { %>
                                    <option value="<%= sub.name %>"><%= sub.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="w-full md:w-48">
                        <select id="levelFilter" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm text-slate-700 bg-white">
                            <option value="all">All Levels</option>
                            <option value="beginner">Beginner</option>
                            <option value="intermediate">Intermediate</option>
                            <option value="advanced">Advanced</option>
                        </select>
                    </div>
                </div>

                <% if (availableCourses && availableCourses.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="coursesGrid">
                        <% availableCourses.forEach(course => { %>
                            <div class="course-card border border-slate-200 rounded-lg p-4 hover:shadow-md transition-shadow bg-white"
                                 data-title="<%= course.title.toLowerCase() %>" 
                                 data-subject="<%= course.subject ? course.subject.name : '' %>" 
                                 data-level="<%= course.level || 'beginner' %>">
                                <div class="mb-3">
                                    <span class="inline-block px-2 py-1 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-full mb-2"><%= course.subject ? course.subject.name : 'General' %></span>
                                    <span class="inline-block px-2 py-1 bg-slate-100 text-slate-600 text-xs font-semibold rounded-full capitalize mb-2"><%= course.level || 'beginner' %></span>
                                </div>
                                <h4 class="font-bold text-slate-800 text-lg"><%= course.title %></h4>
                                <p class="text-sm text-slate-600 line-clamp-2 mt-2 mb-4"><%= course.description %></p>
                                <form action="/api/enroll" method="POST">
                                    <input type="hidden" name="courseId" value="<%= course._id %>">
                                    <button type="submit" class="w-full bg-indigo-600 text-white py-2 rounded font-medium hover:bg-indigo-700 transition-colors">Enroll Now</button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-slate-500">No new courses available to enroll right now.</p>
                <% } %>
            </div>
        </div>
        
        <!-- Page Specific Scripts -->
<!-- Page Specific Scripts -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Sidebar Toggle Logic for Mobile Responsiveness
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const openSidebarBtn = document.getElementById('openSidebarBtn');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');
            
            const toggleSidebar = () => {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden'); // Restore body scroll
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    document.body.classList.add('overflow-hidden'); // Prevent body scroll
                }
            };
            
            if (openSidebarBtn) openSidebarBtn.addEventListener('click', toggleSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);

            // Course Filtering Logic
            const searchInput = document.getElementById('courseSearch');
            const subjectFilter = document.getElementById('subjectFilter');
            const levelFilter = document.getElementById('levelFilter');
            const courseCards = document.querySelectorAll('.course-card');

            const filterCourses = () => {
                const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
                const subject = subjectFilter ? subjectFilter.value : 'all';
                const level = levelFilter ? levelFilter.value : 'all';

                courseCards.forEach(card => {
                    const cardTitle = card.getAttribute('data-title');
                    const cardSubject = card.getAttribute('data-subject');
                    const cardLevel = card.getAttribute('data-level');

                    const matchesSearch = cardTitle.includes(searchTerm);
                    const matchesSubject = subject === 'all' || cardSubject === subject;
                    const matchesLevel = level === 'all' || cardLevel === level;

                    if (matchesSearch && matchesSubject && matchesLevel) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            };

            if (searchInput) searchInput.addEventListener('input', filterCourses);
            if (subjectFilter) subjectFilter.addEventListener('change', filterCourses);
            if (levelFilter) levelFilter.addEventListener('change', filterCourses);

            /**
             * Phase 13 Preparation: IndexedDB Initialization 
             * This provides the architecture placeholder for offline caching.
             * The actual caching sync logic will be added in Phase 13.
             */
            if ('indexedDB' in window) {
                // Future IndexedDB implementation placeholder
                console.log('IndexedDB is supported. Ready for offline mode caching.');
            }
        });
    </script>
</body>
</html>
