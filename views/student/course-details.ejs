<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .sidebar-active { background-color: #e0e7ff; color: #4f46e5; font-weight: 600; border-right: 4px solid #4f46e5; }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { background-color: #f1f5f9; color: #334155; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">
    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/student/dashboard" class="flex items-center gap-2 text-indigo-600 hover:text-indigo-700 transition-colors">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
                <span class="font-mono text-xl font-bold tracking-tight text-slate-900">EduSmart <span class="text-xs text-indigo-600 ml-1 font-semibold uppercase font-sans tracking-normal">Student</span></span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/student/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-house w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.dashboard') : 'Dashboard' %></span>
            </a>
            <a href="/student/courses" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.myCourses') : 'My Courses' %></span>
            </a>
            <a href="/student/explore" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-compass w-5 text-center"></i>
                <span>Explore</span>
            </a>
            <a href="/student/quizzes" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-clipboard-question w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.quizzes') : 'Quizzes' %></span>
            </a>
            <a href="/student/ai-tutor" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-robot w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.aiTutor') : 'AI Tutor' %></span>
            </a>
            <a href="/student/progress" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.progress') : 'Progress' %></span>
            </a>
            <a href="/student/leaderboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-trophy w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.leaderboard') : 'Leaderboard' %></span>
            </a>
                        <a href="/student/badges" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.badges') : 'Badges' %></span>
            </a>
            <a href="/student/offline-videos" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-download w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.offlineVideos') : 'Offline Videos' %></span>
            </a>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <a href="/student/settings" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-gear w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.settings') : 'Settings' %></span>
            </a>
            <form action="/logout" method="POST" class="w-full mt-1">
                <button type="submit" class="sidebar-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-red-600 hover:bg-red-50 hover:text-red-700">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i>
                    <span><%= typeof t === 'function' ? t('common.logout') : 'Logout' %></span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-10 p-4">
            <div class="flex items-center justify-between">
                <a href="/student/explore" class="text-sm font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i> Back to Courses
                </a>
                <div class="flex items-center gap-3">
                    <img src="<%= user.profilePicture || '/images/default-avatar.png' %>" class="w-8 h-8 rounded-full border border-slate-200">
                    <span class="text-sm font-semibold text-slate-800"><%= user.name %></span>
                </div>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 max-w-4xl mx-auto">
                <div class="flex flex-col md:flex-row gap-8">
                    <!-- Left: Info -->
                    <div class="flex-1">
                        <span class="inline-block px-3 py-1 bg-indigo-50 text-indigo-700 text-sm font-semibold rounded-full mb-4">
                            <%= course.subject ? course.subject.name : 'General' %>
                        </span>
                        <span class="inline-block px-3 py-1 bg-slate-100 text-slate-600 text-sm font-semibold rounded-full capitalize mb-4 ml-2">
                            <%= course.level %>
                        </span>
                        
                        <h1 class="text-3xl font-bold text-slate-800 mb-4"><%= course.title %></h1>
                        <p class="text-slate-600 mb-6 text-lg"><%= course.description %></p>
                        
                        <div class="flex items-center gap-4 mb-8">
                            <img src="<%= course.teacher ? course.teacher.profilePicture : '/images/default-avatar.png' %>" class="w-12 h-12 rounded-full border border-slate-200">
                            <div>
                                <p class="text-sm text-slate-500">Instructor</p>
                                <p class="font-semibold text-slate-800"><%= course.teacher ? course.teacher.name : 'Unknown' %></p>
                            </div>
                        </div>

                        <% if (isEnrolled) { %>
                            <div class="bg-green-50 border border-green-200 text-green-800 p-4 rounded-lg flex items-center gap-3 mb-6">
                                <i class="fa-solid fa-circle-check text-xl"></i>
                                <div>
                                    <p class="font-semibold">You are enrolled in this course.</p>
                                    <a href="/student/courses/<%= course._id %>/learn" class="text-green-700 font-bold hover:underline">Continue Learning <i class="fa-solid fa-arrow-right ml-1"></i></a>
                                </div>
                            </div>
                        <% } else { %>
                            <form action="/student/courses/<%= course._id %>/enroll" method="POST" class="mb-6">
                                <button type="submit" class="bg-indigo-600 text-white font-semibold py-3 px-8 rounded-lg shadow hover:bg-indigo-700 transition w-full md:w-auto">
                                    Enroll in Course Now
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>
                
                <hr class="my-8 border-slate-200">

                <!-- Syllabus / Lessons -->
                <div>
                    <h2 class="text-2xl font-bold text-slate-800 mb-6">Course Content</h2>
                    <% if (lessons && lessons.length > 0) { %>
                        <div class="space-y-4">
                            <% lessons.forEach((lesson, index) => { %>
                                <div class="p-4 border border-slate-200 rounded-lg flex justify-between items-center bg-slate-50 hover:bg-white transition">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold">
                                            <%= index + 1 %>
                                        </div>
                                        <div>
                                            <h4 class="font-semibold text-slate-800"><%= lesson.title %></h4>
                                            <p class="text-xs text-slate-500"><i class="fa-regular fa-clock mr-1"></i> <%= lesson.durationMinutes %> min</p>
                                        </div>
                                    </div>
                                    <% if (isEnrolled) { %>
                                        <a href="/student/lessons/<%= lesson._id %>" class="text-indigo-600 hover:text-indigo-800 font-medium text-sm">View Lesson</a>
                                    <% } else { %>
                                        <span class="text-slate-400 text-sm"><i class="fa-solid fa-lock"></i> Locked</span>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-slate-500">No lessons available yet.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
