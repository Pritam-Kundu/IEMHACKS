<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body class="flex flex-col h-screen overflow-hidden text-slate-800 bg-slate-50">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-10 flex-shrink-0">
        <div class="flex items-center justify-between px-6 py-4 max-w-4xl mx-auto">
            <h1 class="text-xl font-bold text-slate-800"><%= quiz.title %></h1>
            <% if (quiz.timeLimitMinutes > 0) { %>
                <div class="bg-red-50 text-red-600 px-4 py-2 rounded-full font-bold flex items-center gap-2">
                    <i class="fa-regular fa-clock"></i>
                    <span id="timerDisplay">--:--</span>
                </div>
            <% } %>
        </div>
    </header>

    <main class="flex-1 overflow-y-auto p-4 sm:p-8">
        <div class="max-w-4xl mx-auto">
            <form id="quizForm" class="space-y-6">
                <% questions.forEach((q, index) => { %>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 question-block" data-question-id="<%= q._id %>">
                        <h3 class="text-lg font-semibold text-slate-800 mb-4"><%= index + 1 %>. <%= q.questionText %></h3>
                        <div class="space-y-3">
                            <% q.options.forEach((opt, oIndex) => { %>
                                <label class="flex items-center p-3 border border-slate-200 rounded-lg cursor-pointer hover:bg-slate-50 transition">
                                    <input type="radio" name="q_<%= q._id %>" value="<%= oIndex %>" class="w-4 h-4 text-indigo-600 border-slate-300 focus:ring-indigo-500">
                                    <span class="ml-3 text-slate-700"><%= opt.text %></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
                
                <div class="flex justify-end pt-4">
                    <button type="button" id="submitQuizBtn" class="bg-indigo-600 text-white font-bold py-3 px-8 rounded-lg shadow-md hover:bg-indigo-700 transition">
                        Submit Quiz
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const timeLimit = parseInt('<%= quiz.timeLimitMinutes %>') || 0;
            const quizId = '<%= quiz._id %>';
            const form = document.getElementById('quizForm');
            const submitBtn = document.getElementById('submitQuizBtn');
            let timeRemaining = timeLimit * 60;
            let timerInterval;

            const submitQuiz = () => {
                clearInterval(timerInterval);
                submitBtn.disabled = true;
                submitBtn.textContent = 'Submitting...';

                const answers = [];
                const questionBlocks = document.querySelectorAll('.question-block');
                
                questionBlocks.forEach(block => {
                    const qId = block.getAttribute('data-question-id');
                    const selected = block.querySelector(`input[name="q_${qId}"]:checked`);
                    if (selected) {
                        answers.push({
                            questionId: qId,
                            selectedOptionIndex: parseInt(selected.value)
                        });
                    }
                });

                fetch(`/student/quizzes/${quizId}/submit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ answers })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = `/student/quizzes/${quizId}/result?attemptId=${data.attemptId}`;
                    } else {
                        alert(data.message || 'Error submitting quiz');
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Submit Quiz';
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('An error occurred.');
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Quiz';
                });
            };

            if (timeLimit > 0) {
                const display = document.getElementById('timerDisplay');
                
                const updateTimer = () => {
                    const m = Math.floor(timeRemaining / 60);
                    const s = timeRemaining % 60;
                    display.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                    
                    if (timeRemaining <= 0) {
                        clearInterval(timerInterval);
                        alert('Time is up! Submitting your quiz automatically.');
                        submitQuiz();
                    }
                    timeRemaining--;
                };
                
                updateTimer();
                timerInterval = setInterval(updateTimer, 1000);
            }

            submitBtn.addEventListener('click', () => {
                if (confirm('Are you sure you want to submit your quiz?')) {
                    submitQuiz();
                }
            });
        });
    </script>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
