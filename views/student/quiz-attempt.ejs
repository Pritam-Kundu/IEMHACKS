<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #fef3f2 100%); min-height: 100vh; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
        .delay-100 { animation-delay: 0.1s; } .delay-200 { animation-delay: 0.2s; } .delay-300 { animation-delay: 0.3s; }
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
        .scrollbar-thin::-webkit-scrollbar { width: 5px; } .scrollbar-thin::-webkit-scrollbar-track { background: transparent; } .scrollbar-thin::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        
        /* Custom Radio Button Styles */
        .option-label { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
        .option-input:checked + .option-content {
            background-color: #eef2ff;
            border-color: #6366f1;
            box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.1), 0 2px 4px -1px rgba(99, 102, 241, 0.06);
        }
        .option-input:checked + .option-content .custom-radio {
            border-color: #6366f1;
            background-color: #6366f1;
        }
        .option-input:checked + .option-content .custom-radio::after {
            opacity: 1;
            transform: scale(1);
        }
        .option-input:checked + .option-content .option-text {
            color: #4f46e5;
            font-weight: 600;
        }
    </style>
</head>
<body class="flex flex-col h-screen overflow-hidden text-gray-800">

    <header class="glass border-b border-white/50 sticky top-0 z-40 flex-shrink-0 shadow-sm shadow-indigo-100/20">
        <div class="flex items-center justify-between px-6 py-4 max-w-5xl mx-auto">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-purple-500 flex items-center justify-center shadow-md shadow-indigo-200"><i class="fa-solid fa-graduation-cap text-white text-lg"></i></div>
                <h1 class="text-xl font-extrabold text-gray-800 tracking-tight"><%= quiz.title %></h1>
            </div>
            <% if (quiz.timeLimitMinutes > 0) { %>
                <div class="bg-gradient-to-r from-rose-50 to-red-50 border border-red-100 text-red-600 px-5 py-2.5 rounded-xl font-bold flex items-center gap-2.5 shadow-sm">
                    <i class="fa-regular fa-clock animate-pulse"></i>
                    <span id="timerDisplay" class="font-mono text-lg tracking-wider">--:--</span>
                </div>
            <% } %>
        </div>
    </header>

    <main class="flex-1 overflow-y-auto p-4 sm:p-8 scrollbar-thin">
        <div class="max-w-4xl mx-auto pb-20">
            <div class="mb-8 animate-fade-in-up">
                <div class="w-full bg-gray-200 rounded-full h-2.5 mb-2 overflow-hidden shadow-inner">
                    <div class="bg-gradient-to-r from-indigo-500 to-purple-500 h-2.5 rounded-full" style="width: 100%"></div>
                </div>
                <p class="text-right text-sm font-semibold text-gray-500"><%= questions.length %> Questions</p>
            </div>

            <form id="quizForm" class="space-y-8">
                <% questions.forEach((q, index) => { %>
                    <div class="bg-white/90 backdrop-blur-md p-8 rounded-3xl shadow-sm border border-gray-100 question-block animate-fade-in-up" style="animation-delay: <%= index * 0.1 %>s" data-question-id="<%= q._id %>">
                        <div class="flex gap-4 mb-6">
                            <span class="flex-shrink-0 w-8 h-8 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center font-bold text-sm"><%= index + 1 %></span>
                            <h3 class="text-xl font-bold text-gray-800 leading-snug pt-0.5"><%= q.questionText %></h3>
                        </div>
                        
                        <div class="space-y-3 pl-12">
                            <% q.options.forEach((opt, oIndex) => { %>
                                <label class="option-label block relative cursor-pointer group">
                                    <input type="radio" name="q_<%= q._id %>" value="<%= oIndex %>" class="option-input sr-only">
                                    <div class="option-content flex items-center p-4 border-2 border-gray-100 rounded-2xl group-hover:bg-gray-50 group-hover:border-indigo-200 transition-all">
                                        <div class="custom-radio flex-shrink-0 w-5 h-5 border-2 border-gray-300 rounded-full mr-4 flex items-center justify-center transition-colors relative">
                                            <div class="w-2 h-2 bg-white rounded-full opacity-0 transform scale-50 transition-all duration-200 absolute inset-auto"></div>
                                        </div>
                                        <span class="option-text text-gray-700 text-[15px] font-medium transition-colors"><%= opt.text %></span>
                                    </div>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
                
                <div class="flex justify-end pt-8 animate-fade-in-up delay-300">
                    <button type="button" id="submitQuizBtn" class="bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-bold py-4 px-10 rounded-2xl shadow-lg shadow-indigo-200 hover:-translate-y-1 transition-all text-lg flex items-center gap-3 group">
                        <span>Submit Quiz</span>
                        <i class="fa-solid fa-paper-plane group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"></i>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const timeLimit = parseInt('<%= quiz.timeLimitMinutes %>') || 0;
            const quizId = '<%= quiz._id %>';
            const form = document.getElementById('quizForm');
            const submitBtn = document.getElementById('submitQuizBtn');
            let timeRemaining = timeLimit * 60;
            let timerInterval;

            const submitQuiz = () => {
                clearInterval(timerInterval);
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> <span>Submitting...</span>';

                const answers = [];
                const questionBlocks = document.querySelectorAll('.question-block');
                
                questionBlocks.forEach(block => {
                    const qId = block.getAttribute('data-question-id');
                    const selected = block.querySelector(`input[name="q_${qId}"]:checked`);
                    if (selected) {
                        answers.push({
                            questionId: qId,
                            selectedOptionIndex: parseInt(selected.value)
                        });
                    }
                });

                fetch(`/student/quizzes/${quizId}/submit`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ answers })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const redirectUrl = `/student/quizzes/${quizId}/result?attemptId=${data.attemptId}`;
                        if (data.leveledUp && typeof confetti === 'function') {
                            confetti({
                                particleCount: 200,
                                spread: 90,
                                origin: { y: 0.6 },
                                zIndex: 10000,
                                colors: ['#4f46e5', '#8b5cf6', '#ec4899', '#3b82f6']
                            });
                            setTimeout(() => {
                                window.location.href = redirectUrl;
                            }, 2500);
                        } else {
                            window.location.href = redirectUrl;
                        }
                    } else {
                        alert(data.message || 'Error submitting quiz');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<span>Submit Quiz</span> <i class="fa-solid fa-paper-plane"></i>';
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('An error occurred.');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<span>Submit Quiz</span> <i class="fa-solid fa-paper-plane"></i>';
                });
            };

            if (timeLimit > 0) {
                const display = document.getElementById('timerDisplay');
                
                const updateTimer = () => {
                    const m = Math.floor(timeRemaining / 60);
                    const s = timeRemaining % 60;
                    display.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                    
                    if (timeRemaining <= 300) {
                        display.parentElement.classList.remove('from-rose-50', 'to-red-50', 'text-red-600', 'border-red-100');
                        display.parentElement.classList.add('bg-red-500', 'text-white', 'animate-pulse');
                    }

                    if (timeRemaining <= 0) {
                        clearInterval(timerInterval);
                        alert('Time is up! Submitting your quiz automatically.');
                        submitQuiz();
                    }
                    timeRemaining--;
                };
                
                updateTimer();
                timerInterval = setInterval(updateTimer, 1000);
            }

            submitBtn.addEventListener('click', () => {
                if (confirm('Are you sure you want to submit your quiz?')) {
                    submitQuiz();
                }
            });
        });
    </script>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
