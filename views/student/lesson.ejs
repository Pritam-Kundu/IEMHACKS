<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #fef3f2 100%); min-height: 100vh; }
        .lesson-content img { max-width: 100%; height: auto; border-radius: 1rem; margin-top: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
        .lesson-content h2 { font-size: 1.875rem; font-weight: 800; margin-top: 2rem; margin-bottom: 1rem; color: #1f2937; letter-spacing: -0.025em; }
        .lesson-content h3 { font-size: 1.5rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.75rem; color: #374151; }
        .lesson-content p { margin-bottom: 1.25rem; line-height: 1.75; font-size: 1.05rem; color: #4b5563; }
        .lesson-content ul { list-style-type: none; margin-left: 0; margin-bottom: 1.5rem; padding-left: 0; }
        .lesson-content ul li { position: relative; padding-left: 1.75rem; margin-bottom: 0.75rem; color: #4b5563; font-size: 1.05rem; }
        .lesson-content ul li::before { content: '•'; position: absolute; left: 0; color: #6366f1; font-weight: bold; font-size: 1.5rem; line-height: 1; top: -0.1rem; }
        .lesson-content strong { color: #1f2937; font-weight: 700; }
        .lesson-content a { color: #4f46e5; text-decoration: none; font-weight: 600; transition: color 0.2s; }
        .lesson-content a:hover { color: #4338ca; text-decoration: underline; }
        
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
        .scrollbar-thin::-webkit-scrollbar { width: 5px; } .scrollbar-thin::-webkit-scrollbar-track { background: transparent; } .scrollbar-thin::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
        .delay-100 { animation-delay: 0.1s; } .delay-200 { animation-delay: 0.2s; } .delay-300 { animation-delay: 0.3s; }
    </style>
</head>
<body class="flex flex-col h-screen overflow-hidden text-gray-800">

    <!-- Top Header -->
    <header class="glass border-b border-white/50 sticky top-0 z-40 flex-shrink-0 shadow-sm shadow-indigo-100/20">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between px-6 py-4 gap-4">
            <div class="flex items-center gap-4 w-full sm:w-auto">
                <a href="/student/courses/<%= lesson.course._id %>" class="w-10 h-10 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center transition-colors flex-shrink-0 border border-indigo-100 shadow-sm">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div class="flex-1 min-w-0">
                    <h1 class="text-xl font-extrabold text-gray-800 tracking-tight truncate pr-4"><%= lesson.course.title %></h1>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mt-0.5 truncate">Lesson <%= lesson.order %>: <%= lesson.title %></p>
                </div>
            </div>
            
            <div class="flex items-center gap-3 w-full sm:w-auto sm:justify-end">
                <button id="completeBtn" class="bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white px-5 py-2.5 rounded-xl font-bold shadow-md shadow-emerald-200 transition-all flex items-center gap-2.5 w-full sm:w-auto justify-center group transform hover:-translate-y-0.5">
                    <i class="fa-solid fa-check group-hover:scale-110 transition-transform"></i> Complete & Continue
                </button>
            </div>
        </div>
    </header>

    <div class="flex flex-1 overflow-hidden relative">
        <!-- Mobile Sidebar Toggle -->
        <button id="toggleSidebarBtn" class="md:hidden absolute top-4 left-4 z-50 w-10 h-10 bg-white border border-gray-200 rounded-xl shadow-md flex items-center justify-center text-gray-600 hover:text-indigo-600 focus:outline-none">
            <i class="fa-solid fa-list-ul"></i>
        </button>

        <div id="mobileSidebarOverlay" class="fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-30 hidden transition-opacity md:hidden"></div>

        <!-- Sidebar: Lesson List -->
        <aside id="lessonSidebar" class="absolute md:static inset-y-0 left-0 w-80 bg-white/90 backdrop-blur-xl border-r border-indigo-50 flex flex-col z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out shadow-lg md:shadow-none">
            <div class="p-6 border-b border-gray-100 bg-gradient-to-b from-indigo-50/50 to-transparent">
                <div class="flex items-center justify-between mb-4 md:hidden">
                    <h3 class="font-extrabold text-gray-800 text-lg">Course Content</h3>
                    <button id="closeSidebarBtn" class="w-8 h-8 rounded-lg bg-gray-100 text-gray-500 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <h3 class="font-extrabold text-gray-800 mb-4 hidden md:block">Course Content</h3>
                
                <div class="w-full bg-gray-100 rounded-full h-2.5 shadow-inner overflow-hidden mb-2">
                    <% const progressPct = Math.round((completedLessonIds.length / courseLessons.length) * 100) || 0; %>
                    <div class="bg-gradient-to-r from-indigo-500 to-purple-500 h-2.5 rounded-full" style="width: <%= progressPct %>%"></div>
                </div>
                <div class="flex justify-between items-center">
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Progress</p>
                    <p class="text-xs font-black text-indigo-600"><%= progressPct %>%</p>
                </div>
            </div>
            <div class="flex-1 overflow-y-auto p-4 space-y-2 scrollbar-thin">
                <% courseLessons.forEach((l, index) => { %>
                    <% const isCurrent = l._id.toString() === lesson._id.toString(); %>
                    <% const isCompleted = completedLessonIds.includes(l._id.toString()); %>
                    <a href="/student/lessons/<%= l._id %>" class="block p-4 rounded-2xl border transition-all <%= isCurrent ? 'bg-gradient-to-r from-indigo-50 to-blue-50 border-indigo-100 text-indigo-700 shadow-sm' : 'border-transparent hover:bg-gray-50 text-gray-600 hover:border-gray-100' %>">
                        <div class="flex items-start gap-4">
                            <div class="mt-0.5 flex-shrink-0">
                                <% if (isCompleted) { %>
                                    <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shadow-inner"><i class="fa-solid fa-check text-xs"></i></div>
                                <% } else if (isCurrent) { %>
                                    <div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center shadow-inner"><i class="fa-solid fa-play text-xs ml-0.5"></i></div>
                                <% } else { %>
                                    <div class="w-6 h-6 rounded-full border-2 border-gray-200 flex items-center justify-center"><i class="fa-solid fa-lock text-[10px] text-gray-300"></i></div>
                                <% } %>
                            </div>
                            <div>
                                <p class="text-sm <%= isCurrent ? 'font-extrabold text-gray-800' : 'font-semibold text-gray-600' %> leading-snug mb-1"><span class="text-gray-400 font-bold"><%= index + 1 %>.</span> <%= l.title %></p>
                                <p class="text-xs font-medium <%= isCurrent ? 'text-indigo-500' : 'text-gray-400' %> flex items-center gap-1.5"><i class="fa-regular fa-clock"></i> <%= l.durationMinutes %> min</p>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </aside>

        <!-- Main Content: Video & Text -->
        <main class="flex-1 overflow-y-auto p-0 md:p-6 lg:p-8 scrollbar-thin">
            <div class="max-w-4xl mx-auto bg-white md:rounded-3xl shadow-sm border-x md:border border-gray-100 overflow-hidden min-h-full md:min-h-0 animate-fade-in-up">
                
                <% if (lesson.videoUrl && lesson.videoUrl.trim() !== '') { %>
                    <!-- Video Player -->
                    <div class="aspect-video bg-gray-900 w-full relative group">
                        <iframe src="<%= lesson.videoUrl.replace('watch?v=', 'embed/') %>" class="absolute inset-0 w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                        <!-- Gradient overlay for sleek look before interaction -->
                        <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    </div>
                <% } %>

                <div class="p-6 md:p-10 lg:p-12">
                    <div class="mb-8">
                        <span class="inline-block px-3 py-1 bg-indigo-50 text-indigo-600 text-xs font-black uppercase tracking-wider rounded-lg mb-3">Lesson <%= lesson.order %></span>
                        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4 tracking-tight leading-tight"><%= lesson.title %></h2>
                        <p class="text-xl text-gray-500 font-medium leading-relaxed"><%= lesson.description %></p>
                    </div>
                    
                    <div class="w-full h-px bg-gradient-to-r from-gray-100 via-gray-200 to-gray-100 my-10"></div>
                    
                    <div class="lesson-content">
                        <%- lesson.content %>
                    </div>
                    
                    <div class="w-full h-px bg-gradient-to-r from-gray-100 via-gray-200 to-gray-100 my-10"></div>
                    
                    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 bg-gray-50/50 p-6 rounded-2xl border border-gray-100">
                        <% if (prevLesson) { %>
                            <a href="/student/lessons/<%= prevLesson._id %>" class="text-indigo-600 hover:text-indigo-800 font-bold px-6 py-3 rounded-xl border-2 border-indigo-100 hover:border-indigo-200 hover:bg-indigo-50 transition-all flex items-center gap-2 w-full sm:w-auto justify-center group">
                                <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i> Previous
                            </a>
                        <% } else { %>
                            <div class="hidden sm:block"></div>
                        <% } %>
                        
                        <% if (nextLesson) { %>
                            <button id="bottomCompleteBtn" class="bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-bold px-8 py-3 rounded-xl shadow-md shadow-indigo-200 hover:-translate-y-0.5 transition-all flex items-center gap-2 w-full sm:w-auto justify-center group">
                                Next Lesson <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                            </button>
                        <% } else { %>
                            <button id="bottomCompleteBtn" class="bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-bold px-8 py-3 rounded-xl shadow-md shadow-emerald-200 hover:-translate-y-0.5 transition-all flex items-center gap-2 w-full sm:w-auto justify-center group">
                                Finish Course <i class="fa-solid fa-flag-checkered group-hover:scale-110 transition-transform"></i>
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const lessonId = '<%= lesson._id %>';
            const nextLessonUrl = '<%= nextLesson ? `/student/lessons/${nextLesson._id}` : `/student/courses/${lesson.course._id}` %>';
            
            // Mobile Sidebar Toggle
            const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
            const lessonSidebar = document.getElementById('lessonSidebar');
            const mobileSidebarOverlay = document.getElementById('mobileSidebarOverlay');
            const closeSidebarBtn = document.getElementById('closeSidebarBtn');

            const toggleMobileSidebar = () => {
                const isOpen = !lessonSidebar.classList.contains('-translate-x-full');
                if (isOpen) {
                    lessonSidebar.classList.add('-translate-x-full');
                    mobileSidebarOverlay.classList.add('hidden');
                } else {
                    lessonSidebar.classList.remove('-translate-x-full');
                    mobileSidebarOverlay.classList.remove('hidden');
                }
            };

            if (toggleSidebarBtn) toggleSidebarBtn.addEventListener('click', toggleMobileSidebar);
            if (mobileSidebarOverlay) mobileSidebarOverlay.addEventListener('click', toggleMobileSidebar);
            if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleMobileSidebar);

            // Completion Logic
            const handleComplete = () => {
                fetch(`/student/lessons/${lessonId}/complete`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success) {
                        if (data.leveledUp && typeof confetti === 'function') {
                            confetti({
                                particleCount: 150,
                                spread: 70,
                                origin: { y: 0.6 },
                                zIndex: 10000,
                                colors: ['#4f46e5', '#8b5cf6', '#ec4899', '#10b981']
                            });
                            setTimeout(() => {
                                window.location.href = nextLessonUrl;
                            }, 2500);
                        } else {
                            window.location.href = nextLessonUrl;
                        }
                    }
                })
                .catch(err => console.error(err));
            };
            
            const topBtn = document.getElementById('completeBtn');
            const bottomBtn = document.getElementById('bottomCompleteBtn');
            
            if (topBtn) topBtn.addEventListener('click', handleComplete);
            if (bottomBtn) bottomBtn.addEventListener('click', handleComplete);
        });
    </script>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
