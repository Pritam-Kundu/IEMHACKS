<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .sidebar-active { background-color: #e0e7ff; color: #4f46e5; font-weight: 600; border-right: 4px solid #4f46e5; }
        .sidebar-item { transition: all 0.2s ease-in-out; }
        .sidebar-item:hover:not(.sidebar-active) { background-color: #f1f5f9; color: #334155; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-slate-800">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 z-20 hidden lg:hidden transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 flex items-center justify-between">
            <a href="/student/dashboard" class="flex items-center gap-2 text-indigo-600 hover:text-indigo-700 transition-colors">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
                <span class="font-mono text-xl font-bold tracking-tight text-slate-900">EduSmart</span>
            </a>
            <button id="closeSidebarBtn" class="lg:hidden text-slate-500 hover:text-slate-800">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/student/dashboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-house w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.dashboard') : 'Dashboard' %></span>
            </a>
            <a href="/student/courses" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-book-open w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.myCourses') : 'My Courses' %></span>
            </a>
            <a href="/student/quizzes" class="sidebar-item sidebar-active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-700">
                <i class="fa-solid fa-clipboard-question w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.quizzes') : 'Quizzes' %></span>
            </a>
            <a href="/student/ai-tutor" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-robot w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.aiTutor') : 'AI Tutor' %></span>
            </a>
            <a href="/student/progress" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.progress') : 'Progress' %></span>
            </a>
            <a href="/student/leaderboard" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-trophy w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.leaderboard') : 'Leaderboard' %></span>
            </a>
            <a href="/student/badges" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-medal w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.badges') : 'Badges' %></span>
            </a>
            <a href="/student/offline-videos" class="sidebar-item flex items-center gap-3 px-4 py-3 rounded-lg text-slate-600">
                <i class="fa-solid fa-download w-5 text-center"></i>
                <span><%= typeof t === 'function' ? t('navigation.offlineVideos') : 'Offline Videos' %></span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-screen lg:ml-64 w-full">
        <!-- Top Header -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-40 p-4">
            <div class="flex items-center justify-between">
                <a href="/student/quizzes" class="text-sm font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i> Back to Quizzes
                </a>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 max-w-3xl mx-auto text-center">
                <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-clipboard-question text-3xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-slate-800 mb-2"><%= quiz.title %></h1>
                <p class="text-slate-600 mb-6"><%= quiz.description %></p>
                
                <div class="flex justify-center gap-8 mb-8 text-sm">
                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 w-32">
                        <p class="text-slate-500 mb-1">Passing Score</p>
                        <p class="text-xl font-bold text-slate-800"><%= quiz.passingScore %>%</p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 w-32">
                        <p class="text-slate-500 mb-1">Time Limit</p>
                        <p class="text-xl font-bold text-slate-800"><%= quiz.timeLimitMinutes === 0 ? 'None' : quiz.timeLimitMinutes + ' min' %></p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 w-32">
                        <p class="text-slate-500 mb-1">Best Score</p>
                        <p class="text-xl font-bold <%= bestScore >= quiz.passingScore ? 'text-green-600' : 'text-slate-800' %>">
                            <%= bestScore !== null ? bestScore + '%' : 'N/A' %>
                        </p>
                    </div>
                </div>

                <a href="/student/quizzes/<%= quiz._id %>/attempt" class="inline-block bg-indigo-600 text-white font-bold py-3 px-12 rounded-lg shadow-md hover:bg-indigo-700 transition">
                    Start Quiz
                </a>

                <hr class="my-8 border-slate-200">
                
                <h3 class="text-left font-bold text-lg mb-4">Previous Attempts (<%= attempts.length %>)</h3>
                <% if (attempts && attempts.length > 0) { %>
                    <div class="space-y-3 text-left">
                        <% attempts.forEach(attempt => { %>
                            <div class="flex justify-between items-center p-4 border border-slate-200 rounded-lg bg-slate-50">
                                <div>
                                    <p class="font-semibold text-slate-800">Score: <%= attempt.score %>%</p>
                                    <p class="text-xs text-slate-500"><%= new Date(attempt.createdAt).toLocaleString() %></p>
                                </div>
                                <div>
                                    <% if (attempt.passed) { %>
                                        <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-bold rounded">PASSED</span>
                                    <% } else { %>
                                        <span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-bold rounded">FAILED</span>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-left text-slate-500">No attempts yet.</p>
                <% } %>
            </div>
        </div>
    </main>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
