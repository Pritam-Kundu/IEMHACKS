<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body class="flex flex-col h-screen overflow-hidden text-slate-800 bg-slate-50">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 flex-shrink-0">
        <div class="flex items-center justify-between px-6 py-4 max-w-4xl mx-auto">
            <h1 class="text-xl font-bold text-slate-800">Quiz Results: <%= attempt.quiz.title %></h1>
            <a href="/student/quizzes" class="text-sm font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-2">
                Back to Quizzes
            </a>
        </div>
    </header>

    <main class="flex-1 overflow-y-auto p-4 sm:p-8">
        <div class="max-w-4xl mx-auto space-y-6">
            
            <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-200 text-center">
                <% if (attempt.passed) { %>
                    <div class="w-20 h-20 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fa-solid fa-trophy text-4xl"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-slate-800 mb-2">Congratulations!</h2>
                    <p class="text-slate-600 mb-6">You passed the quiz successfully.</p>
                <% } else { %>
                    <div class="w-20 h-20 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fa-solid fa-circle-xmark text-4xl"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-slate-800 mb-2">Keep Trying!</h2>
                    <p class="text-slate-600 mb-6">You didn't reach the passing score this time.</p>
                <% } %>
                
                <div class="flex justify-center items-center gap-8 text-sm">
                    <div>
                        <p class="text-slate-500 mb-1">Your Score</p>
                        <p class="text-3xl font-bold <%= attempt.passed ? 'text-green-600' : 'text-red-600' %>"><%= attempt.score %>%</p>
                    </div>
                    <div class="h-12 w-px bg-slate-200"></div>
                    <div>
                        <p class="text-slate-500 mb-1">Passing Score</p>
                        <p class="text-2xl font-bold text-slate-800"><%= attempt.quiz.passingScore %>%</p>
                    </div>
                </div>
            </div>

            <!-- Detailed Answers -->
            <div class="space-y-4">
                <h3 class="text-xl font-bold text-slate-800">Review Answers</h3>
                <% questions.forEach((q, index) => { %>
                    <% 
                        const ansRecord = attempt.answers.find(a => a.question.toString() === q._id.toString()); 
                        const selectedIdx = ansRecord ? ansRecord.selectedOptionIndex : null;
                        const isCorrect = ansRecord ? ansRecord.isCorrect : false;
                    %>
                    <div class="bg-white p-6 rounded-lg shadow-sm border <%= isCorrect ? 'border-green-200' : 'border-red-200' %>">
                        <div class="flex gap-3 mb-4">
                            <% if (isCorrect) { %>
                                <i class="fa-solid fa-check text-green-500 mt-1"></i>
                            <% } else { %>
                                <i class="fa-solid fa-xmark text-red-500 mt-1"></i>
                            <% } %>
                            <h4 class="text-lg font-semibold text-slate-800"><%= index + 1 %>. <%= q.questionText %></h4>
                        </div>
                        
                        <div class="space-y-2 pl-7">
                            <% q.options.forEach((opt, oIndex) => { %>
                                <% 
                                    let bgClass = 'bg-slate-50 border-slate-200';
                                    let textClass = 'text-slate-600';
                                    let icon = '';
                                    if (opt.isCorrect) {
                                        bgClass = 'bg-green-50 border-green-200';
                                        textClass = 'text-green-800 font-semibold';
                                        icon = '<i class="fa-solid fa-check ml-auto text-green-600"></i>';
                                    } else if (selectedIdx === oIndex && !opt.isCorrect) {
                                        bgClass = 'bg-red-50 border-red-200';
                                        textClass = 'text-red-800';
                                        icon = '<i class="fa-solid fa-xmark ml-auto text-red-600"></i>';
                                    }
                                %>
                                <div class="flex items-center p-3 border rounded-lg <%= bgClass %> <%= textClass %>">
                                    <span class="mr-3 text-sm font-mono opacity-50"><%= String.fromCharCode(65 + oIndex) %>.</span>
                                    <span><%= opt.text %></span>
                                    <%- icon %>
                                </div>
                            <% }) %>
                        </div>
                        
                        <% if (q.explanation) { %>
                            <div class="mt-4 pl-7">
                                <div class="bg-indigo-50 border border-indigo-100 text-indigo-800 p-3 rounded-lg text-sm">
                                    <span class="font-bold">Explanation:</span> <%= q.explanation %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
            
            <div class="flex justify-center pb-8 pt-4">
                <a href="/student/quizzes/<%= attempt.quiz._id %>" class="bg-indigo-600 text-white font-bold py-3 px-8 rounded-lg shadow hover:bg-indigo-700 transition">
                    Retry Quiz
                </a>
            </div>
        </div>
    </main>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
