<!DOCTYPE html>
<html lang="<%= language %>" dir="<%= direction %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #fef3f2 100%); min-height: 100vh; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
        .delay-100 { animation-delay: 0.1s; } .delay-200 { animation-delay: 0.2s; } .delay-300 { animation-delay: 0.3s; }
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
        .scrollbar-thin::-webkit-scrollbar { width: 5px; } .scrollbar-thin::-webkit-scrollbar-track { background: transparent; } .scrollbar-thin::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    </style>
</head>
<body class="flex flex-col h-screen overflow-hidden text-gray-800">

    <header class="glass border-b border-white/50 sticky top-0 z-40 flex-shrink-0 shadow-sm shadow-indigo-100/20">
        <div class="flex items-center justify-between px-6 py-4 max-w-5xl mx-auto">
            <h1 class="text-xl font-extrabold text-gray-800 tracking-tight flex items-center gap-3">
                <span class="w-1.5 h-6 bg-gradient-to-b from-indigo-500 to-purple-500 rounded-full"></span>
                Quiz Results: <%= attempt.quiz.title %>
            </h1>
            <a href="/student/quizzes" class="text-sm font-bold text-indigo-600 hover:text-indigo-700 flex items-center gap-2 bg-indigo-50 px-3 py-1.5 rounded-lg transition-colors">
                <i class="fa-solid fa-arrow-left"></i> Back to Quizzes
            </a>
        </div>
    </header>

    <main class="flex-1 overflow-y-auto p-4 sm:p-8 scrollbar-thin">
        <div class="max-w-4xl mx-auto space-y-8 pb-20">
            
            <div class="bg-white/90 backdrop-blur-md p-10 rounded-3xl shadow-sm border border-gray-100 text-center animate-fade-in-up relative overflow-hidden">
                <!-- Decorative background elements -->
                <div class="absolute -top-10 -right-10 w-40 h-40 bg-gradient-to-br from-indigo-100/50 to-purple-100/50 rounded-full blur-2xl"></div>
                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-gradient-to-tr from-pink-100/50 to-rose-100/50 rounded-full blur-2xl"></div>

                <div class="relative z-10">
                    <% if (attempt.passed) { %>
                        <div class="w-24 h-24 bg-gradient-to-br from-emerald-100 to-green-100 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-inner border border-emerald-50">
                            <i class="fa-solid fa-trophy text-5xl drop-shadow-sm"></i>
                        </div>
                        <h2 class="text-4xl font-black text-gray-800 mb-3 bg-clip-text text-transparent bg-gradient-to-r from-emerald-600 to-teal-600">Congratulations!</h2>
                        <p class="text-gray-500 mb-8 font-medium text-lg">You passed the quiz successfully.</p>
                    <% } else { %>
                        <div class="w-24 h-24 bg-gradient-to-br from-red-100 to-rose-100 text-red-600 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-inner border border-red-50">
                            <i class="fa-solid fa-circle-xmark text-5xl drop-shadow-sm"></i>
                        </div>
                        <h2 class="text-4xl font-black text-gray-800 mb-3">Keep Trying!</h2>
                        <p class="text-gray-500 mb-8 font-medium text-lg">You didn't reach the passing score this time.</p>
                    <% } %>
                    
                    <div class="flex justify-center items-center gap-10 text-sm bg-gray-50 rounded-2xl py-6 px-10 max-w-md mx-auto border border-gray-100 shadow-inner">
                        <div>
                            <p class="text-gray-400 mb-1 font-semibold uppercase tracking-wider text-xs">Your Score</p>
                            <p class="text-4xl font-black <%= attempt.passed ? 'text-emerald-500' : 'text-rose-500' %>"><%= attempt.score %>%</p>
                        </div>
                        <div class="h-16 w-px bg-gray-200"></div>
                        <div>
                            <p class="text-gray-400 mb-1 font-semibold uppercase tracking-wider text-xs">Passing Score</p>
                            <p class="text-3xl font-bold text-gray-800 pt-1"><%= attempt.quiz.passingScore %>%</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detailed Answers -->
            <div class="space-y-6 animate-fade-in-up delay-100">
                <h3 class="text-2xl font-extrabold text-gray-800 flex items-center gap-3">
                    <i class="fa-solid fa-list-check text-indigo-500"></i> Review Answers
                </h3>
                <% questions.forEach((q, index) => { %>
                    <% 
                        const ansRecord = attempt.answers.find(a => a.question.toString() === q._id.toString()); 
                        const selectedIdx = ansRecord ? ansRecord.selectedOptionIndex : null;
                        const isCorrect = ansRecord ? ansRecord.isCorrect : false;
                    %>
                    <div class="bg-white/90 backdrop-blur-md p-8 rounded-3xl shadow-sm border <%= isCorrect ? 'border-emerald-100 bg-emerald-50/10' : 'border-rose-100 bg-rose-50/10' %> transition-colors">
                        <div class="flex gap-4 mb-6">
                            <div class="flex-shrink-0 w-10 h-10 rounded-xl <%= isCorrect ? 'bg-emerald-100 text-emerald-600' : 'bg-rose-100 text-rose-600' %> flex items-center justify-center font-bold text-lg shadow-inner">
                                <i class="<%= isCorrect ? 'fa-solid fa-check' : 'fa-solid fa-xmark' %>"></i>
                            </div>
                            <h4 class="text-xl font-bold text-gray-800 pt-1.5"><%= index + 1 %>. <%= q.questionText %></h4>
                        </div>
                        
                        <div class="space-y-3 pl-14">
                            <% q.options.forEach((opt, oIndex) => { %>
                                <% 
                                    let bgClass = 'bg-white border-gray-100 hover:border-gray-200';
                                    let textClass = 'text-gray-600';
                                    let icon = '';
                                    if (opt.isCorrect) {
                                        bgClass = 'bg-emerald-50 border-emerald-200 shadow-sm';
                                        textClass = 'text-emerald-800 font-bold';
                                        icon = '<div class="ml-auto w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shadow-inner"><i class="fa-solid fa-check text-xs"></i></div>';
                                    } else if (selectedIdx === oIndex && !opt.isCorrect) {
                                        bgClass = 'bg-rose-50 border-rose-200 shadow-sm';
                                        textClass = 'text-rose-800 font-bold';
                                        icon = '<div class="ml-auto w-6 h-6 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shadow-inner"><i class="fa-solid fa-xmark text-xs"></i></div>';
                                    }
                                %>
                                <div class="flex items-center p-4 border-2 rounded-2xl <%= bgClass %> <%= textClass %> transition-colors">
                                    <span class="mr-4 w-6 text-center text-sm font-bold opacity-50 bg-gray-100 rounded-md py-0.5"><%= String.fromCharCode(65 + oIndex) %></span>
                                    <span class="text-[15px]"><%= opt.text %></span>
                                    <%- icon %>
                                </div>
                            <% }) %>
                        </div>
                        
                        <% if (q.explanation) { %>
                            <div class="mt-6 pl-14">
                                <div class="bg-gradient-to-r from-indigo-50 to-blue-50 border border-indigo-100/50 text-indigo-800 p-5 rounded-2xl text-[15px] flex gap-3 shadow-inner">
                                    <i class="fa-solid fa-lightbulb text-amber-500 mt-1 flex-shrink-0 text-lg"></i>
                                    <div>
                                        <span class="font-extrabold block mb-1">Explanation</span> 
                                        <p class="leading-relaxed opacity-90"><%= q.explanation %></p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
            
            <div class="flex justify-center pb-8 pt-8 animate-fade-in-up delay-200">
                <a href="/student/quizzes/<%= attempt.quiz._id %>" class="bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-bold py-4 px-10 rounded-2xl shadow-lg shadow-indigo-200 hover:-translate-y-1 transition-all text-lg flex items-center gap-3">
                    <i class="fa-solid fa-rotate-right"></i>
                    Retry Quiz
                </a>
            </div>
        </div>
    </main>
    <%- include('../partials/student-header-scripts') %>
</body>
</html>
