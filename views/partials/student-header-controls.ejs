<!-- Notification Icon & Dropdown -->
<div class="relative" id="notificationDropdownContainer">
    <button id="notificationBtn"
        class="relative text-slate-500 hover:text-indigo-600 transition-colors focus:outline-none">
        <i class="fa-regular fa-bell text-xl"></i>
        <span id="unreadBadge"
            class="hidden absolute -top-2 -right-2 text-[9px] font-bold text-white bg-red-500 rounded-full px-1.5 py-0.5 border-2 border-white">0</span>
    </button>

    <!-- Dropdown Panel -->
    <div id="notificationPanel"
        class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white rounded-xl shadow-lg border border-slate-200 z-50 overflow-hidden transform origin-top-right transition-all">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
            <h3 class="font-bold text-slate-800">Notifications</h3>
            <button id="markAllReadBtn"
                class="text-xs font-semibold text-indigo-600 hover:text-indigo-700 hidden">Mark
                all as read</button>
        </div>
        <div id="notificationList" class="max-h-96 overflow-y-auto divide-y divide-slate-100">
            <div class="p-4 text-center text-sm text-slate-500">Loading notifications...</div>
        </div>
    </div>
</div>

<!-- Student Profile Dropdown -->
<div class="relative" id="profileDropdownContainer">
    <button id="profileDropdownBtn" class="flex items-center gap-3 cursor-pointer group focus:outline-none" aria-label="Open profile menu" aria-expanded="false" aria-haspopup="true">
        <% 
            let profileInitials = '';
            if (!user.profilePicture || user.profilePicture === '/images/default-avatar.png') {
                let names = user.name ? user.name.split(' ') : ['S', ''];
                profileInitials = names[0].charAt(0).toUpperCase() + (names.length > 1 ? names[names.length - 1].charAt(0).toUpperCase() : '');
            }
        %>
        <% if (profileInitials) { %>
            <div class="w-9 h-9 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold border-2 border-indigo-100 group-hover:border-indigo-300 transition-colors">
                <%= profileInitials %>
            </div>
        <% } else { %>
            <img src="<%= user.profilePicture %>" alt="Profile"
                class="w-9 h-9 rounded-full object-cover border-2 border-indigo-100 group-hover:border-indigo-300 transition-colors">
        <% } %>
        <div class="hidden md:block text-left">
            <p class="text-sm font-semibold text-slate-800 leading-tight"><%= user.name || 'Student' %></p>
            <p class="text-xs text-slate-500 capitalize leading-tight mt-0.5"><%= user.role %></p>
        </div>
        <i class="fa-solid fa-chevron-down text-slate-400 text-xs ml-1 group-hover:text-slate-600 transition-colors hidden md:block"></i>
    </button>

    <!-- Profile Dropdown Panel -->
    <div id="profileDropdownPanel" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-slate-200 z-50 overflow-hidden transform origin-top-right transition-all">
        <div class="p-4 border-b border-slate-100 bg-slate-50 flex items-center gap-3">
            <% if (profileInitials) { %>
                <div class="w-12 h-12 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-lg border-2 border-indigo-100 shadow-sm shrink-0">
                    <%= profileInitials %>
                </div>
            <% } else { %>
                <img src="<%= user.profilePicture %>" alt="Profile"
                    class="w-12 h-12 rounded-full object-cover border-2 border-indigo-100 shadow-sm shrink-0">
            <% } %>
            <div class="overflow-hidden">
                <p class="font-bold text-slate-800 truncate"><%= user.name || 'Student' %></p>
                <p class="text-xs text-slate-500 truncate"><%= user.email %></p>
                <p class="text-xs font-semibold text-indigo-600 capitalize mt-0.5"><%= user.role %></p>
            </div>
        </div>
        <div class="p-2 py-2">
            <a href="/student/settings" class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 transition-colors">
                <i class="fa-solid fa-gear w-5 text-center text-slate-400"></i> Settings
            </a>
        </div>
        <div class="p-2 border-t border-slate-100">
            <form action="/logout" method="POST" class="w-full m-0">
                <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 transition-colors text-left">
                    <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center"></i> Logout
                </button>
            </form>
        </div>
    </div>
</div>
