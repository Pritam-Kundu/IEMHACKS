    <!-- Right Side (Auth) -->
    <div class="flex items-center gap-2">
        <% if (locals.user) { %>
            <a href="/<%= user.role %>/dashboard" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors hidden sm:block mr-2"><%= t('nav.dashboard') %></a>
            <a href="/logout" class="bg-indigo-600 text-white hover:bg-indigo-700 px-4 py-2 rounded-md text-sm font-medium transition-colors shadow-sm"><%= t('nav.logout') %></a>
        <% } else { %>
            <a href="/login" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors hidden sm:block mr-2"><%= t('nav.login') %></a>
            <a href="/signup" class="bg-indigo-600 text-white hover:bg-indigo-700 px-4 py-2 rounded-md text-sm font-medium transition-colors shadow-sm"><%= t('nav.getStarted') %></a>
        <% } %>

        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-full transition-colors">
            <i data-lucide="menu" class="size-5"></i>
        </button>
