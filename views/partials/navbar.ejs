                    </li>
                </ul>
                <ul class="space-y-1 flex flex-col justify-center">
                    <li><a href="#" class="group flex items-center gap-3 px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"><i data-lucide="bar-chart" class="size-4"></i> <%= t('nav.analytics') %></a></li>
                    <li><a href="#" class="group flex items-center gap-3 px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"><i data-lucide="plug" class="size-4"></i> <%= t('nav.integrations') %></a></li>
                    <li><a href="#" class="group flex items-center gap-3 px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"><i data-lucide="dollar-sign" class="size-4"></i> <%= t('nav.eCommerce') %></a></li>
                    <li><a href="#" class="group flex items-center gap-3 px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"><i data-lucide="shield" class="size-4"></i> <%= t('nav.security') %></a></li>
                    <li><a href="#" class="group flex items-center gap-3 px-3 py-2 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"><i data-lucide="code" class="size-4"></i> <%= t('nav.api') %></a></li>
