</nav>

<!-- Mobile Sheet Menu -->
<div id="mobile-sheet-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300"></div>
<div id="mobile-sheet" class="fixed top-0 right-0 h-full w-[85%] max-w-sm bg-white shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <div class="flex items-center justify-end p-4 border-b border-slate-100">
        <button id="close-mobile-sheet" class="p-2 text-slate-500 hover:bg-slate-100 rounded-full transition-colors">
            <i data-lucide="x" class="size-5"></i>
        </button>
    </div>
    
    <div class="flex-1 overflow-y-auto p-4 space-y-4">
        <!-- Mobile Accordion -->
        <div class="border-b border-slate-100 pb-2">
            <button class="flex items-center justify-between w-full py-3 text-left font-medium text-slate-900 group" onclick="toggleAccordion('mobile-product-content', this)">
                <%= t('nav.product') %>
                <i data-lucide="chevron-down" class="size-4 text-slate-400 transition-transform duration-200"></i>
            </button>
            <div id="mobile-product-content" class="hidden pl-2 space-y-1 mt-1">
                <a href="#" class="flex items-center gap-3 p-2 rounded-md hover:bg-slate-50 text-sm">
                    <div class="bg-slate-100 p-2 rounded-md"><i data-lucide="globe" class="size-4 text-indigo-600"></i></div>
                    <div>
                        <span class="block font-medium text-slate-900"><%= t('nav.websiteBuilder') %></span>
                        <span class="block text-xs text-slate-500"><%= t('nav.websiteBuilderDesc') %></span>
                    </div>
                </a>
                <a href="#" class="flex items-center gap-3 p-2 rounded-md hover:bg-slate-50 text-sm">
                    <div class="bg-slate-100 p-2 rounded-md"><i data-lucide="layers" class="size-4 text-indigo-600"></i></div>
                    <div>
                        <span class="block font-medium text-slate-900"><%= t('nav.cloudPlatform') %></span>
                        <span class="block text-xs text-slate-500"><%= t('nav.cloudPlatformDesc') %></span>
                    </div>
                </a>
                <a href="#" class="flex items-center gap-3 p-2 rounded-md hover:bg-slate-50 text-sm">
                    <div class="bg-slate-100 p-2 rounded-md"><i data-lucide="user-plus" class="size-4 text-indigo-600"></i></div>
                    <div>
                        <span class="block font-medium text-slate-900"><%= t('nav.teamCollaboration') %></span>
                        <span class="block text-xs text-slate-500"><%= t('nav.teamCollaborationDesc') %></span>
                    </div>
                </a>
            </div>
        </div>
        
        <div class="border-b border-slate-100 pb-2">
            <button class="flex items-center justify-between w-full py-3 text-left font-medium text-slate-900 group" onclick="toggleAccordion('mobile-company-content', this)">
                <%= t('nav.company') %>
                <i data-lucide="chevron-down" class="size-4 text-slate-400 transition-transform duration-200"></i>
            </button>
            <div id="mobile-company-content" class="hidden pl-2 space-y-1 mt-1">
                <a href="#" class="flex items-center gap-3 p-2 rounded-md hover:bg-slate-50 text-sm">
                    <div class="bg-slate-100 p-2 rounded-md"><i data-lucide="users" class="size-4 text-indigo-600"></i></div>
                    <div>
                        <span class="block font-medium text-slate-900"><%= t('nav.aboutUs') %></span>
                        <span class="block text-xs text-slate-500"><%= t('nav.aboutUsDesc') %></span>
                    </div>
                </a>
                <a href="#" class="flex items-center gap-3 p-2 rounded-md hover:bg-slate-50 text-sm">
                    <div class="bg-slate-100 p-2 rounded-md"><i data-lucide="star" class="size-4 text-indigo-600"></i></div>
                    <div>
                        <span class="block font-medium text-slate-900"><%= t('nav.customerStories') %></span>
                        <span class="block text-xs text-slate-500"><%= t('nav.customerStoriesDesc') %></span>
                    </div>
                </a>
            </div>
        </div>

        <a href="#pricing" class="block py-3 font-medium text-slate-900"><%= t('nav.pricing') %></a>
        
        <div class="pt-6 mt-6 border-t border-slate-100 flex flex-col gap-3">
            <% if (locals.user) { %>
                <a href="/<%= user.role %>/dashboard" class="w-full text-center bg-slate-100 text-slate-900 hover:bg-slate-200 block px-4 py-2 rounded-md font-medium"><%= t('nav.dashboard') %></a>
                <a href="/logout" class="w-full text-center bg-indigo-600 text-white hover:bg-indigo-700 block px-4 py-2 rounded-md font-medium shadow-sm"><%= t('nav.logout') %></a>
            <% } else { %>
                <a href="/login" class="w-full text-center border border-slate-200 text-slate-700 hover:bg-slate-50 block px-4 py-2 rounded-md font-medium"><%= t('nav.login') %></a>
                <a href="/signup" class="w-full text-center bg-indigo-600 text-white hover:bg-indigo-700 block px-4 py-2 rounded-md font-medium shadow-sm"><%= t('nav.getStarted') %></a>
            <% } %>
        </div>
    </div>
</div>

<script>
    // Initialize Lucide Icons
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }

        // Mega Menu Logic
        const navItems = document.querySelectorAll('.nav-item');
        const megaMenuContainer = document.getElementById('mega-menu-container');
        const allMenus = document.querySelectorAll('#mega-menu-container > div');
        let hideTimeout;

        function showMenu(menuId, button) {
            clearTimeout(hideTimeout);
            
            // Hide all submenus
            allMenus.forEach(m => m.classList.add('hidden'));
            
            // Show targeted submenu
            const targetMenu = document.getElementById(menuId);
            if (targetMenu) {
                targetMenu.classList.remove('hidden');
                
                // Animate container in
                megaMenuContainer.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
                megaMenuContainer.classList.add('opacity-100', 'scale-100');

                // Rotate chevron
                navItems.forEach(item => {
                    const icon = item.querySelector('[data-lucide="chevron-down"]');
                    if (item.contains(button)) {
                        icon.style.transform = 'rotate(180deg)';
                    } else {
                        icon.style.transform = 'rotate(0deg)';
                    }
                });
            }
        }

        function hideMenu() {
            hideTimeout = setTimeout(() => {
                megaMenuContainer.classList.remove('opacity-100', 'scale-100');
                megaMenuContainer.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
                
                // Reset chevrons
                navItems.forEach(item => {
                    const icon = item.querySelector('[data-lucide="chevron-down"]');
                    icon.style.transform = 'rotate(0deg)';
                });
            }, 150); // Small delay to allow moving mouse to the dropdown
        }

        navItems.forEach(item => {
            const menuId = item.getAttribute('data-dropdown');
            item.addEventListener('mouseenter', (e) => showMenu(menuId, e.currentTarget));
            item.addEventListener('mouseleave', hideMenu);
        });

        if (megaMenuContainer) {
            megaMenuContainer.addEventListener('mouseenter', () => {
                clearTimeout(hideTimeout);
            });
            
            megaMenuContainer.addEventListener('mouseleave', hideMenu);
        }

        // Mobile Sheet Logic
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const closeBtn = document.getElementById('close-mobile-sheet');
        const sheet = document.getElementById('mobile-sheet');
        const overlay = document.getElementById('mobile-sheet-overlay');

        function openSheet() {
            overlay.classList.remove('hidden');
            // Small timeout to allow display:block to apply before animating opacity
            setTimeout(() => overlay.classList.add('opacity-100'), 10);
            sheet.classList.remove('translate-x-full');
            document.body.style.overflow = 'hidden'; // Prevent scrolling
        }

        function closeSheet() {
            overlay.classList.remove('opacity-100');
            sheet.classList.add('translate-x-full');
            document.body.style.overflow = '';
            setTimeout(() => overlay.classList.add('hidden'), 300);
        }

        if(mobileBtn) mobileBtn.addEventListener('click', openSheet);
        if(closeBtn) closeBtn.addEventListener('click', closeSheet);
        if(overlay) overlay.addEventListener('click', closeSheet);
    });

    // Mobile Accordion Toggle
    window.toggleAccordion = function(contentId, button) {
        const content = document.getElementById(contentId);
        const icon = button.querySelector('i');
        
        if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            icon.style.transform = 'rotate(180deg)';
        } else {
            content.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
        }
    }
</script>
