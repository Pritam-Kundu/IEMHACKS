                            <div class="relative z-10">
                                <span class="text-sm font-semibold text-slate-900 block"><%= t('nav.teamCollaboration') %></span>
                                <span class="text-xs text-slate-500 mt-1 block"><%= t('nav.teamCollaborationDesc') %></span>
                            </div>
