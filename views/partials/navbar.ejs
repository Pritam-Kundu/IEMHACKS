                            <i data-lucide="users" class="size-5 text-indigo-600 mb-3 relative z-10"></i>
                            <div class="relative z-10">
                                <span class="text-sm font-semibold text-slate-900 block"><%= t('nav.aboutUs') %></span>
                                <span class="text-xs text-slate-500 mt-1 block"><%= t('nav.aboutUsDesc') %></span>
                            </div>
                        </a>
                    </li>
                    <!-- Customer Stories -->
                    <li>
                        <a href="#" class="group relative flex flex-col justify-between h-36 p-4 rounded-lg border border-slate-200 hover:border-indigo-200 hover:bg-indigo-50/50 transition-colors overflow-hidden">
                            <i data-lucide="star" class="size-5 text-indigo-600 mb-3 relative z-10"></i>
                            <div class="relative z-10">
                                <span class="text-sm font-semibold text-slate-900 block"><%= t('nav.customerStories') %></span>
                                <span class="text-xs text-slate-500 mt-1 block"><%= t('nav.customerStoriesDesc') %></span>
                            </div>
                        </a>
                    </li>
                    <div class="col-span-2 grid grid-cols-3 gap-2">
                        <a href="#" class="flex flex-col justify-center border border-slate-200 rounded-md p-3 hover:bg-slate-50 transition-colors"><span class="text-sm font-medium text-slate-900 text-center"><%= t('nav.terms') %></span></a>
                        <a href="#" class="flex flex-col justify-center border border-slate-200 rounded-md p-3 hover:bg-slate-50 transition-colors"><span class="text-sm font-medium text-slate-900 text-center"><%= t('nav.privacy') %></span></a>
                        <a href="#" class="flex flex-col justify-center border border-slate-200 rounded-md p-3 hover:bg-slate-50 transition-colors"><span class="text-sm font-medium text-slate-900 text-center"><%= t('nav.refund') %></span></a>
                    </div>
                </ul>
                <ul class="space-y-2 flex flex-col justify-center">
                    <li><a href="#" class="flex items-center justify-between p-3 border border-slate-100 rounded-md hover:bg-slate-50 transition-colors"><div><span class="text-sm font-medium block text-slate-900"><%= t('nav.partnerships') %></span><span class="text-xs text-slate-500 block"><%= t('nav.partnershipsDesc') %></span></div><i data-lucide="handshake" class="size-4 text-slate-400"></i></a></li>
                    <li><a href="#" class="flex items-center justify-between p-3 border border-slate-100 rounded-md hover:bg-slate-50 transition-colors"><div><span class="text-sm font-medium block text-slate-900"><%= t('nav.blog') %></span><span class="text-xs text-slate-500 block"><%= t('nav.blogDesc') %></span></div><i data-lucide="leaf" class="size-4 text-slate-400"></i></a></li>
                    <li><a href="#" class="flex items-center justify-between p-3 border border-slate-100 rounded-md hover:bg-slate-50 transition-colors"><div><span class="text-sm font-medium block text-slate-900"><%= t('nav.helpCenter') %></span><span class="text-xs text-slate-500 block"><%= t('nav.helpCenterDesc') %></span></div><i data-lucide="help-circle" class="size-4 text-slate-400"></i></a></li>
                </ul>
            </div>
        </div>
