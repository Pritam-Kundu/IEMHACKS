<!-- Load Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>

<nav class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[95%] max-w-5xl h-14 bg-white/40 backdrop-blur-xl border border-white/50 rounded-xl shadow-lg px-4 flex items-center justify-between">
