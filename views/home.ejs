            <!-- ============================== -->
            <!-- GSAP ANIMATIONS & LENIS        -->
            <!-- ============================== -->
            <script>
                // Initialize Lenis Smooth Scrolling
                const lenis = new Lenis({
                    duration: 1.2,
                    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                    smooth: true,
                    wheelMultiplier: 1.2
                });

                // Sync Lenis with GSAP ScrollTrigger
                lenis.on('scroll', ScrollTrigger.update);

                gsap.ticker.add((time) => {
                    lenis.raf(time * 1000);
                });

                gsap.ticker.lagSmoothing(0);

                gsap.registerPlugin(ScrollTrigger);

                // -- Hero entrance animations (immediate, no scroll trigger) --
                const heroTl = gsap.timeline({ defaults: { ease: "power3.out" } });
                heroTl
                    .fromTo("#heroTitle", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.8 }, 0.3)
                    .fromTo("#heroDesc", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7 }, 0.5)
                    .fromTo("#heroCTA", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7 }, 0.65)
                    .fromTo("#heroTrust", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.6 }, 0.85);

                // Floating cards staggered entrance
                heroTl
                    .fromTo("#floatCard1", { opacity: 0, y: 40, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.7 }, 0.5)
                    .fromTo("#floatCard2", { opacity: 0, y: 40, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.7 }, 0.65)
                    .fromTo("#floatCard3", { opacity: 0, y: 40, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.7 }, 0.8)
                    .fromTo("#floatCard4", { opacity: 0, y: 40, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.7 }, 0.95);

                // Animate the progress bar fill inside card 1
                heroTl.to("#progressFill", { width: "87%", duration: 1.2, ease: "power2.inOut" }, 1.2);

                // Subtle floating hover on the cards (perpetual)
                gsap.to("#floatCard1", { y: -6, duration: 3, repeat: -1, yoyo: true, ease: "sine.inOut", delay: 1.5, force3D: true });
                gsap.to("#floatCard2", { y: 8, duration: 3.5, repeat: -1, yoyo: true, ease: "sine.inOut", delay: 2, force3D: true });
                gsap.to("#floatCard3", { y: -7, duration: 2.8, repeat: -1, yoyo: true, ease: "sine.inOut", delay: 1.8, force3D: true });
                gsap.to("#floatCard4", { y: 5, duration: 3.2, repeat: -1, yoyo: true, ease: "sine.inOut", delay: 2.2, force3D: true });

                // -- Section Headers (scroll-triggered) --
                gsap.utils.toArray(".gsap-section-header").forEach(el => {
                    gsap.fromTo(el,
                        { opacity: 0, y: 40 },
                        {
                            opacity: 1, y: 0, duration: 0.8, ease: "power2.out",
                            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none none" }
                        }
                    );
                });

                // -- Feature Cards stagger --
                gsap.fromTo("#featuresGrid .feature-card",
                    { opacity: 0, y: 50 },
                    {
                        opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: "power2.out",
                        scrollTrigger: { trigger: "#featuresGrid", start: "top 80%" }
                    }
                );

                // -- Left/Right fade animations --
                gsap.utils.toArray(".gsap-fade-left").forEach(el => {
                    gsap.fromTo(el,
                        { opacity: 0, x: -60 },
                        {
                            opacity: 1, x: 0, duration: 0.9, ease: "power3.out",
                            scrollTrigger: { trigger: el, start: "top 80%" }
                        }
                    );
                });
                gsap.utils.toArray(".gsap-fade-right").forEach(el => {
                    gsap.fromTo(el,
                        { opacity: 0, x: 60 },
                        {
                            opacity: 1, x: 0, duration: 0.9, ease: "power3.out",
                            scrollTrigger: { trigger: el, start: "top 80%" }
                        }
                    );
                });

                // -- Highlights Cards stagger --
                gsap.fromTo("#highlightsGrid .highlight-card",
                    { opacity: 0, y: 60 },
                    {
                        opacity: 1, y: 0, duration: 0.7, stagger: 0.15, ease: "back.out(1.4)",
                        scrollTrigger: { trigger: "#highlightsGrid", start: "top 80%" }
                    }
                );

                // -- Steps stagger --
                gsap.fromTo("#stepsGrid .step-item",
                    { opacity: 0, y: 50, scale: 0.9 },
                    {
                        opacity: 1, y: 0, scale: 1, duration: 0.6, stagger: 0.15, ease: "power2.out",
                        scrollTrigger: { trigger: "#stepsGrid", start: "top 80%" }
                    }
                );

                // -- Roles stagger --
                gsap.fromTo("#rolesGrid .role-card",
                    { opacity: 0, y: 50 },
                    {
                        opacity: 1, y: 0, duration: 0.7, stagger: 0.15, ease: "power2.out",
                        scrollTrigger: { trigger: "#rolesGrid", start: "top 80%" }
                    }
                );

                // -- CTA Section --
                ScrollTrigger.create({
                    trigger: "#ctaSection",
                    start: "top 85%",
                    onEnter: () => {
                        gsap.fromTo("#ctaSection .gsap-fade-left", { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.8, ease: "power3.out" });
                        gsap.fromTo("#ctaSection .gsap-fade-right", { opacity: 0, x: 40 }, { opacity: 1, x: 0, duration: 0.8, ease: "power3.out", delay: 0.15 });
                    }
                });
            </script>

            <!-- ============================== -->
            <!-- PARTICLE SYSTEM                -->
            <!-- ============================== -->
            <script>
                (function () {
                    const canvas = document.getElementById('particleCanvas');
                    const ctx = canvas.getContext('2d');
                    const hero = document.getElementById('heroSection');

                    let width, height, particles, animId, time = 0;
                    const PARTICLE_COUNT = 60;
                    const CONNECTION_DIST = 160;
                    const MOUSE_RADIUS = 250; // Increased radius for smoother, wider interaction

                    const rawMouse = { x: -9999, y: -9999 };
                    const smoothMouse = { x: -9999, y: -9999 };
                    let mouseActive = false;

                    hero.addEventListener('mousemove', (e) => {
                        const rect = hero.getBoundingClientRect();
                        rawMouse.x = e.clientX - rect.left;
                        rawMouse.y = e.clientY - rect.top;
                        mouseActive = true;
                    });
                    hero.addEventListener('mouseleave', () => {
                        mouseActive = false;
                    });

                    function resize() {
                        const rect = hero.getBoundingClientRect();
                        const dpr = window.devicePixelRatio || 1;
                        width = rect.width;
                        height = rect.height;
                        canvas.width = width * dpr;
                        canvas.height = height * dpr;
                        canvas.style.width = width + 'px';
                        canvas.style.height = height + 'px';
                        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                    }

                    function createParticles() {
                        particles = [];
                        for (let i = 0; i < PARTICLE_COUNT; i++) {
                            particles.push({
                                x: Math.random() * width,
                                y: Math.random() * height,
                                vx: 0,
                                vy: 0,
                                r: Math.random() * 1.5 + 0.8,
                                baseOpacity: Math.random() * 0.3 + 0.15,
                                phase: Math.random() * Math.PI * 2,
                                pulseSpeed: Math.random() * 0.02 + 0.008,
                                // Unique offset to individualize vector field interaction
                                noiseOffsetX: Math.random() * 100,
                                noiseOffsetY: Math.random() * 100
                            });
                        }
                    }

                    function animate() {
                        time++;
                        ctx.clearRect(0, 0, width, height);

                        // Lerp mouse for buttery smooth interaction
                        if (mouseActive) {
                            smoothMouse.x += (rawMouse.x - smoothMouse.x) * 0.1;
                            smoothMouse.y += (rawMouse.y - smoothMouse.y) * 0.1;
                        } else {
                            smoothMouse.x += (-9999 - smoothMouse.x) * 0.05;
                            smoothMouse.y += (-9999 - smoothMouse.y) * 0.05;
                        }

                        for (let i = 0; i < particles.length; i++) {
                            const p = particles[i];

                            // 1. Ambient Fluid Motion (Procedural Vector Field)
                            // Uses sine waves based on coordinates to simulate a gentle flowing breeze
                            const t = time * 0.002;
                            const fieldAngle = Math.sin(p.x * 0.002 + p.noiseOffsetX + t) + Math.cos(p.y * 0.002 + p.noiseOffsetY + t);

                            // Add gentle force in the direction of the field
                            p.vx += Math.cos(fieldAngle) * 0.035;
                            p.vy += Math.sin(fieldAngle) * 0.035;

                            // 2. Mouse Interaction (Repel + Swirl)
                            const dx = p.x - smoothMouse.x;
                            const dy = p.y - smoothMouse.y;
                            const distSq = dx * dx + dy * dy;
                            const dist = Math.sqrt(distSq);

                            if (dist < MOUSE_RADIUS && dist > 0) {
                                // Cubic falloff for very soft edge interaction
                                const t2 = 1 - dist / MOUSE_RADIUS;
                                const force = t2 * t2 * t2 * 0.6;

                                const nx = dx / dist;
                                const ny = dy / dist;

                                // Outward push
                                p.vx += nx * force;
                                p.vy += ny * force;

                                // Tangential swirl (creates a liquid mixing effect around cursor)
                                p.vx += ny * force * 0.6;
                                p.vy -= nx * force * 0.6;
                            }

                            // 3. Physics & Damping
                            p.vx *= 0.92; // Friction
                            p.vy *= 0.92;
                            p.x += p.vx;
                            p.y += p.vy;

                            // 4. Infinite wrapping (when moving offscreen, appear on other side)
                            if (p.x < -30) p.x = width + 30;
                            if (p.x > width + 30) p.x = -30;
                            if (p.y < -30) p.y = height + 30;
                            if (p.y > height + 30) p.y = -30;

                            // 5. Breathing Visuals
                            const pulseOpacity = p.baseOpacity + Math.sin(time * p.pulseSpeed + p.phase) * 0.12;
                            const clampedOpacity = Math.max(0.05, Math.min(0.6, pulseOpacity));
                            const pulseR = p.r + Math.sin(time * p.pulseSpeed * 1.5 + p.phase) * 0.3;

                            // Draw Particle
                            ctx.beginPath();
                            ctx.arc(p.x, p.y, Math.max(0.5, pulseR), 0, Math.PI * 2);
                            ctx.fillStyle = `rgba(99, 102, 241, ${clampedOpacity.toFixed(3)})`;
                            ctx.fill();

                            // 6. Draw Connections
                            for (let j = i + 1; j < particles.length; j++) {
                                const p2 = particles[j];
                                const cdx = p.x - p2.x;
                                const cdy = p.y - p2.y;
                                const cdistSq = cdx * cdx + cdy * cdy;

                                if (cdistSq < CONNECTION_DIST * CONNECTION_DIST) {
                                    const cdist = Math.sqrt(cdistSq);
                                    // Quadratic falloff for smoother fading lines
                                    const falloff = 1 - cdist / CONNECTION_DIST;
                                    const lineOpacity = falloff * falloff * 0.15;

                                    ctx.beginPath();
                                    ctx.moveTo(p.x, p.y);
                                    ctx.lineTo(p2.x, p2.y);
                                    ctx.strokeStyle = `rgba(99, 102, 241, ${lineOpacity.toFixed(3)})`;
                                    ctx.lineWidth = 0.5;
                                    ctx.stroke();
                                }
                            }
                        }

                        animId = requestAnimationFrame(animate);
                    }

                    function init() {
                        resize();
                        createParticles();
                        animate();
                    }

                    let resizeTimer;
                    window.addEventListener('resize', () => {
                        clearTimeout(resizeTimer);
                        resizeTimer = setTimeout(() => {
                            resize();
                        }, 150);
                    });

                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', init);
                    } else {
                        init();
                    }
                })();

                // Landing Page Chat Widget Logic
                document.addEventListener('DOMContentLoaded', () => {
                    const form = document.getElementById('homeAiForm');
                    const input = document.getElementById('homeAiInput');
                    const micBtn = document.getElementById('homeMicBtn');

                    // Initialize Voice Utilities
                    const userLang = 'en-US';
                    const stt = new EduSmartSpeechToText({
                        language: userLang,
                        onResult: (res) => {
                            let currentVal = input.value.replace(/\s*\[.*\]$/, '');
                            if (res.final) {
                                input.value = currentVal + (currentVal ? ' ' : '') + res.final;
                            } else if (res.interim) {
                                input.value = currentVal + (currentVal ? ' ' : '') + `[${res.interim}]`;
                            }
                        },
                        onStateChange: (state) => {
                            if (!micBtn) return;
                            const micIcon = micBtn.querySelector('i');
                            if (state === 'LISTENING' || state === 'PROCESSING') {
                                micBtn.classList.add('text-red-500');
                                micBtn.classList.remove('text-gray-400');
                                micIcon.className = 'fa-solid fa-microphone-lines animate-pulse';
                                micBtn.setAttribute('aria-label', 'Stop voice input');
                                micBtn.setAttribute('title', 'Stop voice input');
                            } else {
                                input.value = input.value.replace(/\s*\[.*\]$/, '');
                                micBtn.classList.remove('text-red-500');
                                micBtn.classList.add('text-gray-400');
                                micIcon.className = 'fa-solid fa-microphone';
                                micBtn.setAttribute('aria-label', 'Start voice input');
                                micBtn.setAttribute('title', 'Start voice input');
                            }
                        },
                        onError: (err) => {
                            console.error('Voice Input Error:', err);
                        }
                    });

                    const tts = new EduSmartTextToSpeech({
                        language: userLang
                    });

                    if (micBtn) {
                        micBtn.addEventListener('click', () => {
                            stt.toggle();
                        });
                    }

                    // Delegate TTS button clicks
                    const chatContainer = document.getElementById('homeChatContainer');
                    if (chatContainer) {
                        chatContainer.addEventListener('click', (e) => {
                            const pauseBtn = e.target.closest('.tts-pause-btn');
                            if (pauseBtn) {
                                const isPaused = pauseBtn.classList.contains('paused');
                                if (isPaused) {
                                    tts.resume();
                                } else {
                                    tts.pause();
                                }
                                return;
                            }
                            const btn = e.target.closest('.tts-btn');
                            if (btn) {
                                const textContainer = btn.closest('.relative').querySelector('.text-gray-600');
                                if (textContainer) {
                                    const isCurrentlyPlaying = btn.classList.contains('playing');
                                    const controlsContainer = btn.closest('.tts-controls');
                                    const currentPauseBtn = controlsContainer ? controlsContainer.querySelector('.tts-pause-btn') : null;
                                    
                                    // Reset all buttons
                                    document.querySelectorAll('.tts-btn').forEach(b => {
                                        b.classList.remove('playing', 'text-indigo-600');
                                        b.classList.add('text-gray-400');
                                        const i = b.querySelector('i');
                                        if(i) i.className = 'fa-solid fa-volume-up';
                                        b.setAttribute('aria-label', 'Listen to response');
                                        b.setAttribute('title', 'Listen to response');
                                    });
                                    document.querySelectorAll('.tts-pause-btn').forEach(pb => {
                                        pb.classList.add('hidden');
                                        pb.classList.remove('paused', 'text-indigo-600');
                                        pb.classList.add('text-gray-400');
                                        const pi = pb.querySelector('i');
                                        if (pi) pi.className = 'fa-solid fa-pause';
                                        pb.setAttribute('aria-label', 'Pause reading');
                                        pb.setAttribute('title', 'Pause reading');
                                    });

                                    if (isCurrentlyPlaying) {
                                        tts.stop();
                                    } else {
                                        btn.classList.add('playing', 'text-indigo-600');
                                        btn.classList.remove('text-gray-400');
                                        const i = btn.querySelector('i');
                                        if(i) i.className = 'fa-solid fa-circle-stop animate-pulse';
                                        btn.setAttribute('aria-label', 'Stop reading');
                                        btn.setAttribute('title', 'Stop reading');
                                        
                                        if (currentPauseBtn) {
                                            currentPauseBtn.classList.remove('hidden');
                                        }
                                        
                                        tts.onStateChange = (state) => {
                                            if (state === 'STOPPED' || state === 'ERROR') {
                                                btn.classList.remove('playing', 'text-indigo-600');
                                                btn.classList.add('text-gray-400');
                                                const bi = btn.querySelector('i');
                                                if(bi) bi.className = 'fa-solid fa-volume-up';
                                                btn.setAttribute('aria-label', 'Listen to response');
                                                btn.setAttribute('title', 'Listen to response');
                                                
                                                if (currentPauseBtn) {
                                                    currentPauseBtn.classList.add('hidden');
                                                    currentPauseBtn.classList.remove('paused', 'text-indigo-600');
                                                    currentPauseBtn.classList.add('text-gray-400');
                                                    const pi = currentPauseBtn.querySelector('i');
                                                    if (pi) pi.className = 'fa-solid fa-pause';
                                                }
                                            } else if (state === 'PAUSED') {
                                                if (currentPauseBtn) {
                                                    currentPauseBtn.classList.add('paused', 'text-indigo-600');
                                                    currentPauseBtn.classList.remove('text-gray-400');
                                                    const pi = currentPauseBtn.querySelector('i');
                                                    if (pi) pi.className = 'fa-solid fa-play';
                                                    currentPauseBtn.setAttribute('aria-label', 'Resume reading');
                                                    currentPauseBtn.setAttribute('title', 'Resume reading');
                                                }
                                                const bi = btn.querySelector('i');
                                                if (bi) bi.classList.remove('animate-pulse');
                                            } else if (state === 'PLAYING') {
                                                if (currentPauseBtn) {
                                                    currentPauseBtn.classList.remove('hidden');
                                                    currentPauseBtn.classList.remove('paused', 'text-indigo-600');
                                                    currentPauseBtn.classList.add('text-gray-400');
                                                    const pi = currentPauseBtn.querySelector('i');
                                                    if (pi) pi.className = 'fa-solid fa-pause';
                                                    currentPauseBtn.setAttribute('aria-label', 'Pause reading');
                                                    currentPauseBtn.setAttribute('title', 'Pause reading');
                                                }
                                                const bi = btn.querySelector('i');
                                                if (bi) bi.classList.add('animate-pulse');
                                            }
                                        };
                                        
                                        tts.speak(textContainer.innerText);
                                    }
                                }
                            }
                        });
                    }

                    if (!form || !input) return;

                    form.addEventListener('submit', (e) => {
                        e.preventDefault();
                        const message = input.value.trim();
                        if (!message) return;

                        // Redirect to the dashboard tutor with the query
                        const redirectUrl = encodeURIComponent(`/api/ai/redirect?initialQuery=${encodeURIComponent(message)}`);
                        window.location.href = `/login?redirect=${redirectUrl}`;
                    });
                });

                // Video Modal Logic
                document.addEventListener('DOMContentLoaded', () => {
                    const watchDemoBtn = document.getElementById('watchDemoBtn');
                    const videoModal = document.getElementById('videoModal');
                    const closeModalBtn = document.getElementById('closeModalBtn');
                    const demoVideo = document.getElementById('demoVideo');

                    if (!watchDemoBtn || !videoModal || !closeModalBtn || !demoVideo) return;

                    const closeModal = () => {
                        videoModal.classList.add('hidden');
                        videoModal.classList.remove('flex');
                        demoVideo.pause();
                        demoVideo.currentTime = 0;
                    };

                    const openModal = () => {
                        videoModal.classList.remove('hidden');
                        videoModal.classList.add('flex');
                        // Attempt to play automatically
                        const playPromise = demoVideo.play();
                        if (playPromise !== undefined) {
                            playPromise.catch(error => {
                                console.log("Autoplay prevented by browser:", error);
                                // Show controls if autoplay fails (default behavior since controls are enabled)
                            });
                        }
                    };

                    watchDemoBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        openModal();
                    });

                    closeModalBtn.addEventListener('click', closeModal);

                    // Close on outside click
                    videoModal.addEventListener('click', (e) => {
                        if (e.target === videoModal) {
                            closeModal();
                        }
                    });

                    // Close on Escape key
                    document.addEventListener('keydown', (e) => {
                        if (e.key === 'Escape' && !videoModal.classList.contains('hidden')) {
                            closeModal();
                        }
                    });

                    // Handle video errors
                    demoVideo.addEventListener('error', (e) => {
                        console.error('Error loading video:', e);
                        const errorMsg = document.getElementById('videoErrorMsg');
                        if (errorMsg) {
                            errorMsg.classList.remove('hidden');
                        }
                        demoVideo.classList.add('hidden');
                    });
                });
            </script>
            <!-- Video Modal -->
            <div id="videoModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-gray-900/90 backdrop-blur-sm transition-opacity duration-300">
                <div class="relative w-full max-w-5xl mx-4 rounded-2xl overflow-hidden bg-black shadow-2xl border border-gray-800">
                    <!-- Close button -->
                    <button id="closeModalBtn" aria-label="Close demo video" class="absolute top-4 right-4 z-[110] w-10 h-10 flex items-center justify-center rounded-full bg-black/60 text-white hover:bg-black hover:text-red-400 transition-colors focus:outline-none focus:ring-2 focus:ring-white/50 cursor-pointer">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                    
                    <!-- Video player -->
                    <div class="relative w-full aspect-video bg-black flex items-center justify-center">
                        <video id="demoVideo" class="w-full h-full object-contain" controls playsinline preload="metadata">
                            <source src="/uploads/Demo%20Video.mp4" type="video/mp4">
                            Your browser does not support the video tag.
                        </video>
                        <!-- Error Message -->
                        <div id="videoErrorMsg" class="absolute inset-0 flex items-center justify-center hidden bg-gray-900">
                            <div class="text-center text-white p-6">
                                <i class="fas fa-exclamation-circle text-4xl mb-3 text-red-500"></i>
                                <p class="text-lg font-medium">Demo video is currently unavailable.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <script src="/js/voice/speechToText.js"></script>
            <script src="/js/voice/textToSpeech.js"></script>
</body>