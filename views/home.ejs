<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduSmart - <%= t('home.heroTitle') %> <%= t('home.heroTitleSpan') %></title>
    <meta name="description"
        content="EduSmart is a personalized learning platform with adaptive quizzes, AI-powered assistance, and comprehensive analytics for students, teachers, and parents.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <!-- GSAP + ScrollTrigger -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <!-- Lenis Smooth Scrolling -->
    <script src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        #particleCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .hero-glow {
            background: radial-gradient(ellipse 600px 400px at 70% 40%, rgba(99, 102, 241, 0.10), transparent);
        }

        .float-card {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            will-change: transform;
            transform: translateZ(0);
        }
    </style>
</head>

<body class="bg-white text-gray-800 font-sans antialiased flex flex-col min-h-screen overflow-x-hidden">

    <%- include('partials/navbar') %>

        <main class="flex-grow">

            <!-- ============================== -->
            <!-- HERO SECTION                   -->
            <!-- ============================== -->
            <section id="heroSection"
                class="relative min-h-[92vh] flex items-center overflow-hidden bg-cover bg-center bg-no-repeat"
                style="background-image: url('/images/heroimage.jpg');">
                <!-- Image Overlay for readability -->
                <div
                    class="absolute inset-0 bg-white/80 md:bg-white/50 bg-gradient-to-r from-white/95 via-white/70 to-white/20 pointer-events-none z-0">
                </div>
                <!-- Particle Canvas -->
                <canvas id="particleCanvas" class="z-0"></canvas>
                <!-- Ambient glow -->
                <div class="hero-glow absolute inset-0 pointer-events-none"></div>
                <!-- Subtle corner accents -->
                <div
                    class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-indigo-100/40 blur-3xl pointer-events-none">
                </div>
                <div
                    class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-blue-100/30 blur-3xl pointer-events-none">
                </div>

                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20 lg:py-0">
                    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-20">

                        <!-- Left: Copy -->
                        <div class="lg:w-1/2 relative z-10">

                            <h1 id="heroTitle"
                                class="mt-8 lg:mt-12 text-5xl sm:text-6xl lg:text-7xl font-extrabold text-gray-900 leading-[1.08] tracking-tight mb-6 opacity-0">
                                Smart Learning
                                <span
                                    class="block text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-blue-600 to-indigo-500">for
                                    Every Student</span>
                            </h1>

                            <p id="heroDesc"
                                class="text-lg sm:text-xl text-gray-500 leading-relaxed max-w-lg mb-10 opacity-0">
                                Personalized lessons, adaptive assessments, and AI-powered tutoring — all in one
                                beautiful, accessible platform.
                            </p>

                            <div id="heroCTA" class="flex flex-col sm:flex-row gap-4 opacity-0">
                                <a href="/signup"
                                    class="group inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-200/50 transition-all duration-300 hover:-translate-y-0.5">
                                    <%= t('home.startLearningFree') %>
                                    <i
                                        class="fas fa-arrow-right ml-2 transition-transform duration-300 group-hover:translate-x-1"></i>
                                </a>
                                <button id="watchDemoBtn"
                                    class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-xl text-gray-700 bg-white border border-gray-200 hover:border-gray-300 hover:bg-gray-50 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                                    <i class="fas fa-play-circle mr-2 text-indigo-500"></i> <%= t('home.watchDemo') %>
                                </button>
                            </div>

                            <!-- Trust row -->
                            <div id="heroTrust" class="mt-12 flex items-center gap-6 text-sm text-gray-400 opacity-0">
                                <div class="flex items-center gap-1.5">
                                    <i class="fas fa-shield-alt text-green-500"></i>
                                    <span><%= t('home.securePrivate') %></span>
                                </div>
                                <div class="w-px h-4 bg-gray-200"></div>
                                <div class="flex items-center gap-1.5">
                                    <i class="fas fa-wifi text-blue-500"></i>
                                    <span><%= t('home.worksOffline') %></span>
                                </div>
                                <div class="w-px h-4 bg-gray-200"></div>
                                <div class="flex items-center gap-1.5">
                                    <i class="fas fa-globe text-purple-500"></i>
                                    <span><%= t('home.multiLanguage') %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Floating Metric Cards -->
                        <div class="lg:w-1/2 relative flex items-center justify-center min-h-[420px] w-full">

                            <!-- Central decorative rings -->
                            <div
                                class="absolute w-64 h-64 rounded-full border border-dashed border-indigo-100 opacity-60">
                            </div>
                            <div
                                class="absolute w-80 h-80 rounded-full border border-dashed border-gray-100 opacity-40">
                            </div>

                            <!-- Card 1: Progress -->
                            <div id="floatCard1"
                                class="float-card absolute top-4 left-4 sm:left-8 bg-white/80 border border-gray-100 rounded-2xl shadow-lg p-5 w-52 opacity-0">
                                <div class="flex items-center gap-3 mb-3">
                                    <div
                                        class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-sm">
                                        <i class="fas fa-chart-line"></i>
                                    </div>
                                    <span
                                        class="text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t('home.progress') %></span>
                                </div>
                                <div class="text-3xl font-extrabold text-gray-900">87<span
                                        class="text-lg text-indigo-500">%</span></div>
                                <div class="mt-2 w-full bg-gray-100 rounded-full h-1.5">
                                    <div id="progressFill" class="bg-indigo-500 h-1.5 rounded-full" style="width: 0%">
                                    </div>
                                </div>
                            </div>

                            <!-- Card 2: AI Tutor -->
                            <div id="floatCard2"
                                class="float-card absolute top-8 right-4 sm:right-6 bg-white/80 border border-gray-100 rounded-2xl shadow-lg p-5 w-56 opacity-0">
                                <div class="flex items-center gap-3 mb-3">
                                    <div
                                        class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-sm">
                                        <i class="fas fa-robot"></i>
                                    </div>
                                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">AI
                                        Tutor</span>
                                </div>
                                <div
                                    class="bg-gray-50 rounded-xl p-3 text-sm text-gray-600 leading-relaxed border border-gray-100">
                                    <%- t('home.aiTutorExample') %>
                                </div>
                            </div>

                            <!-- Card 3: Streak -->
                            <div id="floatCard3"
                                class="float-card absolute bottom-12 left-8 sm:left-16 bg-white/80 border border-gray-100 rounded-2xl shadow-lg p-5 w-48 opacity-0">
                                <div class="flex items-center gap-3 mb-2">
                                    <div
                                        class="w-9 h-9 rounded-lg bg-orange-50 text-orange-500 flex items-center justify-center text-sm">
                                        <i class="fas fa-fire"></i>
                                    </div>
                                    <span
                                        class="text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t('home.streak') %></span>
                                </div>
                                <div class="text-3xl font-extrabold text-gray-900">14 <span
                                        class="text-base font-medium text-gray-400"><%= t('home.days') %></span></div>
                            </div>

                            <!-- Card 4: Badge -->
                            <div id="floatCard4"
                                class="float-card absolute bottom-4 right-8 sm:right-12 bg-white/80 border border-gray-100 rounded-2xl shadow-lg p-4 opacity-0">
                                <div class="flex items-center gap-3">
                                    <div
                                        class="w-11 h-11 rounded-full bg-gradient-to-br from-yellow-400 to-orange-500 text-white flex items-center justify-center text-lg shadow-md">
                                        <i class="fas fa-trophy"></i>
                                    </div>
                                    <div>
                                        <div class="text-sm font-bold text-gray-900"><%= t('home.quizMaster') %></div>
                                        <div class="text-xs text-gray-400"><%= t('home.badgeUnlocked') %></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bottom fade line -->
                <div
                    class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gray-200 to-transparent">
                </div>
            </section>

            <!-- ============================== -->
            <!-- FEATURES GRID SECTION          -->
            <!-- ============================== -->
            <section id="features" class="py-24 bg-gray-50/80">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center max-w-3xl mx-auto mb-16 gsap-section-header">
                        <h2 class="text-sm text-indigo-600 font-semibold tracking-widest uppercase mb-3"><%= t('home.featuresHeader') %></h2>
                        <p class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight">
                            <%= t('home.featuresTitle') %>
                        </p>
                        <p class="mt-4 text-lg text-gray-500">
                            <%= t('home.featuresDesc') %>
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="featuresGrid">
                        <div
                            class="feature-card bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
                            <div
                                class="w-11 h-11 inline-flex items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 mb-4 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-brain text-lg"></i>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 mb-1.5"><%= t('home.adaptiveLearning') %></h3>
                            <p class="text-gray-500 text-sm leading-relaxed">Lessons and quizzes adjust dynamically to
                                your individual learning level.</p>
                        </div>
                        <div
                            class="feature-card bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
                            <div
                                class="w-11 h-11 inline-flex items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-4 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-robot text-lg"></i>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 mb-1.5"><%= t('home.aiTutor') %></h3>
                            <p class="text-gray-500 text-sm leading-relaxed">Get instant help, detailed explanations,
                                and 24/7 assistance whenever you need it.</p>
                        </div>
                        <div
                            class="feature-card bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
                            <div
                                class="w-11 h-11 inline-flex items-center justify-center rounded-xl bg-amber-50 text-amber-600 mb-4 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-trophy text-lg"></i>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 mb-1.5"><%= t('home.gamification') %></h3>
                            <p class="text-gray-500 text-sm leading-relaxed">Earn XP, unlock badges, and climb the
                                leaderboard while learning.</p>
                        </div>
                        <div
                            class="feature-card bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
                            <div
                                class="w-11 h-11 inline-flex items-center justify-center rounded-xl bg-green-50 text-green-600 mb-4 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-wifi text-lg"></i>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 mb-1.5"><%= t('home.offlineLearning') %></h3>
                            <p class="text-gray-500 text-sm leading-relaxed">Continue learning downloaded content even
                                when you're disconnected.</p>
                        </div>
                        <div
                            class="feature-card bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
                            <div
                                class="w-11 h-11 inline-flex items-center justify-center rounded-xl bg-purple-50 text-purple-600 mb-4 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-chart-line text-lg"></i>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 mb-1.5"><%= t('home.analyticsProgress') %></h3>
                            <p class="text-gray-500 text-sm leading-relaxed">Track your learning progress and
                                performance with visual insights.</p>
                        </div>
                        <div
                            class="feature-card bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
                            <div
                                class="w-11 h-11 inline-flex items-center justify-center rounded-xl bg-pink-50 text-pink-600 mb-4 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-language text-lg"></i>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 mb-1.5"><%= t('home.multiLanguage') %></h3>
                            <p class="text-gray-500 text-sm leading-relaxed">Learn comfortably with comprehensive
                                support for multiple languages.</p>
                        </div>
                        <div
                            class="feature-card bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
                            <div
                                class="w-11 h-11 inline-flex items-center justify-center rounded-xl bg-orange-50 text-orange-600 mb-4 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-volume-up text-lg"></i>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 mb-1.5"><%= t('home.textToSpeech') %></h3>
                            <p class="text-gray-500 text-sm leading-relaxed">Listen to lessons and improve accessibility
                                with native speech tools.</p>
                        </div>
                        <div
                            class="feature-card bg-white rounded-2xl p-6 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
                            <div
                                class="w-11 h-11 inline-flex items-center justify-center rounded-xl bg-slate-100 text-slate-700 mb-4 group-hover:scale-110 transition-transform duration-300">
                                <i class="fas fa-shield-alt text-lg"></i>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 mb-1.5"><%= t('home.secureScalable') %></h3>
                            <p class="text-gray-500 text-sm leading-relaxed">Built with robust authentication and a
                                scalable cloud architecture.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============================== -->
            <!-- ADAPTIVE LEARNING SECTION      -->
            <!-- ============================== -->
            <section class="py-24 relative bg-cover bg-center bg-fixed"
                style="background-image: url('/images/heroimage.jpg');">
                <!-- Overlay to keep the text readable while letting the image peek through -->
                <div class="absolute inset-0 bg-white/90"></div>

                <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex flex-col lg:flex-row items-center gap-16">
                        <div class="lg:w-1/2 gsap-fade-left">
                            <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-6 leading-tight">Learning
                                that Adapts to You</h2>
                            <p class="text-lg text-gray-500 mb-10 leading-relaxed">
                                Our intelligent algorithm constantly monitors your performance, adjusting the difficulty
                                of questions to keep you perfectly challenged—neither bored nor overwhelmed.
                            </p>

                            <!-- Visual Flow -->
                            <div
                                class="space-y-4 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-gray-200 before:to-transparent">
                                <div
                                    class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                                    <div
                                        class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-gray-100 text-gray-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
                                        <i class="fas fa-book-reader"></i>
                                    </div>
                                    <div
                                        class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-lg bg-white border border-gray-100 shadow-sm">
                                        <div class="font-bold text-gray-900"><%= t('home.step1Learn') %></div>
                                        <div class="text-sm text-gray-500"><%= t('home.step1Desc') %></div>
                                    </div>
                                </div>
                                <div
                                    class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                                    <div
                                        class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-indigo-50 text-indigo-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
                                        <i class="fas fa-tasks"></i>
                                    </div>
                                    <div
                                        class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-lg bg-white border border-gray-100 shadow-sm">
                                        <div class="font-bold text-gray-900"><%= t('home.step2Quiz') %></div>
                                        <div class="text-sm text-gray-500"><%= t('home.step2Desc') %></div>
                                    </div>
                                </div>
                                <div
                                    class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                                    <div
                                        class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-blue-50 text-blue-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
                                        <i class="fas fa-chart-pie"></i>
                                    </div>
                                    <div
                                        class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-lg bg-white border border-gray-100 shadow-sm">
                                        <div class="font-bold text-gray-900"><%= t('home.step3Analyze') %></div>
                                        <div class="text-sm text-gray-500"><%= t('home.step3Desc') %></div>
                                    </div>
                                </div>
                                <div
                                    class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                                    <div
                                        class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-green-50 text-green-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
                                        <i class="fas fa-sliders-h"></i>
                                    </div>
                                    <div
                                        class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-4 rounded-lg bg-white border border-gray-100 shadow-sm">
                                        <div class="font-bold text-gray-900"><%= t('home.step4Adjust') %></div>
                                        <div class="text-sm text-gray-500"><%= t('home.step4Desc') %></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div
                            class="lg:w-1/2 bg-gray-50 rounded-2xl p-8 border border-gray-100 flex items-center justify-center min-h-[400px] gsap-fade-right">
                            <div class="w-full max-w-sm space-y-4">
                                <div
                                    class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 flex items-center space-x-4 opacity-50">
                                    <div
                                        class="w-10 h-10 rounded bg-red-100 text-red-500 flex items-center justify-center">
                                        <i class="fas fa-times"></i>
                                    </div>
                                    <div>
                                        <div class="h-4 w-24 bg-gray-200 rounded"></div>
                                        <div class="h-3 w-16 bg-gray-100 rounded mt-2"></div>
                                    </div>
                                </div>
                                <div
                                    class="bg-white p-4 rounded-lg shadow-md border-l-4 border-indigo-500 flex items-center space-x-4 scale-105 transform transition-transform">
                                    <div
                                        class="w-10 h-10 rounded bg-indigo-100 text-indigo-600 flex items-center justify-center">
                                        <i class="fas fa-sync fa-spin"></i>
                                    </div>
                                    <div>
                                        <div class="font-bold text-sm text-gray-900"><%= t('home.adjustingDifficulty') %></div>
                                        <div class="text-xs text-gray-500 mt-1"><%= t('home.generatingContent') %></div>
                                    </div>
                                </div>
                                <div
                                    class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 flex items-center space-x-4 opacity-75">
                                    <div
                                        class="w-10 h-10 rounded bg-green-100 text-green-500 flex items-center justify-center">
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <div>
                                        <div class="h-4 w-32 bg-gray-200 rounded"></div>
                                        <div class="h-3 w-20 bg-gray-100 rounded mt-2"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============================== -->
            <!-- AI TUTOR SECTION               -->
            <!-- ============================== -->
            <section class="py-24 bg-indigo-950 text-white relative overflow-hidden">
                <div
                    class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 rounded-full bg-indigo-800 opacity-50 blur-3xl">
                </div>
                <div
                    class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-blue-800 opacity-30 blur-3xl">
                </div>

                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                    <div class="flex flex-col lg:flex-row items-center gap-16">
                        <div class="lg:w-1/2 gsap-fade-left">
                            <div
                                class="inline-flex items-center px-3 py-1 rounded-full bg-indigo-800/60 text-indigo-200 text-xs font-semibold mb-6 border border-indigo-700/50">
                                <span class="flex w-2 h-2 rounded-full bg-green-400 mr-2 animate-pulse"></span>
                                Always Online
                            </div>
                            <h2 class="text-3xl sm:text-4xl font-extrabold mb-6"><%= t('home.meetAiTutor') %></h2>
                            <p class="text-indigo-200 text-lg mb-8 leading-relaxed">
                                Stuck on a difficult concept? The EduSmart AI Tutor is here 24/7 to provide
                                context-aware hints, detailed explanations, and step-by-step guidance without just
                                giving away the answer.
                            </p>
